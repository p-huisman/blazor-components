@namespace Pggm.Components.Sample.Layout
@using Microsoft.AspNetCore.Components.Routing
@using Pggm.Components.Sample.Components.Nav
@using Pggm.Components.Models
@using Pggm.Components.Services
@inherits ComponentBase
@inject NavigationManager Navigation
@inject NavMenuService NavService
@implements IDisposable

<nav class="nav" aria-label="Main navigation">

    <div class="nav-close-bar">
        <button class="nav-close-button" @onclick="OnClose" aria-label="Close navigation menu">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
            </svg>
            <span class="screen-reader-only">Close menu</span>
        </button>
    </div>

    <NavSection Title="Blazor Components">
        @foreach (var category in NavService.Items)
        {
            <NavCategory Label="@category.Title" IsExpanded="@category.IsOpen" OnToggle="@(() => ToggleCategory(category))">
                <Icon>
                    @GetIcon(category.Title ?? string.Empty)
                </Icon>
                <ChildContent>
                    @foreach (var child in category.Children)
                    {
                        <NavItem Href="@child.Url" Label="@child.Title" />
                    }
                </ChildContent>
            </NavCategory>
        }
    </NavSection>

</nav>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private static readonly Dictionary<string, string[]> _categoryRoutes = new()
    {
        ["forms"] = ["pggm-button", "pggm-checkbox", "pggm-combobox", "pggm-file-upload", "pggm-input", "pggm-input-bsn",
"pggm-input-date", "pggm-input-iban", "pggm-input-phone", "pggm-radio", "pggm-select", "pggm-signature-pad",
"pggm-slider", "pggm-switch", "pggm-textarea"],
        ["display"] = ["pggm-accordion", "pggm-avatar", "pggm-heading", "pggm-icon", "pggm-label", "pggm-link",
"pggm-notification", "pggm-progress-indicator", "pggm-tooltip", "pggm-card"],
        ["layout"] = ["pggm-dialog", "pggm-drawer", "pggm-dropdown", "pggm-fieldset", "pggm-grid", "pggm-scroller",
"pggm-splitter",
"pggm-stack", "pggm-tabs", "pggm-wizard"],
        ["composite"] = ["pggm-address-input", "pggm-bank-account-input"],
        ["data"] = ["pggm-error-message", "pggm-table", "pggm-data-grid", "pggm-virtualized-data-grid",
    "pggm-datagrid-remote-data", "pggm-datagrid-hierarchical", "pggm-datagrid-resizable-columns",
    "pggm-datagrid-sticky-first-column", "pggm-table-formatters", "pggm-table-data-adapter", "pggm-validation-message",
    "pggm-validation-summary","pggm-datagrid-auto-items-per-page", "pggm-paginator",
    "pggm-data-grid-content-parameters-demo", "pggm-data-grid-api", "pggm-datagrid-filtering"]
    };

    private readonly HashSet<string> _expandedCategories = new();

    protected override void OnInitialized()
    {
        // Build menu via NavMenuService to mirror the static menu
        PopulateMenu();

        ExpandForCurrentRoute(Navigation.Uri);
        ApplyExpandedStateToService();

        Navigation.LocationChanged += OnLocationChanged;
    }

    private void PopulateMenu()
    {
        NavService.Clear();

        // Forms
        var forms = new NavMenuItem { Title = "Forms" };
        forms.Children.AddRange(new[] {
            new NavMenuItem{ Title="Button", Url="pggm-button" },
            new NavMenuItem{ Title="Checkbox", Url="pggm-checkbox" },
            new NavMenuItem{ Title="Combobox", Url="pggm-combobox" },
            new NavMenuItem{ Title="File Upload", Url="pggm-file-upload" },
            new NavMenuItem{ Title="Input", Url="pggm-input" },
            new NavMenuItem{ Title="Input BSN", Url="pggm-input-bsn" },
            new NavMenuItem{ Title="Input Date", Url="pggm-input-date" },
            new NavMenuItem{ Title="Input IBAN", Url="pggm-input-iban" },
            new NavMenuItem{ Title="Input Phone", Url="pggm-input-phone" },
            new NavMenuItem{ Title="Radio", Url="pggm-radio" },
            new NavMenuItem{ Title="Select", Url="pggm-select" },
            new NavMenuItem{ Title="Signature Pad", Url="pggm-signature-pad" },
            new NavMenuItem{ Title="Slider", Url="pggm-slider" },
            new NavMenuItem{ Title="Switch", Url="pggm-switch" },
            new NavMenuItem{ Title="Textarea", Url="pggm-textarea" }
        });
        NavService.Add(forms);

        // Display
        var display = new NavMenuItem { Title = "Display" };
        display.Children.AddRange(new[] {
            new NavMenuItem{ Title="Accordion", Url="pggm-accordion" },
            new NavMenuItem{ Title="Avatar", Url="pggm-avatar" },
            new NavMenuItem{ Title="Card", Url="pggm-card" },
            new NavMenuItem{ Title="Heading", Url="pggm-heading" },
            new NavMenuItem{ Title="Icon", Url="pggm-icon" },
            new NavMenuItem{ Title="Label", Url="pggm-label" },
            new NavMenuItem{ Title="Link", Url="pggm-link" },
            new NavMenuItem{ Title="Notification", Url="pggm-notification" },
            new NavMenuItem{ Title="Progress Indicator", Url="pggm-progress-indicator" },
            new NavMenuItem{ Title="Tooltip", Url="pggm-tooltip" }
        });
        NavService.Add(display);

        // Layout
        var layout = new NavMenuItem { Title = "Layout" };
        layout.Children.AddRange(new[] {
            new NavMenuItem{ Title="Dialog", Url="pggm-dialog" },
            new NavMenuItem{ Title="Drawer", Url="pggm-drawer" },
            new NavMenuItem{ Title="Dropdown", Url="pggm-dropdown" },
            new NavMenuItem{ Title="Fieldset", Url="pggm-fieldset" },
            new NavMenuItem{ Title="Grid", Url="pggm-grid" },
            new NavMenuItem{ Title="Scroller", Url="pggm-scroller" },
            new NavMenuItem{ Title="Splitter", Url="pggm-splitter" },
            new NavMenuItem{ Title="Stack", Url="pggm-stack" },
            new NavMenuItem{ Title="Tabs", Url="pggm-tabs" },
            new NavMenuItem{ Title="Wizard", Url="pggm-wizard" }
        });
        NavService.Add(layout);

        // Composite
        var composite = new NavMenuItem { Title = "Composite" };
        composite.Children.AddRange(new[] {
            new NavMenuItem{ Title="Address Input", Url="pggm-address-input" },
            new NavMenuItem{ Title="Bank Account Input", Url="pggm-bank-account-input" }
        });
        NavService.Add(composite);

        // Data & Validation
        var data = new NavMenuItem { Title = "Data & Validation" };
        data.Children.AddRange(new[] {
            new NavMenuItem{ Title="Error Message", Url="pggm-error-message" },
            new NavMenuItem{ Title="Table", Url="pggm-table" },
            new NavMenuItem{ Title="Table Formatters", Url="pggm-table-formatters" },
            new NavMenuItem{ Title="Table Data Adapter", Url="pggm-table-data-adapter" },
            new NavMenuItem{ Title="Validation Message", Url="pggm-validation-message" },
            new NavMenuItem{ Title="Validation Summary", Url="pggm-validation-summary" },
            new NavMenuItem{ Title="Data Grid", Url="#" },
            new NavMenuItem{ Title="DataGrid 🛠️", Url="pggm-data-grid" },
            new NavMenuItem{ Title="API Documentation 🛠️", Url="pggm-data-grid-api" },
            new NavMenuItem{ Title="Virtualized 🛠️", Url="pggm-virtualized-data-grid" },
            new NavMenuItem{ Title="Remote Data 🛠️", Url="pggm-datagrid-remote-data" },
            new NavMenuItem{ Title="Hierarchical 🛠️", Url="pggm-datagrid-hierarchical" },
            new NavMenuItem{ Title="Resizable Columns 🛠️", Url="pggm-datagrid-resizable-columns" },
            new NavMenuItem{ Title="Sticky First Column 🛠️", Url="pggm-datagrid-sticky-first-column" },
            new NavMenuItem{ Title="Auto Items Per Page 🛠️", Url="pggm-datagrid-auto-items-per-page" },
            new NavMenuItem{ Title="Filtering 🛠️", Url="pggm-datagrid-filtering" },
            new NavMenuItem{ Title="Paginator", Url="pggm-paginator" },
            new NavMenuItem{ Title="Content Parameters 🛠️", Url="pggm-data-grid-content-parameters-demo" }
        });
        NavService.Add(data);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        ExpandForCurrentRoute(e.Location);
        ApplyExpandedStateToService();
        InvokeAsync(StateHasChanged);
    }

    private void ExpandForCurrentRoute(string uri)
    {
        var path = new Uri(uri).AbsolutePath.TrimStart('/');
        foreach (var (category, routes) in _categoryRoutes)
        {
            if (routes.Any(r => path.Equals(r, StringComparison.OrdinalIgnoreCase)))
                _expandedCategories.Add(category);
        }
    }

    private void ApplyExpandedStateToService()
    {
        foreach (var cat in NavService.Items)
        {
            var key = CategoryKey(cat.Title ?? string.Empty);
            cat.IsOpen = _expandedCategories.Contains(key);
        }
        NavService.Notify();
    }

    private static string CategoryKey(string title) => (title ?? string.Empty).ToLowerInvariant().Split(' ')[0];

    private void ToggleCategory(NavMenuItem category)
    {
        NavService.Toggle(category);
        // Also reflect in expanded set for route-based behavior
        var key = CategoryKey(category.Title ?? string.Empty);
        if (category.IsOpen) _expandedCategories.Add(key); else _expandedCategories.Remove(key);
    }

    private RenderFragment GetIcon(string title) => builder =>
    {
        // Use same icons as before based on category label
        var seq = 0;
        if ((title ?? string.Empty) == "Forms")
        {
            builder.AddMarkupContent(seq++, "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"1.5\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z\" /></svg>");
        }
        else if ((title ?? string.Empty) == "Display")
        {
            builder.AddMarkupContent(seq++, "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"1.5\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z\" /></svg>");
        }
        else if ((title ?? string.Empty) == "Layout")
        {
            builder.AddMarkupContent(seq++, "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"1.5\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z\" /></svg>");
        }
        else if ((title ?? string.Empty) == "Composite")
        {
            builder.AddMarkupContent(seq++, "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"1.5\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10\" /></svg>");
        }
        else if ((title ?? string.Empty) == "Data & Validation")
        {
            builder.AddMarkupContent(seq++, "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"1.5\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M3 10h18M3 14h18m-9-4v8m-7 0h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z\" /></svg>");
        }
    };

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
