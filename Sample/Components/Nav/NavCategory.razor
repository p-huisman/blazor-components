<div class="nav-category @(IsExpanded ? "nav-category--expanded" : "")">
    <button class="nav-category-header" @onclick="OnToggle" aria-expanded="@IsExpanded.ToString().ToLower()">
        <span class="nav-category-icon" aria-hidden="true">
            @Icon
        </span>
        <span class="nav-category-label">@Label</span>
        <span class="nav-chevron" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
        </span>
    </button>
    <div class="nav-category-content">
        @ChildContent
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public RenderFragment? Icon { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool IsExpanded { get; set; }
    [Parameter] public EventCallback OnToggle { get; set; }
}
