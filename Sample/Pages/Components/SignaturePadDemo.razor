@page "/pggm-signature-pad"
@using Pggm.Components
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>PGGM Signature pad</PageTitle>

<PggmHeading Level="1">Pggm Signature Pad</PggmHeading>

<p>This page demonstrates the PGGM Signature Pad Component.</p>

<div class="demo-section">
    <PggmHeading Level="3">Basic Signature Pad</PggmHeading>

  <EditForm Model="model" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <PggmFieldset>
      <PggmFieldsetLabel For="HandtekeningVeld">Handtekening</PggmFieldsetLabel>
      <PggmFieldsetDescription><p>Gebruik je muis of touch om je handtekening te plaatsen.</p></PggmFieldsetDescription>
      <PggmFieldsetError>
        <PggmErrorMessage For="HandtekeningVeld" Validity="valueMissing">Handtekening is verplicht, plaats een handtekening.</PggmErrorMessage>
        <PggmErrorMessage For="HandtekeningVeld" Validity="badInput">Ongeldige handtekening, plaats een juiste handtekening.</PggmErrorMessage>
      </PggmFieldsetError>
        <PggmSignaturePad Id="HandtekeningVeld" Name="mySignature" Required="true" Value="@model.Signature"
          ValueChanged="@OnSignatureChanged" />
    </PggmFieldset>
    <PggmButton Type="@ButtonType.Submit">Submit</PggmButton>
  </EditForm>

  @if (!string.IsNullOrEmpty(model.Signature))
  {
    <div class="mt-3">
      <strong>Signature Value:</strong>
      <pre class="signature-output">@model.Signature</pre>
    </div>
  }
</div>

<div class="demo-section">
    <PggmHeading Level="3">Signature Pad with Buttons</PggmHeading>

    <PggmHeading Level="4">With Erase Button</PggmHeading>
    <PggmSignaturePad Id="signatureErase" Buttons="erase" />

    <PggmHeading Level="4">With Undo and Redo Buttons</PggmHeading>
    <PggmSignaturePad Id="signatureUndoRedo" Buttons="undo,redo" />

    <PggmHeading Level="4">With All Buttons</PggmHeading>
    <PggmSignaturePad Id="signatureAll" Buttons="erase,undo,redo" />
</div>

<div class="demo-section">
    <PggmHeading Level="3">Disabled Signature Pad</PggmHeading>
    <PggmSignaturePad Id="signatureDisabled" Disabled="true" />
</div>

@code {
  private DemoModel model = new();

  private void HandleValidSubmit()
  {
    // Handle form submit
  }

  private void OnSignatureChanged(string? signature)
  {
    model.Signature = signature;
  }

  public class DemoModel
  {
    public string? Signature { get; set; }
  }

}

@code {
  // Use <PggmFieldsetLabel> in markup for label rendering
}

<style>
.signature-output {
  background-color: #f8f9fa;
  border: 1px solid #d1d5db;
  padding: 0.75rem 1rem;
  border-radius: 6px;
  font-family: monospace;
  font-size: 1rem;
  color: #333;
  white-space: pre-wrap;
  word-break: break-all;
  margin-top: 0.5rem;
  max-width: fit-content;
  max-height: 200px;
  overflow-x: scroll;
}
</style>
