@page "/pggm-paginator"
@using Pggm.Components.Components.PggmDataGrid

<PageTitle>PGGM Paginator</PageTitle>

<PggmHeading Level="1">PGGM Paginator</PggmHeading>

<p>
    <code>PggmPaginator</code> is a standalone pagination control that works with
    <code>PggmDataGrid</code> through a shared <code>PaginationState</code> instance.
    Assign the same state object to both components — the paginator drives navigation and the
    grid automatically reloads data.
</p>

<DemoSection Title="Client-side pagination">
    <PggmPaginator State="@_pagination" ItemsPerPageOptions="@(new[] { 5, 10, 25 })" />

    <PggmDataGrid TGridItem="Employee"
                  Items="@_employees.AsQueryable()"
                  Pagination="@_pagination">
        <PropertyColumn TGridItem="Employee" TProp="string"  Title="Name"       Value="@(x => x.Name)"       Index="0" SortByExpression="@(x => x.Name)" IsDefaultSortColumn="true" />
        <PropertyColumn TGridItem="Employee" TProp="string"  Title="Department" Value="@(x => x.Department)"  Index="1" SortByExpression="@(x => x.Department)" />
        <PropertyColumn TGridItem="Employee" TProp="string"  Title="Location"   Value="@(x => x.Location)"    Index="2" />
        <PropertyColumn TGridItem="Employee" TProp="decimal" Title="Salary"     Value="@(x => x.Salary)"      Index="3" Width="120px" Alignment="Pggm.Components.Components.PggmDataGrid.ColumnAlignment.Right" />
    </PggmDataGrid>

    <PggmPaginator State="@_pagination" NumericNavigation="true" />
</DemoSection>

<DemoSection Title="Numeric navigation &amp; custom summary">
    <PggmPaginator State="@_pagination2"
                   NumericNavigation="true"
                   ItemsPerPageOptions="@(new[] { 5, 10, 20 })">
        <SummaryTemplate Context="ctx">
            Showing <strong>@ctx.FirstItem</strong>&nbsp;–&nbsp;<strong>@ctx.LastItem</strong>
            of <strong>@ctx.TotalItems</strong> employees
        </SummaryTemplate>
    </PggmPaginator>

    <PggmDataGrid TGridItem="Employee"
                  Items="@_employees.AsQueryable()"
                  Pagination="@_pagination2">
        <PropertyColumn TGridItem="Employee" TProp="string"  Title="Name"       Value="@(x => x.Name)"       Index="0" SortByExpression="@(x => x.Name)" IsDefaultSortColumn="true" />
        <PropertyColumn TGridItem="Employee" TProp="string"  Title="Department" Value="@(x => x.Department)"  Index="1" />
        <PropertyColumn TGridItem="Employee" TProp="string"  Title="Location"   Value="@(x => x.Location)"    Index="2" />
        <PropertyColumn TGridItem="Employee" TProp="decimal" Title="Salary"     Value="@(x => x.Salary)"      Index="3" Width="120px" Alignment="Pggm.Components.Components.PggmDataGrid.ColumnAlignment.Right" />
    </PggmDataGrid>
</DemoSection>

