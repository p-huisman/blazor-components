    private string templateGridSource = Pggm.Components.Sample.Utilities.SnippetBuilder.Build(
        "<PggmGrid Columns=\"3\" ColumnGap=\"12\" Items=\"items\">",
        "  <ItemTemplate Context=\"it\">",
        "    <PggmGridItem>",
        "      @it",
        "    </PggmGridItem>",
        "  </ItemTemplate>",
