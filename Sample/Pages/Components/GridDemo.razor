    private string responsiveSource = Pggm.Components.Sample.Utilities.SnippetBuilder.Build(
        "<PggmGrid Columns=\"4\" ColumnGap=\"12\">",
        "  <PggmGridItem>Always visible</PggmGridItem>",
        "  <PggmGridItem Hidden=\"GridItemHidden.Xs\">Hidden on extra-small</PggmGridItem>",
        "  <PggmGridItem Hidden=\"GridItemHidden.Sm\">Hidden on small</PggmGridItem>",
        "</PggmGrid>");

    private IEnumerable<string> items = new[] { "One", "Two", "Three", "Four", "Five", "Six" };

    private string templateGridBehind = Pggm.Components.Sample.Utilities.SnippetBuilder.Build(
        "private IEnumerable<string> items = new[] { \"One\", \"Two\", \"Three\", \"Four\", \"Five\", \"Six\" };",
        "");

    private IEnumerable<ApiMember> gridProperties = new[]
    {
        new ApiMember { Name = "Columns", Type = "int?", DefaultValue = "12", Description = "Number of columns. If not set, grid auto-fits." },
        new ApiMember { Name = "ColumnGap", Type = "int?", DefaultValue = "16", Description = "Column gap in pixels." },
        new ApiMember { Name = "RowGap", Type = "int?", DefaultValue = "16", Description = "Row gap in pixels." },
        new ApiMember { Name = "Items", Type = "IEnumerable<object>?", DefaultValue = "null", Description = "Optional collection of items to render with ItemTemplate." },
        new ApiMember { Name = "ItemTemplate", Type = "RenderFragment<object>?", DefaultValue = "null", Description = "Template used to render each item when `Items` is provided." },
        new ApiMember { Name = "ChildContent", Type = "RenderFragment?", DefaultValue = "null", Description = "Child content rendered inside the grid (PggmGridItem children)." }
    };

    private IEnumerable<ApiMember> gridItemProperties = new[]
    {
        new ApiMember { Name = "ColumnSpan", Type = "int?", DefaultValue = "null", Description = "Number of columns to span." },
        new ApiMember { Name = "RowSpan", Type = "int?", DefaultValue = "null", Description = "Number of rows to span." },
        new ApiMember { Name = "Hidden", Type = "GridItemHidden", DefaultValue = "GridItemHidden.None", Description = "Breakpoint at which this item is hidden." },
        new ApiMember { Name = "ChildContent", Type = "RenderFragment?", DefaultValue = "null", Description = "Content rendered inside the grid item." }
    };

        private string responsiveSpanSource = @"<PggmGrid Columns=""4"" ColumnGap=""16"" RowGap=""16"" Class=""demo-grid"">
    <PggmGridItem XsColumnSpan=""4"" SmColumnSpan=""2"" MdColumnSpan=""1"" LgColumnSpan=""1"">
