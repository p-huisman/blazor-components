    private IEnumerable<ApiMember> inputProperties = new[]
    {
        new ApiMember { Name = "Value", Type = "string?", DefaultValue = "null", Description = "Two-way bound value (provided by InputBase<string>)." },
        new ApiMember { Name = "Name", Type = "string?", DefaultValue = "null", Description = "Name attribute for underlying input." },
        new ApiMember { Name = "Type", Type = "PggmInput.InputTypes", DefaultValue = "text", Description = "Input type (text, email, number, etc.)." },
        new ApiMember { Name = "Placeholder", Type = "string?", DefaultValue = "null", Description = "Placeholder text shown when empty." },
        new ApiMember { Name = "Required", Type = "bool", DefaultValue = "false", Description = "Whether the input is required for validation." },
        new ApiMember { Name = "ReadOnly", Type = "bool", DefaultValue = "false", Description = "When true makes the input read-only." },
        new ApiMember { Name = "Disabled", Type = "bool", DefaultValue = "false", Description = "When true disables the input." },
        new ApiMember { Name = "Min", Type = "string?", DefaultValue = "null", Description = "Minimum value for numeric/date inputs." },
        new ApiMember { Name = "Max", Type = "string?", DefaultValue = "null", Description = "Maximum value for numeric/date inputs." },
        new ApiMember { Name = "ChildContent", Type = "RenderFragment?", DefaultValue = "null", Description = "Optional child content." }
    };

    private IEnumerable<ApiMember> inputEvents = new[]
    {
        new ApiMember { Name = "OnChange", Type = "EventCallback<ChangeEventArgs>", Description = "Invoked when the input value changes (on blur)." },
        new ApiMember { Name = "OnInput", Type = "EventCallback<ChangeEventArgs>", Description = "Invoked on every input event (keystroke)." },
        new ApiMember { Name = "OnFocus", Type = "EventCallback<FocusEventArgs>", Description = "Invoked when input gains focus." },
        new ApiMember { Name = "OnBlur", Type = "EventCallback<FocusEventArgs>", Description = "Invoked when input loses focus." },
        new ApiMember { Name = "ValueChanged", Type = "EventCallback<string?>", Description = "EventCallback for two-way binding updates." }
    };
}

