@page "/pggm-input"
@using System.ComponentModel.DataAnnotations
@using Pggm.Components.Sample.Components.ApiDocumentation

<PageTitle>PGGM Input</PageTitle>

<PggmHeading Level="1">PGGM Input</PggmHeading>
<p>
    This page demonstrates the PggmInput component, which is a wrapper for the pggm-input web component
    using the custom built-in element pattern <code>&lt;input is="pggm-input" /&gt;</code>.
</p>

<DemoSection Title="Basic Input Examples" Code="@basicInputSource" CodeBehind="@basicInputBehind">
    <Content>
        <PggmFieldset>
            <PggmLabel slot="label" For="text-input">Text Input</PggmLabel>
            <PggmErrorMessage slot="error" For="text-input"
                Validity="@($"{PggmErrorMessage.ValidityStates.ValueMissing} {PggmErrorMessage.ValidityStates.CustomError}")">
                <p>Vul <strong>iets</strong> in</p>
            </PggmErrorMessage>
            <PggmInput @bind-Value="_textValue" Id="text-input" Type="@PggmInput.InputTypes.Text" Name="text-input" Required="true"
                       Placeholder="Enter some text..." OnChange="OnTextChanged" />
            <small slot="description" class="form-text text-muted">Current value: @_textValue</small>
        </PggmFieldset>

        <PggmFieldset>
            <PggmLabel slot="label" For="email-input">Email Input</PggmLabel>
            <PggmInput @bind-Value="_emailValue" Id="email-input" Type="@PggmInput.InputTypes.Email" Name="email-input"
                       Placeholder="Enter your email..." Required="true" />
            <small slot="description" class="form-text text-muted">Current value: @_emailValue</small>
        </PggmFieldset>

        <PggmFieldset>
            <PggmLabel slot="label" For="password-input">Password Input</PggmLabel>
            <PggmInput @bind-Value="_passwordValue" Id="password-input" Type="@PggmInput.InputTypes.Password"
                       Name="password-input" Placeholder="Enter password..." MinLength="8" />
            <small slot="description" class="form-text text-muted">Minimum 8 characters</small>
        </PggmFieldset>

        <PggmFieldset>
            <PggmLabel slot="label" For="number-input">Number Input</PggmLabel>
            <PggmInput @bind-Value="_numberValue" Id="number-input" Type="@PggmInput.InputTypes.Number" Name="number-input"
                       Min="0" Max="100" Step="1" Placeholder="Enter a number..." />
            <small slot="description" class="form-text text-muted">Range: 0-100, Current value: @_numberValue</small>
        </PggmFieldset>
    </Content>
</DemoSection>

<DemoSection Title="Advanced Input Examples" Code="@advancedInputSource" CodeBehind="@advancedInputBehind">
    <Content>
        <PggmFieldset>
            <PggmLabel slot="label" For="search-input">Search Input</PggmLabel>
            <PggmInput @bind-Value="_searchValue" Id="search-input" Type="@PggmInput.InputTypes.Search" Name="search-input"
                       Placeholder="Search..." OnInput="OnSearchInput" />
            <small slot="description" class="form-text text-muted">Live search: @_searchValue</small>
        </PggmFieldset>

        <PggmFieldset>
            <PggmLabel slot="label" For="url-input">URL Input</PggmLabel>
            <PggmInput @bind-Value="_urlValue" Id="url-input" Type="@PggmInput.InputTypes.Url" Name="url-input"
                       Placeholder="https://example.com" />
            <small slot="description" class="form-text text-muted">Current URL: @_urlValue</small>
        </PggmFieldset>
    </Content>
</DemoSection>

<DemoSection Title="EditForm Integration Example" Code="@editFormInputSource" CodeBehind="@editFormInputBehind">
    <Content>
        <EditForm Model="_formModel" OnValidSubmit="HandleValidSubmit">
            <DataAnnotationsValidator />
            <PggmValidationSummary>
                <p>Het formulier bevat <strong>fouten</strong>, controleer en corrigeer deze</p>
            </PggmValidationSummary>

            <PggmFieldset>
                <PggmLabel slot="label" For="form-name">Name</PggmLabel>

                <PggmValidationMessage slot="error"  For="() => _formModel.Name">
                    <p>Vul een geldige <strong>naam</strong> in</p>
                </PggmValidationMessage>

                <PggmInput Id="form-name" @bind-Value="_formModel.Name" Name="form-name" Placeholder="Enter your name"
                           Required="true" />

            </PggmFieldset>
            <PggmFieldset>
                <PggmLabel slot="label" For="form-email">Email</PggmLabel>
                <PggmInput Id="form-email" @bind-Value="_formModel.Email" Name="form-email" Type="email"
                           Placeholder="Enter your email" Required="true" />
                <PggmValidationMessage slot="error"  For="() => _formModel.Email">
                    <p>Vul een geldig e-mailadres in</p>
                </PggmValidationMessage>
            </PggmFieldset>
            <button type="submit" class="btn btn-primary">Submit</button>
        </EditForm>
        @if (_formSubmitted)
        {
            <div class="alert alert-success">Form submitted! Name: @_formModel.Name, Email: @_formModel.Email</div>
        }
    </Content>
</DemoSection>

<DemoSection Title="Input States" Code="@statesInputSource" CodeBehind="@statesInputBehind">
    <Content>
        <PggmFieldset>
            <PggmLabel slot="label" For="disabled-input">Disabled Input</PggmLabel>
            <PggmInput id="disabled-input" Value="_disabledValue" ValueExpression="() => _disabledValue" Disabled="true"
                       Placeholder="Disabled input" />
        </PggmFieldset>
        <PggmFieldset>
            <PggmLabel slot="label" For="required-input">Required Input</PggmLabel>
            <PggmInput @bind-Value="_requiredValue" Name="required-input" Id="required-input" Required="true"
                       Placeholder="This field is required" />
            @if (string.IsNullOrEmpty(_requiredValue))
            {
                <small class="text-danger">This field is required</small>
            }
        </PggmFieldset>

        <PggmFieldset>
            <PggmLabel slot="label" For="readonly-input">Read-only Input</PggmLabel>
            <PggmInput id="readonly-input" Value="_readonlyValue" ValueExpression="() => _readonlyValue" ReadOnly="true" />
        </PggmFieldset>
    </Content>
</DemoSection>

<DemoSection Title="Event Handling Example" Code="@eventInputSource" CodeBehind="@eventInputBehind">
    <Content>
        <PggmFieldset>
            <PggmLabel slot="label" For="event-input">Event Demo Input</PggmLabel>
            <PggmInput @bind-Value="_eventValue" Name="event-input" Id="event-input"
                       Placeholder="Type here to see events..." OnChange="OnEventChange" OnInput="OnEventInput"
                       OnFocus="OnEventFocus" OnBlur="OnEventBlur" />

        </PggmFieldset>
        <div style="height: 200px; overflow-y: auto; font-family: monospace; font-size: 0.875rem;">
            @foreach (var logEntry in _eventLog.AsEnumerable().Reverse().Take(20))
            {
                <div>
                    <span class="text-muted">[@logEntry.Timestamp.ToString("HH:mm:ss.fff")]</span>
                    <span class="fw-bold text-primary">@logEntry.Event:</span>
                    @logEntry.Details
                </div>
            }
        </div>
        @if (_eventLog.Count > 20)
        {
            <small>Showing last 20 of @_eventLog.Count events</small>
        }
    </Content>
</DemoSection>

<PggmHeading Level="2">API</PggmHeading>

<PggmHeading Level="3">PggmInput</PggmHeading>
<ApiDocumentation Properties="inputProperties" Events="inputEvents" />

@code {
    // EditForm demo model
    private DemoFormModel _formModel = new();
    private bool _formSubmitted = false;
    private void HandleValidSubmit()
    {
        _formSubmitted = true;
    }

    public class DemoFormModel
    {
        [Required]
        public string? Name { get; set; }
        [Required]
        [EmailAddress]
        public string? Email { get; set; }
    }
    // Basic input values
    private string? _textValue = "";
    private string? _emailValue = "";
    private string? _passwordValue = "";
    private string? _numberValue = "";

    // Advanced input values
    private string? _searchValue = "";
    private string? _urlValue = "";

    // State examples
    private string? _requiredValue = "";
    private string _disabledValue = "This input is disabled";
    private string _readonlyValue = "This input is read-only";

    // Event demo
    private string? _eventValue = "";
    private readonly List<EventLogEntry> _eventLog = new();

    private void OnTextChanged(ChangeEventArgs args)
    {
        LogEvent("Text Change", $"New value: '{args.Value}'");
    }

    private void OnSearchInput(ChangeEventArgs args)
    {
        LogEvent("Search Input", $"Live search: '{args.Value}'");
    }

    private void OnEventChange(ChangeEventArgs args)
    {
        LogEvent("Change Event", $"Value changed to: '{args.Value}'");
    }

    private void OnEventInput(ChangeEventArgs args)
    {
        LogEvent("Input Event", $"Input value: '{args.Value}'");
    }

    private void OnEventFocus(FocusEventArgs args)
    {
        LogEvent("Focus Event", "Input gained focus");
    }

    private void OnEventBlur(FocusEventArgs args)
    {
        LogEvent("Blur Event", "Input lost focus");
    }

    private void LogEvent(string eventName, string details)
    {
        _eventLog.Add(new EventLogEntry
        {
            Timestamp = DateTime.Now,
            Event = eventName,
            Details = details
        });

        // Keep only last 100 events to prevent memory issues
        if (_eventLog.Count > 100)
        {
            _eventLog.RemoveAt(0);
        }

        StateHasChanged();
    }

    public class EventLogEntry
    {
        public DateTime Timestamp { get; set; }
        public string Event { get; set; } = string.Empty;
        public string Details { get; set; } = string.Empty;
    }

    // Code snippets for demo page
    private string basicInputSource = Pggm.Components.Sample.Utilities.SnippetBuilder.Build(
        "<PggmFieldset>",
        "  <PggmLabel slot=\"label\" For=\"text-input\">Text Input</PggmLabel>",
        "  <PggmInput @bind-Value=\"_textValue\" Id=\"text-input\" Type=\"text\" Name=\"text-input\" Placeholder=\"Enter some text...\" />",
        "  <small slot=\"description\" class=\"form-text text-muted\">Current value: @_textValue</small>",
        "</PggmFieldset>",
        "@code {",
        "  private string? _textValue = \"\";",
        "}");

