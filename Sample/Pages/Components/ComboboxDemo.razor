    <PggmComboboxItem Value="nl">Nederland</PggmComboboxItem>
</PggmCombobox>

<!-- multi-select -->
<PggmCombobox Multiple="true" WithClear="true" @bind-Values="_values" Placeholder="Kies talen...">
