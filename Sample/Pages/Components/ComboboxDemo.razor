</PggmCombobox>
""";

    private string _editFormSource = """
<EditForm Model="_model" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />
    <PggmFieldset>
        <PggmLabel slot="label">Land *</PggmLabel>
        <PggmValidationMessage slot="error" For="() => _model.Country" />
        <PggmCombobox @bind-Value="_model.Country" Required="true"
