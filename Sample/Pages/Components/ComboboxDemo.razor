    <PggmComboboxItem Value="csharp">C#</PggmComboboxItem>
    <PggmComboboxItem Value="ts">TypeScript</PggmComboboxItem>
    <PggmComboboxItem Value="python">Python</PggmComboboxItem>
</PggmCombobox>
""";

    private string _eventsSource = """
<PggmCombobox @bind-Value="_value"
