@page "/pggm-combobox"
@using System.ComponentModel.DataAnnotations
@using Pggm.Components.Sample.Components.ApiDocumentation

<PageTitle>PGGM Combobox</PageTitle>

<PggmHeading Level="1">PGGM Combobox</PggmHeading>

<p>
    This page demonstrates the <code>PggmCombobox</code> and <code>PggmComboboxItem</code> Blazor wrappers
    for the <code>pggm-combobox</code> web component. The combobox is a form-associated element and
    supports full <code>EditForm</code> integration, <code>DataAnnotationsValidator</code>, and
    <code>@@bind-Value</code> / <code>@@bind-Values</code> two-way binding.
</p>

<!-- ── 1. Basic single-select ──────────────────────────────────────────────── -->
<DemoSection Title="Basic Single-Select" Code="@_basicSource" CodeBehind="@_basicBehind">
    <Description>
        <p>Single-select combobox with <code>@@bind-Value</code> two-way binding. The selected value is displayed below the component.</p>
    </Description>
    <Content>
        <PggmFieldset>
            <PggmLabel slot="label" For="basic-combo">Land</PggmLabel>
            <PggmCombobox TOption="object" Id="basic-combo" Name="basic-combo" @bind-Value="_basicValue" Placeholder="Kies een land...">
                <PggmComboboxItem Value="nl">Nederland</PggmComboboxItem>
                <PggmComboboxItem Value="de">Duitsland</PggmComboboxItem>
                <PggmComboboxItem Value="be">België</PggmComboboxItem>
                <PggmComboboxItem Value="fr">Frankrijk</PggmComboboxItem>
                <PggmComboboxItem Value="uk">Verenigd Koninkrijk</PggmComboboxItem>
            </PggmCombobox>
        </PggmFieldset>
        <p>Geselecteerde waarde: <strong>@(_basicValue ?? "—")</strong></p>
    </Content>
</DemoSection>

<!-- ── 2. Disabled & Read-only states ─────────────────────────────────────── -->
<DemoSection Title="Disabled &amp; Read-Only" Code="@_statesSource">
    <Description>
        <p>The <code>Disabled</code> and <code>ReadOnly</code> boolean parameters control interactivity.</p>
    </Description>
    <Content>
        <PggmFieldset>
            <PggmLabel slot="label" For="disabled-combo">Uitgeschakeld</PggmLabel>
            <PggmCombobox TOption="object" Id="disabled-combo" Disabled="true" Value="nl" Placeholder="Niet beschikbaar">
                <PggmComboboxItem Value="nl">Nederland</PggmComboboxItem>
            </PggmCombobox>
        </PggmFieldset>

        <PggmFieldset>
            <PggmLabel slot="label" For="readonly-combo">Alleen-lezen</PggmLabel>
            <PggmCombobox TOption="object" Id="readonly-combo" ReadOnly="true" Value="de" Placeholder="Alleen lezen">
                <PggmComboboxItem Value="de">Duitsland</PggmComboboxItem>
            </PggmCombobox>
        </PggmFieldset>
    </Content>
</DemoSection>

<!-- ── 3. Clear button ───────────────────────────────────────────────────── -->
<DemoSection Title="Clear Button" Code="@_withClearSource" CodeBehind="@_withClearBehind">
    <Description>
        <p>
            Set <code>WithClear="true"</code> to render a clear button inside the combobox.
            Clicking it fires a <code>change</code> event with an empty value, clearing the bound field.
            Works in both single-select and multi-select mode.
        </p>
    </Description>
    <Content>
        <PggmFieldset>
            <PggmLabel slot="label" For="wc-single">Land (single-select)</PggmLabel>
            <PggmCombobox TOption="object" Id="wc-single" @bind-Value="_withClearValue" WithClear="true" Placeholder="Kies een land...">
                <PggmComboboxItem Value="nl">Nederland</PggmComboboxItem>
                <PggmComboboxItem Value="de">Duitsland</PggmComboboxItem>
                <PggmComboboxItem Value="be">België</PggmComboboxItem>
                <PggmComboboxItem Value="fr">Frankrijk</PggmComboboxItem>
            </PggmCombobox>
        </PggmFieldset>
        <p>Geselecteerde waarde: <strong>@(_withClearValue ?? "—")</strong></p>

        <PggmFieldset>
            <PggmLabel slot="label" For="wc-multi">Programmeertalen (multi-select)</PggmLabel>
            <PggmCombobox TOption="object" Id="wc-multi" Multiple="true" WithClear="true" @bind-Values="_withClearMultiValues" Placeholder="Kies talen...">
                <PggmComboboxItem Value="csharp">C#</PggmComboboxItem>
                <PggmComboboxItem Value="ts">TypeScript</PggmComboboxItem>
                <PggmComboboxItem Value="python">Python</PggmComboboxItem>
                <PggmComboboxItem Value="java">Java</PggmComboboxItem>
            </PggmCombobox>
        </PggmFieldset>
        <p>Geselecteerde talen: <strong>@(_withClearMultiValues is { Length: > 0 } ? string.Join(", ", _withClearMultiValues) : "—")</strong></p>
    </Content>
</DemoSection>

<!-- ── 4. Visible items ───────────────────────────────────────────────────── -->
<DemoSection Title="Visible Items" Code="@_visibleItemsSource" CodeBehind="@_visibleItemsBehind">
    <Description>
        <p>
            The <code>VisibleItems</code> parameter maps to the <code>visible-items</code> attribute
            and limits how many items are shown in the dropdown before scrolling begins.
        </p>
    </Description>
    <Content>
        <PggmFieldset>
            <PggmLabel slot="label" For="vi-combo">Continent (max. 3 zichtbaar)</PggmLabel>
            <PggmCombobox TOption="object" Id="vi-combo" @bind-Value="_visibleItemsValue" VisibleItems="3" Placeholder="Kies een continent...">
                <PggmComboboxItem Value="af">Afrika</PggmComboboxItem>
                <PggmComboboxItem Value="an">Antarctica</PggmComboboxItem>
                <PggmComboboxItem Value="as">Azië</PggmComboboxItem>
                <PggmComboboxItem Value="au">Australië</PggmComboboxItem>
                <PggmComboboxItem Value="eu">Europa</PggmComboboxItem>
                <PggmComboboxItem Value="na">Noord-Amerika</PggmComboboxItem>
                <PggmComboboxItem Value="sa">Zuid-Amerika</PggmComboboxItem>
            </PggmCombobox>
        </PggmFieldset>
        <p>Geselecteerde waarde: <strong>@(_visibleItemsValue ?? "—")</strong></p>
    </Content>
</DemoSection>

<!-- ── 5. Multi-select with string[] binding ──────────────────────────────── -->
<DemoSection Title="Multi-Select with string[] Binding" Code="@_multiSource" CodeBehind="@_multiBehind">
    <Description>
        <p>
            When <code>Multiple="true"</code> the component works with a <code>string[]</code> value.
            Use <code>@@bind-Values</code> for two-way binding. The <code>Min</code> and <code>Max</code>
        </p>
    </Description>
    <Content>
        <PggmFieldset>
            <PggmLabel slot="label" For="multi-combo">Programmeertalen</PggmLabel>
            <PggmCombobox TOption="object" Id="multi-combo" Multiple="true" Min="1" Max="3" @bind-Values="_multiValues" Placeholder="Kies talen...">
                <PggmComboboxItem Value="csharp">C#</PggmComboboxItem>
                <PggmComboboxItem Value="ts">TypeScript</PggmComboboxItem>
                <PggmComboboxItem Value="python">Python</PggmComboboxItem>
            </PggmCombobox>
        </PggmFieldset>
        <p>Geselecteerde talen: <strong>@(_multiValues is { Length: > 0 } ? string.Join(", ", _multiValues) : "—")</strong></p>
    </Content>
</DemoSection>

<PggmHeading Level="3">PggmComboboxItem</PggmHeading>
<ApiDocumentation Properties="_itemProperties" Events="_itemEvents" />

@code {
