    <PggmComboboxItem Value="opt2">Optie 2</PggmComboboxItem>
    <PggmComboboxItem Value="opt3" Disabled="true">Optie 3 (uitgeschakeld)</PggmComboboxItem>
</PggmCombobox>
""";

