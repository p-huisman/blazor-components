        </PggmCombobox>
    </PggmFieldset>
    <PggmButton Type="@ButtonType.Submit">Verzenden</PggmButton>
</EditForm>
""";

    private string _minMaxSource = """
<PggmCombobox Multiple="true" Min="2" Max="4"
