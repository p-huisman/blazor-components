    <PggmComboboxItem Value="de">Duitsland</PggmComboboxItem>
    <PggmComboboxItem Value="be">België</PggmComboboxItem>
</PggmCombobox>
""";

    private string _statesSource = """
<PggmCombobox Disabled="true" Value="nl">
    <PggmComboboxItem Value="nl">Nederland</PggmComboboxItem>
</PggmCombobox>

<PggmCombobox ReadOnly="true" Value="de">
    <PggmComboboxItem Value="de">Duitsland</PggmComboboxItem>
</PggmCombobox>
""";

    private string _multiSource = """
<PggmCombobox Multiple="true" Min="1" Max="3" @bind-Values="_values"
