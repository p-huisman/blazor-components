    // ── API metadata ───────────────────────────────────────────────────────────
    private IEnumerable<ApiMember> _comboboxProperties = new[]
    {
        new ApiMember { Name = "Value",                 Type = "string?",            DefaultValue = "",        Description = "Currently selected value (single-select). Use with @@bind-Value." },
        new ApiMember { Name = "Values",                Type = "string[]?",          DefaultValue = "",        Description = "Currently selected values (multi-select). Use with @@bind-Values." },
        new ApiMember { Name = "ValueExpression",       Type = "Expression<Func<string>>?", DefaultValue = "", Description = "Field identity expression for EditForm integration." },
        new ApiMember { Name = "Name",                  Type = "string?",            DefaultValue = "",        Description = "Name attribute for form submission." },
        new ApiMember { Name = "Id",                    Type = "string?",            DefaultValue = "auto",    Description = "Element id. Auto-generated when omitted." },
        new ApiMember { Name = "Placeholder",           Type = "string?",            DefaultValue = "",        Description = "Placeholder text shown when nothing is selected." },
        new ApiMember { Name = "Disabled",              Type = "bool",               DefaultValue = "false",   Description = "Disables the combobox." },
        new ApiMember { Name = "ReadOnly",              Type = "bool",               DefaultValue = "false",   Description = "Makes the combobox read-only." },
        new ApiMember { Name = "Required",              Type = "bool",               DefaultValue = "false",   Description = "Marks the field as required. Suppressed inside EditForm." },
        new ApiMember { Name = "Multiple",              Type = "bool",               DefaultValue = "false",   Description = "Enables multi-select mode." },
        new ApiMember { Name = "WithClear",              Type = "bool",               DefaultValue = "false",   Description = "Renders a clear button inside the combobox. Clicking it clears the selection." },
        new ApiMember { Name = "VisibleItems",           Type = "int?",               DefaultValue = "",        Description = "Maximum number of items visible in the dropdown before scrolling. Maps to the visible-items attribute." },
        new ApiMember { Name = "Open",                  Type = "bool",               DefaultValue = "false",   Description = "Controls whether the dropdown panel is open." },
        new ApiMember { Name = "Min",                   Type = "int?",               DefaultValue = "",        Description = "Minimum number of selected items (multi-select). Validated on blur inside EditForm." },
        new ApiMember { Name = "Max",                   Type = "int?",               DefaultValue = "",        Description = "Maximum number of selected items (multi-select). Validated on blur inside EditForm." },
        new ApiMember { Name = "MinValidationMessage",  Type = "string?",            DefaultValue = "",        Description = "Custom error message for the Min constraint." },
        new ApiMember { Name = "MaxValidationMessage",  Type = "string?",            DefaultValue = "",        Description = "Custom error message for the Max constraint." },
        new ApiMember { Name = "ChildContent",          Type = "RenderFragment?",    DefaultValue = "",        Description = "PggmComboboxItem elements rendered inside the combobox." },
        new ApiMember { Name = "Items",                 Type = "IEnumerable<TOption>?",   DefaultValue = "",    Description = "Data collection rendered as pggm-combobox-item elements. Requires OptionValue." },
        new ApiMember { Name = "OptionValue",           Type = "Func<TOption, string?>?", DefaultValue = "",    Description = "Selector for the item value string." },
        new ApiMember { Name = "OptionText",            Type = "Func<TOption, string?>?", DefaultValue = "",    Description = "Selector for the item display text." },
        new ApiMember { Name = "OptionDisabled",        Type = "Func<TOption, bool>?",    DefaultValue = "",    Description = "Selector to disable individual items." },
        new ApiMember { Name = "OptionTemplate",        Type = "RenderFragment<TOption>?",DefaultValue = "",    Description = "Custom render fragment per item. Overrides OptionText/OptionDisabled." },
        new ApiMember { Name = "SelectedOption",        Type = "TOption?",           DefaultValue = "",        Description = "Currently selected item object (single-select). Use with @@bind-SelectedOption." },
        new ApiMember { Name = "SelectedOptionChanged", Type = "EventCallback<TOption?>", DefaultValue = "",    Description = "Fired when the selected item object changes." },
    };

    private IEnumerable<ApiMember> _comboboxEvents = new[]
    {
        new ApiMember { Name = "OnChange",  Type = "EventCallback<ChangeEventArgs>", Description = "Fired when the selected value changes." },
        new ApiMember { Name = "OnFocus",   Type = "EventCallback<FocusEventArgs>",  Description = "Fired when the combobox receives focus." },
        new ApiMember { Name = "OnBlur",    Type = "EventCallback<FocusEventArgs>",  Description = "Fired when the combobox loses focus." },
        new ApiMember { Name = "OnOpen",    Type = "EventCallback",                  Description = "Fired when the dropdown panel opens." },
        new ApiMember { Name = "OnClose",   Type = "EventCallback",                  Description = "Fired when the dropdown panel closes." },
    };

    private IEnumerable<ApiMember> _itemProperties = new[]
    {
        new ApiMember { Name = "Value",    Type = "string?", DefaultValue = "",       Description = "The value submitted when this item is selected." },
        new ApiMember { Name = "Disabled", Type = "bool",    DefaultValue = "false",  Description = "Disables the item so it cannot be selected." },
        new ApiMember { Name = "Selected", Type = "bool",    DefaultValue = "false",  Description = "Pre-selects the item." },
        new ApiMember { Name = "ChildContent", Type = "RenderFragment?", DefaultValue = "", Description = "Label content rendered inside the item." },
    };

    private IEnumerable<ApiMember> _itemEvents = new[]
    {
        new ApiMember { Name = "OnSelect", Type = "EventCallback<object?>", Description = "Fired when this item is selected. (formerly OnItemSelect)" },
    };
}
