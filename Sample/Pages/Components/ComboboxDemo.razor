              MaxValidationMessage="Selecteer maximaal 4 vaardigheden."
              @bind-Values="_model.Skills"
              @bind-Value="_model.SkillsJoined">
    <PggmComboboxItem Value="blazor">Blazor</PggmComboboxItem>
    ...
</PggmCombobox>
""";

    private string _withClearSource = """
<PggmCombobox @bind-Value="_value" WithClear="true" Placeholder="Kies een land...">
    <PggmComboboxItem Value="nl">Nederland</PggmComboboxItem>
</PggmCombobox>

<!-- multi-select -->
<PggmCombobox Multiple="true" WithClear="true" @bind-Values="_values" Placeholder="Kies talen...">
