@code {
    // ── State ──────────────────────────────────────────────────────────────────
    private string? _basicValue;
    private string[]? _multiValues;
    private string? _withClearValue;
    private string[]? _withClearMultiValues;
    private string? _visibleItemsValue;
    private string? _eventValue;
    private string _lastEvent = "Geen";
    private string? _itemsDemoValue = "opt1";

    // ── TOption demo data ────────────────────────────────────────────────────────────
    private EmployeeOption? _selectedEmployee;
    private readonly List<EmployeeOption> _employees = new()
    {
        new EmployeeOption(1, "Anna de Vries",   false),
        new EmployeeOption(2, "Bas Jansen",       false),
        new EmployeeOption(3, "Carla Bakker",     false),
        new EmployeeOption(4, "Dirk Smit",        true),
        new EmployeeOption(5, "Eva van den Berg", false),
    };

    private record EmployeeOption(int Id, string Name, bool Inactive);

    // ── EditForm models ────────────────────────────────────────────────────────
    private RequiredFormModel _requiredModel = new();
    private bool _requiredSubmitted;

    private MinMaxFormModel _minMaxModel = new();
    private bool _minMaxSubmitted;

    private void HandleRequiredSubmit()
    {
        _requiredSubmitted = true;
    }

    private void HandleMinMaxSubmit()
    {
        _minMaxSubmitted = true;
    }

    private void HandleSkillsChanged(string[]? values)
    {
        _minMaxModel.Skills = values;
        _minMaxModel.SkillsJoined = values is { Length: > 0 } ? string.Join(",", values) : null;
    }

    // ── Event handlers ─────────────────────────────────────────────────────────
    private void HandleChange(ChangeEventArgs args) =>
        _lastEvent = $"change → \"{args.Value}\" om {DateTime.Now:HH:mm:ss}";

    private void HandleFocus(FocusEventArgs _) =>
        _lastEvent = $"focus om {DateTime.Now:HH:mm:ss}";

    private void HandleBlur(FocusEventArgs _) =>
        _lastEvent = $"blur om {DateTime.Now:HH:mm:ss}";

    private void HandleOpen() =>
        _lastEvent = $"open om {DateTime.Now:HH:mm:ss}";

    private void HandleClose() =>
        _lastEvent = $"close om {DateTime.Now:HH:mm:ss}";

    // ── Form models ────────────────────────────────────────────────────────────
    private class RequiredFormModel
    {
        [Required(ErrorMessage = "Land is verplicht.")]
        public string? Country { get; set; }

        [Required(ErrorMessage = "Afdeling is verplicht.")]
        public string? Department { get; set; }
    }

    private class MinMaxFormModel
    {
        // Joined string used by InputBase/[Required]; updated automatically by PggmCombobox.
        [Required(ErrorMessage = "Selecteer minimaal één vaardigheid.")]
        public string? SkillsJoined { get; set; }

        public string[]? Skills { get; set; }
    }

    // ── Code snippets ──────────────────────────────────────────────────────────
    private string _basicSource =
        "<PggmCombobox @bind-Value=\"_value\" Placeholder=\"Kies een land...\">\n" +
        "    <PggmComboboxItem Value=\"nl\">Nederland</PggmComboboxItem>\n" +
        "    <PggmComboboxItem Value=\"de\">Duitsland</PggmComboboxItem>\n" +
        "    <PggmComboboxItem Value=\"be\">België</PggmComboboxItem>\n" +
        "</PggmCombobox>";

    private string _statesSource =
