@page "/pggm-combobox"
@using System.ComponentModel.DataAnnotations
@using Pggm.Components.Sample.Components.ApiDocumentation

<PageTitle>PGGM Combobox</PageTitle>

<PggmHeading Level="1">PGGM Combobox</PggmHeading>

<p>
    This page demonstrates the <code>PggmCombobox</code> and <code>PggmComboboxItem</code> Blazor wrappers
    for the <code>pggm-combobox</code> web component. The combobox is a form-associated element and
    supports full <code>EditForm</code> integration, <code>DataAnnotationsValidator</code>, and
    <code>@@bind-Value</code> / <code>@@bind-Values</code> two-way binding.
</p>

<!-- ── 1. Basic single-select ──────────────────────────────────────────────── -->
<DemoSection Title="Basic Single-Select" Code="@_basicSource" CodeBehind="@_basicBehind">
    <Description>
        <p>Single-select combobox with <code>@@bind-Value</code> two-way binding. The selected value is displayed below the component.</p>
    </Description>
    <Content>
        <PggmFieldset>
            <PggmLabel slot="label" For="basic-combo">Land</PggmLabel>
            <PggmCombobox TOption="object" Id="basic-combo" Name="basic-combo" @bind-Value="_basicValue" Placeholder="Kies een land...">
                <PggmComboboxItem Value="nl">Nederland</PggmComboboxItem>
                <PggmComboboxItem Value="de">Duitsland</PggmComboboxItem>
                <PggmComboboxItem Value="be">België</PggmComboboxItem>
                <PggmComboboxItem Value="fr">Frankrijk</PggmComboboxItem>
                <PggmComboboxItem Value="uk">Verenigd Koninkrijk</PggmComboboxItem>
            </PggmCombobox>
        </PggmFieldset>
        <p>Geselecteerde waarde: <strong>@(_basicValue ?? "—")</strong></p>
    </Content>
</DemoSection>

<!-- ── 2. Disabled & Read-only states ─────────────────────────────────────── -->
<DemoSection Title="Disabled &amp; Read-Only" Code="@_statesSource">
    <Description>
        <p>The <code>Disabled</code> and <code>ReadOnly</code> boolean parameters control interactivity.</p>
    </Description>
    <Content>
        <PggmFieldset>
            <PggmLabel slot="label" For="disabled-combo">Uitgeschakeld</PggmLabel>
            <PggmCombobox TOption="object" Id="disabled-combo" Disabled="true" Value="nl" Placeholder="Niet beschikbaar">
                <PggmComboboxItem Value="nl">Nederland</PggmComboboxItem>
            </PggmCombobox>
        </PggmFieldset>

        <PggmFieldset>
            <PggmLabel slot="label" For="readonly-combo">Alleen-lezen</PggmLabel>
            <PggmCombobox TOption="object" Id="readonly-combo" ReadOnly="true" Value="de" Placeholder="Alleen lezen">
                <PggmComboboxItem Value="de">Duitsland</PggmComboboxItem>
            </PggmCombobox>
        </PggmFieldset>
    </Content>
</DemoSection>

<!-- ── 3. Clear button ───────────────────────────────────────────────────── -->
<DemoSection Title="Clear Button" Code="@_withClearSource" CodeBehind="@_withClearBehind">
    <Description>
        <p>
            Set <code>WithClear="true"</code> to render a clear button inside the combobox.
            Clicking it fires a <code>change</code> event with an empty value, clearing the bound field.
            Works in both single-select and multi-select mode.
        </p>
    </Description>
    <Content>
        <PggmFieldset>
            <PggmLabel slot="label" For="wc-single">Land (single-select)</PggmLabel>
            <PggmCombobox TOption="object" Id="wc-single" @bind-Value="_withClearValue" WithClear="true" Placeholder="Kies een land...">
                <PggmComboboxItem Value="nl">Nederland</PggmComboboxItem>
                <PggmComboboxItem Value="de">Duitsland</PggmComboboxItem>
                <PggmComboboxItem Value="be">België</PggmComboboxItem>
                <PggmComboboxItem Value="fr">Frankrijk</PggmComboboxItem>
            </PggmCombobox>
        </PggmFieldset>
        <p>Geselecteerde waarde: <strong>@(_withClearValue ?? "—")</strong></p>

        <PggmFieldset>
            <PggmLabel slot="label" For="wc-multi">Programmeertalen (multi-select)</PggmLabel>
            <PggmCombobox TOption="object" Id="wc-multi" Multiple="true" WithClear="true" @bind-Values="_withClearMultiValues" Placeholder="Kies talen...">
                <PggmComboboxItem Value="csharp">C#</PggmComboboxItem>
                <PggmComboboxItem Value="ts">TypeScript</PggmComboboxItem>
                <PggmComboboxItem Value="python">Python</PggmComboboxItem>
                <PggmComboboxItem Value="java">Java</PggmComboboxItem>
            </PggmCombobox>
        </PggmFieldset>
        <p>Geselecteerde talen: <strong>@(_withClearMultiValues is { Length: > 0 } ? string.Join(", ", _withClearMultiValues) : "—")</strong></p>
    </Content>
</DemoSection>

<!-- ── 4. Visible items ───────────────────────────────────────────────────── -->
<DemoSection Title="Visible Items" Code="@_visibleItemsSource" CodeBehind="@_visibleItemsBehind">
    <Description>
        <p>
            The <code>VisibleItems</code> parameter maps to the <code>visible-items</code> attribute
            and limits how many items are shown in the dropdown before scrolling begins.
        </p>
    </Description>
    <Content>
        <PggmFieldset>
            <PggmLabel slot="label" For="vi-combo">Continent (max. 3 zichtbaar)</PggmLabel>
            <PggmCombobox TOption="object" Id="vi-combo" @bind-Value="_visibleItemsValue" VisibleItems="3" Placeholder="Kies een continent...">
                <PggmComboboxItem Value="af">Afrika</PggmComboboxItem>
                <PggmComboboxItem Value="an">Antarctica</PggmComboboxItem>
                <PggmComboboxItem Value="as">Azië</PggmComboboxItem>
                <PggmComboboxItem Value="au">Australië</PggmComboboxItem>
                <PggmComboboxItem Value="eu">Europa</PggmComboboxItem>
                <PggmComboboxItem Value="na">Noord-Amerika</PggmComboboxItem>
                <PggmComboboxItem Value="sa">Zuid-Amerika</PggmComboboxItem>
            </PggmCombobox>
        </PggmFieldset>
        <p>Geselecteerde waarde: <strong>@(_visibleItemsValue ?? "—")</strong></p>
    </Content>
</DemoSection>

<!-- ── 5. Multi-select with string[] binding ──────────────────────────────── -->
<DemoSection Title="Multi-Select with string[] Binding" Code="@_multiSource" CodeBehind="@_multiBehind">
    <Description>
        <p>
            When <code>Multiple="true"</code> the component works with a <code>string[]</code> value.
            Use <code>@@bind-Values</code> for two-way binding. The <code>Min</code> and <code>Max</code>
            parameters restrict how many items may be selected; violations are reported on blur.
        </p>
    </Description>
    <Content>
        <PggmFieldset>
            <PggmLabel slot="label" For="multi-combo">Programmeertalen (kies 1–3)</PggmLabel>
            <PggmCombobox TOption="object" Id="multi-combo" Name="languages" Multiple="true" Min="1" Max="3"
                          @bind-Values="_multiValues" Placeholder="Kies talen...">
                <PggmComboboxItem Value="csharp">C#</PggmComboboxItem>
                <PggmComboboxItem Value="ts">TypeScript</PggmComboboxItem>
                <PggmComboboxItem Value="python">Python</PggmComboboxItem>
                <PggmComboboxItem Value="java">Java</PggmComboboxItem>
                <PggmComboboxItem Value="go">Go</PggmComboboxItem>
                <PggmComboboxItem Value="rust">Rust</PggmComboboxItem>
            </PggmCombobox>
        </PggmFieldset>
        <p>Geselecteerde talen: <strong>@(_multiValues is { Length: > 0 } ? string.Join(", ", _multiValues) : "—")</strong></p>
    </Content>
</DemoSection>

<!-- ── 4. Event handling ───────────────────────────────────────────────────── -->
<DemoSection Title="Event Handling" Code="@_eventsSource" CodeBehind="@_eventsBehind">
    <Description>
        <p>The combobox exposes <code>OnChange</code>, <code>OnFocus</code>, <code>OnBlur</code>, <code>OnOpen</code> and <code>OnClose</code> callbacks.</p>
    </Description>
    <Content>
        <PggmFieldset>
            <PggmLabel slot="label" For="event-combo">Afdeling</PggmLabel>
            <PggmCombobox TOption="object" Id="event-combo" @bind-Value="_eventValue"
                          Placeholder="Kies een afdeling..."
                          OnChange="HandleChange"
                          OnFocus="HandleFocus"
                          OnBlur="HandleBlur"
                          OnOpen="HandleOpen"
                          OnClose="HandleClose">
                <PggmComboboxItem Value="hr">Human Resources</PggmComboboxItem>
                <PggmComboboxItem Value="it">IT</PggmComboboxItem>
                <PggmComboboxItem Value="finance">Financiën</PggmComboboxItem>
                <PggmComboboxItem Value="marketing">Marketing</PggmComboboxItem>
            </PggmCombobox>
        </PggmFieldset>
        <p>Laatste event: <strong>@_lastEvent</strong></p>
    </Content>
</DemoSection>

<!-- ── 5. EditForm — required / data annotations ──────────────────────────── -->
<DemoSection Title="EditForm — Required Validation" Code="@_editFormSource" CodeBehind="@_editFormBehind">
    <Description>
        <p>
            <code>PggmCombobox</code> inherits from <code>InputBase&lt;string&gt;</code> and participates
            in <code>EditContext</code>. <code>[Required]</code> data annotations work out of the box.
            The native browser validation popup is suppressed; errors appear via <code>PggmValidationMessage</code>.
        </p>
    </Description>
    <Content>
        <EditForm Model="_requiredModel" OnValidSubmit="HandleRequiredSubmit">
            <DataAnnotationsValidator />
            <PggmValidationSummary>
                <p class="text-danger">Corrigeer de volgende fouten:</p>
            </PggmValidationSummary>

            <PggmFieldset>
                <PggmLabel slot="label" For="ef-country">Land <span aria-hidden="true">*</span></PggmLabel>
                <PggmValidationMessage slot="error" For="() => _requiredModel.Country" />
                <PggmCombobox TOption="object" Id="ef-country" Name="ef-country" @bind-Value="_requiredModel.Country"
                              Placeholder="Kies een land..." Required="true">
                    <PggmComboboxItem Value="nl">Nederland</PggmComboboxItem>
                    <PggmComboboxItem Value="de">Duitsland</PggmComboboxItem>
                    <PggmComboboxItem Value="be">België</PggmComboboxItem>
                    <PggmComboboxItem Value="fr">Frankrijk</PggmComboboxItem>
                </PggmCombobox>
            </PggmFieldset>

            <PggmFieldset>
                <PggmLabel slot="label" For="ef-dept">Afdeling <span aria-hidden="true">*</span></PggmLabel>
                <PggmValidationMessage slot="error" For="() => _requiredModel.Department" />
                <PggmCombobox TOption="object" Id="ef-dept" Name="ef-dept" @bind-Value="_requiredModel.Department"
                              Placeholder="Kies een afdeling..." Required="true">
                    <PggmComboboxItem Value="hr">Human Resources</PggmComboboxItem>
                    <PggmComboboxItem Value="it">IT</PggmComboboxItem>
                    <PggmComboboxItem Value="finance">Financiën</PggmComboboxItem>
                </PggmCombobox>
            </PggmFieldset>

            <PggmButton Type="@ButtonType.Submit" Appearance="@ButtonAppearance.Primary">Verzenden</PggmButton>
        </EditForm>

        @if (_requiredSubmitted)
        {
            <div class="alert alert-success mt-2">
                Formulier verzonden! Land: <strong>@_requiredModel.Country</strong>,
                Afdeling: <strong>@_requiredModel.Department</strong>
            </div>
        }
    </Content>
</DemoSection>

<!-- ── 6. EditForm — multi-select Min/Max validation ──────────────────────── -->
<DemoSection Title="EditForm — Multi-Select Min/Max Validation" Code="@_minMaxSource" CodeBehind="@_minMaxBehind">
    <Description>
        <p>
            In multi-select mode the <code>Min</code> and <code>Max</code> parameters are enforced on blur
            via a <code>ValidationMessageStore</code>. The error messages can be customised with
            <code>MinValidationMessage</code> and <code>MaxValidationMessage</code>.
        </p>
    </Description>
    <Content>
        <EditForm Model="_minMaxModel" OnValidSubmit="HandleMinMaxSubmit">
            <DataAnnotationsValidator />
            <PggmValidationSummary>
                <p class="text-danger">Corrigeer de volgende fouten:</p>
            </PggmValidationSummary>

            <PggmFieldset>
                <PggmLabel slot="label" For="mm-skills">Vaardigheden (kies 2–4)</PggmLabel>
                <PggmValidationMessage slot="error" For="() => _minMaxModel.Skills" />
                <PggmCombobox TOption="object" Id="mm-skills" Name="mm-skills" Multiple="true"
                              Min="2" Max="4"
                              MinValidationMessage="Selecteer minimaal 2 vaardigheden."
                              MaxValidationMessage="Selecteer maximaal 4 vaardigheden."
                              Values="@_minMaxModel.Skills"
                              ValuesChanged="HandleSkillsChanged"
                              @bind-Value="_minMaxModel.SkillsJoined"
                              Placeholder="Kies vaardigheden...">
                    <PggmComboboxItem Value="blazor">Blazor</PggmComboboxItem>
                    <PggmComboboxItem Value="csharp">C#</PggmComboboxItem>
                    <PggmComboboxItem Value="ts">TypeScript</PggmComboboxItem>
                    <PggmComboboxItem Value="css">CSS</PggmComboboxItem>
                    <PggmComboboxItem Value="sql">SQL</PggmComboboxItem>
                    <PggmComboboxItem Value="azure">Azure</PggmComboboxItem>
                </PggmCombobox>
            </PggmFieldset>

            <PggmButton Type="@ButtonType.Submit" Appearance="@ButtonAppearance.Primary">Verzenden</PggmButton>
        </EditForm>

        @if (_minMaxSubmitted)
        {
            <div class="alert alert-success mt-2">
                Formulier verzonden! Vaardigheden: <strong>@string.Join(", ", _minMaxModel.Skills ?? Array.Empty<string>())</strong>
            </div>
        }
    </Content>
</DemoSection>

<!-- ── 7. PggmComboboxItem variations ─────────────────────────────────────── -->
<DemoSection Title="PggmComboboxItem — Disabled & Pre-Selected" Code="@_itemsSource" CodeBehind="@_itemsBehind">
    <Description>
        <p>
            <code>PggmComboboxItem</code> supports <code>Value</code>, <code>Disabled</code>
            and <code>Selected</code> parameters.
        </p>
    </Description>
    <Content>
        <PggmCombobox TOption="object" @bind-Value="_itemsDemoValue" Placeholder="Kies een optie...">
            <PggmComboboxItem Value="opt1" Selected="true">Optie 1 (voorgeselecteerd)</PggmComboboxItem>
            <PggmComboboxItem Value="opt2">Optie 2</PggmComboboxItem>
            <PggmComboboxItem Value="opt3" Disabled="true">Optie 3 (uitgeschakeld)</PggmComboboxItem>
            <PggmComboboxItem Value="opt4">Optie 4</PggmComboboxItem>
        </PggmCombobox>
        <p>Geselecteerd: <strong>@(_itemsDemoValue ?? "—")</strong></p>
    </Content>
</DemoSection>
<!-- ── 8. Data binding with TOption ──────────────────────────────────────────── -->
<DemoSection Title="Data Binding with TOption" Code="@_tOptionSource" CodeBehind="@_tOptionBehind">
    <Description>
        <p>
            Pass a typed collection via <code>Items</code> and use <code>OptionValue</code>,
            <code>OptionText</code> and <code>OptionDisabled</code> selectors to generate
            <code>pggm-combobox-item</code> elements automatically.
            <code>@@bind-SelectedOption</code> gives two-way binding to the full object.
        </p>
    </Description>
    <Content>
        <PggmFieldset>
            <PggmLabel slot="label" For="to-combo">Medewerker</PggmLabel>
            <PggmCombobox TOption="EmployeeOption"
                          Id="to-combo"
                          Items="@_employees"
                          OptionValue="@(e => e.Id.ToString())"
                          OptionText="@(e => e.Name)"
                          OptionDisabled="@(e => e.Inactive)"
                          Value="@(_selectedEmployee?.Id.ToString())"
                          @bind-SelectedOption="_selectedEmployee"
                          WithClear="true"
                          Placeholder="Kies een medewerker..." />
        </PggmFieldset>
        <p>Geselecteerde medewerker: <strong>@(_selectedEmployee is null ? "—" : $"{_selectedEmployee.Name} (id {_selectedEmployee.Id})")</strong></p>
    </Content>
</DemoSection>
