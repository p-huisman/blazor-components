@code {
    // Basic examples
    private string? bankAccountValue1;
    private string? bankAccountValue2;
    private string? bankAccountValue3 = """{"accountNumber":"NL91ABNA0417164300","country":"NL"}""";

    // Country-specific examples
    private string? bankAccountValueNL;
    private string? bankAccountValueDE;
    private string? bankAccountValueBE;

    // Event handling example
    private string? bankAccountValue4;
    private string eventMessage = "";
    private bool? validationState;
    private string lastEventMessage = string.Empty;
    private DateTime lastEventTime;

    // Parse example
    private string? bankAccountValue5;
    private string? parsedBankAccount;

    // Custom endpoint example
    private string? customEndpointValue;

    // Form example
    private BankAccountFormModel formModel = new();
    private bool formSubmitted = false;

    private void OnBankAccountInput(ChangeEventArgs args)
    {
        eventMessage = $"Input event fired - Value length: {args.Value?.ToString()?.Length ?? 0}";
        LogEvent(eventMessage);
    }

    private void OnBankAccountChange(ChangeEventArgs args)
    {
        eventMessage = $"Change event fired - Value: {(string.IsNullOrEmpty(args.Value?.ToString()) ? "empty" : "has data")}";
        LogEvent(eventMessage);
    }

    private void OnBankAccountFocus(FocusEventArgs args)
    {
        eventMessage = "Bank account input focused";
        LogEvent(eventMessage);
    }

    private void OnBankAccountBlur(FocusEventArgs args)
    {
        eventMessage = "Bank account input blurred";
        LogEvent(eventMessage);
    }

    private void OnValidationChanged(bool isValid)
    {
        validationState = isValid;
        eventMessage = $"Validation changed: {(isValid ? "Valid" : "Invalid")}";
        LogEvent(eventMessage);
    }

    private void ParseBankAccount(ChangeEventArgs args)
    {
        try
        {
            if (!string.IsNullOrEmpty(bankAccountValue5))
            {
                var json = System.Text.Json.JsonDocument.Parse(bankAccountValue5);
                parsedBankAccount = System.Text.Json.JsonSerializer.Serialize(json, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
            }
            else
            {
                parsedBankAccount = null;
            }
        }
        catch (Exception ex)
        {
            parsedBankAccount = $"Error parsing bank account: {ex.Message}";
        }
    }

    private void HandleSubmit()
    {
        formSubmitted = true;
        LogEvent("Form submitted");
    }

    private void ResetForm()
    {
        formModel = new();
        formSubmitted = false;
        LogEvent("Form reset");
    }

    private void LogEvent(string message)
    {
        lastEventMessage = message;
        lastEventTime = DateTime.Now;
        StateHasChanged();
    }

    public class BankAccountFormModel
    {
        public string? PrimaryAccount { get; set; }
        public string? SavingsAccount { get; set; }
    }

    // Snippets for the demo sections
    private string basicSource = """
        <PggmBankAccountInput @bind-Value="bankAccountValue1" Name="bankAccount1" Id="bankAccount1" LandenEndpoint="/api/financieel-landen.json" />
        """;

    private string basicBehind = """
        private string? bankAccountValue1;
        """;

    private string countrySource = """
        <PggmBankAccountInput @bind-Value="bankAccountValueNL" Country="NL" />
        <PggmBankAccountInput @bind-Value="bankAccountValueDE" Country="DE" />
        <PggmBankAccountInput @bind-Value="bankAccountValueBE" Country="BE" />
        """;

    private string countryBehind = """
        private string? bankAccountValueNL;
        private string? bankAccountValueDE;
        private string? bankAccountValueBE;
        """;

    private string eventsSource = """
        <PggmBankAccountInput @bind-Value="bankAccountValue4" OnInput="OnBankAccountInput" OnChange="OnBankAccountChange" OnFocus="OnBankAccountFocus" OnBlur="OnBankAccountBlur" OnValidationChanged="OnValidationChanged" />
        """;

    private string eventsBehind = """
        private string? bankAccountValue4;
        private void OnBankAccountInput(ChangeEventArgs args) { }
        private void OnBankAccountChange(ChangeEventArgs args) { }
        private void OnBankAccountFocus(FocusEventArgs args) { }
        private void OnBankAccountBlur(FocusEventArgs args) { }
        private void OnValidationChanged(bool isValid) { }
        """;

    private string formSource = """
        <EditForm Model="formModel" OnValidSubmit="HandleSubmit">
            <PggmBankAccountInput @bind-Value="formModel.PrimaryAccount" Required="true" />
        </EditForm>
        """;

    private string formBehind = """
        private BankAccountFormModel formModel = new();
        private void HandleSubmit() { }
        """;

    private string parseSource = """
        <PggmBankAccountInput @bind-Value="bankAccountValue5" OnChange="ParseBankAccount" />
        """;

    private string parseBehind = """
        private string? bankAccountValue5;
        private string? parsedBankAccount;
        private void ParseBankAccount(ChangeEventArgs args) { }
        """;

    private string customEndpointSource = """
        <PggmBankAccountInput @bind-Value="customEndpointValue" LandenEndpoint="/api/financieel-landen.json" />
        """;

    private string customEndpointBehind = """
        private string? customEndpointValue;
        """;

    private IEnumerable<ApiMember> bankAccountProperties = new[] {
        new ApiMember { Name = "Value", Type = "string?", DefaultValue = "null", Description = "JSON string with accountNumber and country." },
        new ApiMember { Name = "Name", Type = "string?", DefaultValue = "null", Description = "Name attribute for form integration." },
        new ApiMember { Name = "Id", Type = "string?", DefaultValue = "null", Description = "Id attribute." },
        new ApiMember { Name = "Country", Type = "string?", DefaultValue = "null", Description = "Country code to control formatting/validation." },
        new ApiMember { Name = "LandenEndpoint", Type = "string", DefaultValue = "https://staticweb-cdn-o.azureedge.net/design-system/api/financieel-landen.json", Description = "Endpoint for country metadata." },
        new ApiMember { Name = "Required", Type = "bool", DefaultValue = "false", Description = "Marks the input as required." },
        new ApiMember { Name = "Disabled", Type = "bool", DefaultValue = "false", Description = "Disables the input." },
        new ApiMember { Name = "AdditionalAttributes", Type = "Dictionary<string, object>?", DefaultValue = "null", Description = "Splat additional attributes onto the element." },
        new ApiMember { Name = "CssClass", Type = "string?", DefaultValue = "null", Description = "Additional CSS classes applied to the underlying element." },
    };

    private IEnumerable<ApiMember> bankAccountEvents = new[] {
        new ApiMember { Name = "OnInput", Type = "EventCallback<ChangeEventArgs>", Description = "Fired on input events." },
        new ApiMember { Name = "OnChange", Type = "EventCallback<ChangeEventArgs>", Description = "Fired when the value changes." },
        new ApiMember { Name = "OnFocus", Type = "EventCallback<FocusEventArgs>", Description = "Fired when the input receives focus." },
        new ApiMember { Name = "OnBlur", Type = "EventCallback<FocusEventArgs>", Description = "Fired when the input loses focus." },
        new ApiMember { Name = "OnValidationChanged", Type = "EventCallback<bool>", Description = "Fired when the validation state changes." },
    };
}
