@page "/pggm-bank-account-input"
@namespace Pggm.Components.Sample.Pages.Components
@using Microsoft.AspNetCore.Components
@using Pggm.Components.Sample.Components.ApiDocumentation
@inject NavigationManager NavigationManager

<PageTitle>PGGM Bank Account Input</PageTitle>

<PggmHeading Level="1">PGGM Bank Account Input</PggmHeading>

<p>This page demonstrates the <code>PggmBankAccountInput</code> component with examples, event handling, parsing and form integration. Each demo includes runnable markup and copyable code snippets.</p>

@if (!string.IsNullOrEmpty(lastEventMessage))
{
    <div class="event-feedback">
        <strong>Last event:</strong> @lastEventMessage at @lastEventTime.ToString("HH:mm:ss")
    </div>
}

<DemoSection Title="Basic Bank Account Examples" Code="@basicSource" CodeBehind="@basicBehind">
    <Description>
        <p>Simple usages: default input, required and disabled variants. The component binds to a JSON string containing account number and country.</p>
    </Description>
    <Content>
        <div class="form-group">
            <PggmLabel For="bankAccount1">Basic Bank Account Input:</PggmLabel>
            <PggmErrorMessage For="bankAccount1" Validity="@($"{PggmErrorMessage.ValidityStates.ValueMissing} {PggmErrorMessage.ValidityStates.CustomError}")">Vul een geldig rekeningnummer in</PggmErrorMessage>
            <PggmBankAccountInput @bind-Value="bankAccountValue1" Name="bankAccount1" Id="bankAccount1" LandenEndpoint="@($"{NavigationManager.BaseUri}api/financieel-landen.json")" />
            <p class="value-display">Current value: @(bankAccountValue1 ?? "null")</p>
        </div>

        <div class="form-group">
            <PggmLabel For="bankAccount2">Required Bank Account Input:</PggmLabel>
            <PggmErrorMessage For="bankAccount2" Validity="@($"{PggmErrorMessage.ValidityStates.ValueMissing} {PggmErrorMessage.ValidityStates.CustomError}")">Dit veld is verplicht</PggmErrorMessage>
            <PggmBankAccountInput @bind-Value="bankAccountValue2" Name="bankAccount2" Id="bankAccount2" Required="true" LandenEndpoint="@($"{NavigationManager.BaseUri}api/financieel-landen.json")" />
            <p class="value-display">Current value: @(bankAccountValue2 ?? "null")</p>
        </div>

        <div class="form-group">
            <PggmLabel For="bankAccount3">Disabled Bank Account Input:</PggmLabel>
            <PggmBankAccountInput @bind-Value="bankAccountValue3" Name="bankAccount3" Id="bankAccount3" Disabled="true" LandenEndpoint="@($"{NavigationManager.BaseUri}api/financieel-landen.json")" />
            <p class="value-display">Current value: @bankAccountValue3</p>
        </div>
    </Content>
</DemoSection>

<DemoSection Title="Country-Specific Examples" Code="@countrySource" CodeBehind="@countryBehind">
    <Description>
        <p>Examples for different country formats: NL, DE and BE. The component accepts a <code>Country</code> parameter to change formatting and validation.</p>
    </Description>
    <Content>
        <div class="form-group">
            <PggmLabel For="bankAccountNL">Dutch Bank Account (NL):</PggmLabel>
            <PggmErrorMessage For="bankAccountNL" Validity="@($"{PggmErrorMessage.ValidityStates.ValueMissing} {PggmErrorMessage.ValidityStates.CustomError}")">Vul een geldig Nederlands rekeningnummer in</PggmErrorMessage>
            <PggmBankAccountInput @bind-Value="bankAccountValueNL" Name="bankAccountNL" Id="bankAccountNL" Country="NL" Required="true" LandenEndpoint="@($"{NavigationManager.BaseUri}api/financieel-landen.json")" />
            <p class="value-display">Current value: @(bankAccountValueNL ?? "null")</p>
            <p class="info-text">Example: NL91 ABNA 0417 1643 00</p>
        </div>

        <div class="form-group">
            <PggmLabel For="bankAccountDE">German Bank Account (DE):</PggmLabel>
            <PggmErrorMessage For="bankAccountDE" Validity="@($"{PggmErrorMessage.ValidityStates.ValueMissing} {PggmErrorMessage.ValidityStates.CustomError}")">Please enter a valid German bank account</PggmErrorMessage>
            <PggmBankAccountInput @bind-Value="bankAccountValueDE" Name="bankAccountDE" Id="bankAccountDE" Country="DE" Required="true" LandenEndpoint="@($"{NavigationManager.BaseUri}api/financieel-landen.json")" />
            <p class="value-display">Current value: @(bankAccountValueDE ?? "null")</p>
            <p class="info-text">Example: DE89 3704 0044 0532 0130 00</p>
        </div>

        <div class="form-group">
            <PggmLabel For="bankAccountBE">Belgian Bank Account (BE):</PggmLabel>
            <PggmErrorMessage For="bankAccountBE" Validity="@($"{PggmErrorMessage.ValidityStates.ValueMissing} {PggmErrorMessage.ValidityStates.CustomError}")">Please enter a valid Belgian bank account</PggmErrorMessage>
            <PggmBankAccountInput @bind-Value="bankAccountValueBE" Name="bankAccountBE" Id="bankAccountBE" Country="BE" Required="true" LandenEndpoint="@($"{NavigationManager.BaseUri}api/financieel-landen.json")" />
            <p class="value-display">Current value: @(bankAccountValueBE ?? "null")</p>
            <p class="info-text">Example: BE68 5390 0754 7034</p>
        </div>
    </Content>
</DemoSection>

<DemoSection Title="Bank Account with Event Handling" Code="@eventsSource" CodeBehind="@eventsBehind">
    <Description>
        <p>Shows how to handle component events: <code>OnInput</code>, <code>OnChange</code>, <code>OnFocus</code>, <code>OnBlur</code> and <code>OnValidationChanged</code>. Events are logged to the banner above.</p>
    </Description>
    <Content>
        <div class="form-group">
            <PggmLabel For="bankAccount4">Bank Account with Events:</PggmLabel>
            <PggmErrorMessage For="bankAccount4" Validity="@($"{PggmErrorMessage.ValidityStates.ValueMissing} {PggmErrorMessage.ValidityStates.CustomError}")">Vul een geldig rekeningnummer in</PggmErrorMessage>
            <PggmBankAccountInput @bind-Value="bankAccountValue4" Name="bankAccount4" Id="bankAccount4" Country="NL" Required="true" LandenEndpoint="@($"{NavigationManager.BaseUri}api/financieel-landen.json")" OnInput="@OnBankAccountInput" OnChange="@OnBankAccountChange" OnFocus="@OnBankAccountFocus" OnBlur="@OnBankAccountBlur" OnValidationChanged="@OnValidationChanged" />
            <p class="value-display">Current value: @(bankAccountValue4 ?? "null")</p>
            @if (!string.IsNullOrEmpty(eventMessage)) { <p class="event-message">@eventMessage</p> }
            @if (validationState.HasValue) { <p class="validation-message">Bank account is: <strong>@(validationState.Value ? "VALID" : "INVALID")</strong></p> }
        </div>
    </Content>
</DemoSection>

<DemoSection Title="Form Example" Code="@formSource" CodeBehind="@formBehind">
    <Description>
        <p>Using <code>PggmBankAccountInput</code> inside an <code>EditForm</code> with validation and submission feedback.</p>
    </Description>
    <Content>
        <EditForm Model="formModel" OnValidSubmit="HandleSubmit">
            <div class="form-group">
                <PggmLabel For="primaryAccount">Primary Bank Account:</PggmLabel>
                <PggmErrorMessage For="primaryAccount" Validity="@($"{PggmErrorMessage.ValidityStates.ValueMissing} {PggmErrorMessage.ValidityStates.CustomError}")">Primary account is required</PggmErrorMessage>
                <PggmBankAccountInput @bind-Value="formModel.PrimaryAccount" Name="primaryAccount" Id="primaryAccount" Country="NL" Required="true" LandenEndpoint="@($"{NavigationManager.BaseUri}api/financieel-landen.json")" />
            </div>

            <div class="form-group">
                <PggmLabel For="savingsAccount">Savings Account (Optional):</PggmLabel>
                <PggmErrorMessage For="savingsAccount" Validity="@($"{PggmErrorMessage.ValidityStates.ValueMissing} {PggmErrorMessage.ValidityStates.CustomError}")">Invalid savings account</PggmErrorMessage>
                <PggmBankAccountInput @bind-Value="formModel.SavingsAccount" Name="savingsAccount" Id="savingsAccount" Country="NL" LandenEndpoint="@($"{NavigationManager.BaseUri}api/financieel-landen.json")" />
            </div>

            <div class="form-actions">
                <PggmButton Type="@ButtonType.Submit">Submit Form</PggmButton>
                <PggmButton Type="@ButtonType.Button" Appearance="@ButtonAppearance.Secondary" @onclick="ResetForm">Reset</PggmButton>
            </div>
        </EditForm>

        @if (formSubmitted)
        {
            <div class="success-message">
                <PggmNotification Type="success" Open="true">
                    <h3 slot="header">Form Submitted Successfully!</h3>
                    <p><strong>Primary Account:</strong> @formModel.PrimaryAccount</p>
                    @if (!string.IsNullOrEmpty(formModel.SavingsAccount)) { <p><strong>Savings Account:</strong> @formModel.SavingsAccount</p> }
                </PggmNotification>
            </div>
        }
    </Content>
</DemoSection>

<DemoSection Title="Parsed Bank Account Data" Code="@parseSource" CodeBehind="@parseBehind">
    <Description>
        <p>Demonstrates parsing the component value (JSON) for debugging and display.</p>
    </Description>
    <Content>
        <div class="form-group">
            <PggmLabel For="bankAccount5">Bank Account to Parse:</PggmLabel>
            <PggmBankAccountInput @bind-Value="bankAccountValue5" Name="bankAccount5" Id="bankAccount5" Country="NL" LandenEndpoint="@($"{NavigationManager.BaseUri}api/financieel-landen.json")" OnChange="@ParseBankAccount" />
        </div>

        @if (parsedBankAccount != null)
        {
            <div class="parsed-data">
                <h4>Parsed Bank Account Data:</h4>
                <pre>@parsedBankAccount</pre>
            </div>
        }
    </Content>
</DemoSection>

<DemoSection Title="Custom Endpoint Example" Code="@customEndpointSource" CodeBehind="@customEndpointBehind">
    <Description>
        <p>Shows how to point the component to a custom landen endpoint for country data.</p>
    </Description>
    <Content>
        <div class="form-group">
            <PggmLabel For="customEndpoint">Bank Account with Custom Endpoint:</PggmLabel>
            <PggmErrorMessage For="customEndpoint" Validity="@($"{PggmErrorMessage.ValidityStates.ValueMissing} {PggmErrorMessage.ValidityStates.CustomError}")">Invalid bank account</PggmErrorMessage>
            <PggmBankAccountInput @bind-Value="customEndpointValue" Name="customEndpoint" Id="customEndpoint" LandenEndpoint="@($"{NavigationManager.BaseUri}api/financieel-landen.json")" Country="NL" />
            <p class="value-display">Current value: @(customEndpointValue ?? "null")</p>
            <p class="info-text">Using custom landen endpoint for country data</p>
        </div>
    </Content>
</DemoSection>

<PggmHeading Level="2">API</PggmHeading>

<PggmHeading Level="3">PggmBankAccountInput</PggmHeading>
<ApiDocumentation Properties="bankAccountProperties" Events="bankAccountEvents" />

<style>
    /* demo-section styles are provided globally in wwwroot/css/custom-formatters.css */

    .form-group {
        margin-bottom: 20px;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        font-weight: bold;
    }

    .value-display {
        margin-top: 8px;
        padding: 8px;
        background-color: #f5f5f5;
        border-radius: 4px;
        font-family: monospace;
        font-size: 0.9em;
        word-break: break-all;
    }

    .event-message {
        color: #0066cc;
        font-style: italic;
        margin-top: 8px;
        padding: 8px;
        background-color: #e3f2fd;
        border-radius: 4px;
    }

    .validation-message {
        margin-top: 8px;
        padding: 8px;
        background-color: #f0f0f0;
