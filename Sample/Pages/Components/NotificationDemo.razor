@page "/pggm-notification"
@using Pggm.Components.Sample.Components.ApiDocumentation
<PageTitle>PGGM Notification</PageTitle>

<PggmHeading Level="1">PGGM Notification</PggmHeading>

<p>This page demonstrates the PggmNotification component with various types and configurations.</p>

<DemoSection Title="Notification Types" Code="@notificationTypesSource" CodeBehind="@notificationTypesBehind">
  
  <div class="notification-examples">
    <PggmNotification Open=true Type="@PggmNotification.NotificationTypes.Informative">
      <PggmNotificationTitle>This is an Informative Notification</PggmNotificationTitle>
      This is an informative notification message with useful information for the user.
      <a slot="action" href="#">Learn more</a>
    </PggmNotification>

    <PggmNotification Open=true Type="@PggmNotification.NotificationTypes.Warning">
      <PggmNotificationTitle>This is a Warning Notification</PggmNotificationTitle>
      This is a warning notification message that requires attention.
      <a slot="action" href="#">Learn more</a>
    </PggmNotification>

    <PggmNotification Open=true Type="@PggmNotification.NotificationTypes.Error">
      <PggmNotificationTitle>This is an Error Notification</PggmNotificationTitle>
      This is an error notification message indicating something went wrong.
      <a slot="action" href="#">Learn more</a>
    </PggmNotification>

    <PggmNotification Open=true Type="@PggmNotification.NotificationTypes.Success">
      <PggmNotificationTitle>This is a Success Notification</PggmNotificationTitle>
      This is a success notification message confirming a successful action.
      <a slot="action" href="#">Learn more</a>
    </PggmNotification>
  </div>
</DemoSection>


<DemoSection Title="Closable Notification" Code="@closableNotificationSource" CodeBehind="@closableNotificationBehind">
  <PggmNotification Type="@PggmNotification.NotificationTypes.Informative" Closeable="true" CloseLabel="Close this notification" Open="true" OnDismiss="HandleNotificationDismiss">
    <PggmNotificationTitle>Closable Notification</PggmNotificationTitle>
    This notification can be closed by clicking the close button.
    <a slot="action" href="#">Learn more</a>
  </PggmNotification>

  @if (notificationDismissed)
  {
    <p class="text-muted">Notification was dismissed at @dismissTime</p>
  }

</DemoSection>

<PggmHeading Level="2">API</PggmHeading>
<PggmHeading Level="3">PggmNotification</PggmHeading>
<ApiDocumentation Properties="_properties" />

<style>
  .notification-examples {
    display: flex;
    flex-direction: column;
    gap: 2em;
  }
</style>

@code {
  private bool notificationDismissed = false;
  private string dismissTime = "";

  private async Task HandleNotificationDismiss()
  {
    notificationDismissed = true;
    dismissTime = DateTime.Now.ToString("HH:mm:ss");
    StateHasChanged();

    // Reset after 3 seconds
    await Task.Delay(3000);
    notificationDismissed = false;
    StateHasChanged();
  }
  
  // Code snippets for demo sections
  private string notificationTypesSource = Pggm.Components.Sample.Utilities.SnippetBuilder.Build(
    "<div class=\"notification-examples\">",
    "  <PggmNotification Open=true Type=\"@PggmNotification.NotificationTypes.Informative\">",
    "    <PggmNotificationTitle>This is an Informative Notification</PggmNotificationTitle>",
    "    This is an informative notification message with useful information for the user.",
    "    <a slot=\"action\" href=\"#\">Learn more</a>",
    "  </PggmNotification>",
    "  <PggmNotification Open=true Type=\"@PggmNotification.NotificationTypes.Warning\">",
    "    <PggmNotificationTitle>This is a Warning Notification</PggmNotificationTitle>",
    "    This is a warning notification message that requires attention.",
    "    <a slot=\"action\" href=\"#\">Learn more</a>",
    "  </PggmNotification>",
    "  <PggmNotification Open=true Type=\"@PggmNotification.NotificationTypes.Error\">",
    "    <PggmNotificationTitle>This is an Error Notification</PggmNotificationTitle>",
    "    This is an error notification message indicating something went wrong.",
    "    <a slot=\"action\" href=\"#\">Learn more</a>",
    "  </PggmNotification>",
    "  <PggmNotification Open=true Type=\"@PggmNotification.NotificationTypes.Success\">",
    "    <PggmNotificationTitle>This is a Success Notification</PggmNotificationTitle>",
    "    This is a success notification message confirming a successful action.",
    "    <a slot=\"action\" href=\"#\">Learn more</a>",
    "  </PggmNotification>",
    "</div>");

  private string notificationTypesBehind = "// Example of different notification types: Informative, Warning, Error, Success";

  private string closableNotificationSource = Pggm.Components.Sample.Utilities.SnippetBuilder.Build(
    "<PggmNotification Type=\"@PggmNotification.NotificationTypes.Informative\" Closeable=\"true\" CloseLabel=\"Close this notification\" Open=\"true\" OnDismiss=\"HandleNotificationDismiss\">",
    "  <PggmNotificationTitle>Closable Notification</PggmNotificationTitle>",
    "  This notification can be closed by clicking the close button.",
    "  <a slot=\"action\" href=\"#\">Learn more</a>",
    "</PggmNotification>");

  private string closableNotificationBehind = "// Notification with a close action and OnDismiss handler";

}

@code {
  // API table for docs
  private IEnumerable<ApiMember> _properties = new[]
  {
    new ApiMember { Name = "Type", Type = "string", DefaultValue = "\"informative\"", Description = "The notification type (informative, warning, error, success). Use NotificationTypes constants." },
    new ApiMember { Name = "Closeable", Type = "bool", DefaultValue = "false", Description = "Whether the notification shows a close button." },
    new ApiMember { Name = "CloseLabel", Type = "string", DefaultValue = "\"\"", Description = "Accessible label for the close button." },
    new ApiMember { Name = "Open", Type = "bool", DefaultValue = "true", Description = "Whether the notification is visible/open." },
    new ApiMember { Name = "OnDismiss", Type = "EventCallback", DefaultValue = "null", Description = "Callback invoked when the notification is dismissed (close action)." },
    new ApiMember { Name = "NotificationTypes", Type = "class", DefaultValue = "-", Description = "Static constants: Informative, Warning, Error, Success." },
  };
}
