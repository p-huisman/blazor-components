@page "/pggm-select"
@using System.ComponentModel.DataAnnotations
@using Pggm.Components.Sample.Components.ApiDocumentation

<PageTitle>PGGM Select</PageTitle>

<PggmHeading Level="1">PGGM Select</PggmHeading>

<p>This page demonstrates the PGGM Select component with various configurations and event handling.</p>

<DemoSection Title="Basic Select" Code="@_basicSource" CodeBehind="@_basicBehind">
    <Content>
        <p>Selected Country: <strong>@_selectedCountry</strong></p>
        <PggmSelect TOption="string" Value="@_selectedCountry" ValueChanged="@(v => _selectedCountry = v)">
            <option value="">Choose a country...</option>
            <option value="nl">Netherlands</option>
            <option value="de">Germany</option>
            <option value="be">Belgium</option>
            <option value="fr">France</option>
            <option value="uk">United Kingdom</option>
        </PggmSelect>
    </Content>
</DemoSection>

<DemoSection Title="Placeholder" Code="@_placeholderSource" CodeBehind="@_placeholderBehind">
    <Content>
        <p>
            The <code>Placeholder</code> parameter renders a disabled hidden first option, giving a clear call-to-action
            without requiring a manual empty <code>&lt;option&gt;</code> in the child content.
        </p>
        <p>Selected: <strong>@(_selectedPlaceholder ?? "—")</strong></p>
        <PggmSelect TOption="string" Placeholder="Choose a language..." @bind-Value="_selectedPlaceholder">
            <option value="cs">C#</option>
            <option value="ts">TypeScript</option>
            <option value="py">Python</option>
        </PggmSelect>
    </Content>
</DemoSection>

<DemoSection Title="Required Select" Code="@_requiredSource" CodeBehind="@_requiredBehind">
    <Content>
        <p>Selected Department: <strong>@_selectedDepartment</strong></p>
        <PggmSelect TOption="string" Name="department" Required="true" Placeholder="Select department..." @bind-Value="_selectedDepartment">
            <option value="hr">Human Resources</option>
            <option value="it">Information Technology</option>
            <option value="finance">Finance</option>
            <option value="marketing">Marketing</option>
            <option value="sales">Sales</option>
        </PggmSelect>
    </Content>
</DemoSection>

<DemoSection Title="Disabled and ReadOnly" Code="@_stateSource" CodeBehind="@_stateBehind">
    <Content>
        <p><strong>Disabled</strong> — cannot be interacted with and is excluded from form submission:</p>
        <PggmSelect TOption="string" Disabled="true" Value="disabled-option">
            <option value="disabled-option">Pre-selected (disabled)</option>
            <option value="other">Other (not selectable)</option>
        </PggmSelect>
        <br />
        <p><strong>ReadOnly</strong> — visually restricted but still included in form submission:</p>
        <PggmSelect TOption="string" ReadOnly="true" Value="readonly-option">
            <option value="readonly-option">Pre-selected (read-only)</option>
            <option value="other">Other</option>
        </PggmSelect>
    </Content>
</DemoSection>

<DemoSection Title="Grouped Options" Code="@_groupedSource" CodeBehind="@_groupedBehind">
    <Content>
        <p>Selected Technology: <strong>@_selectedTechnology</strong></p>
        <PggmSelect TOption="string" Placeholder="Choose a technology..." @bind-Value="_selectedTechnology">
            <optgroup label="Frontend">
                <option value="html">HTML</option>
                <option value="css">CSS</option>
                <option value="ts">TypeScript</option>
            </optgroup>
            <optgroup label="Backend">
                <option value="cs">C#</option>
                <option value="nodejs">Node.js</option>
                <option value="py">Python</option>
            </optgroup>
            <optgroup label="Frameworks">
                <option value="blazor">Blazor</option>
                <option value="react">React</option>
                <option value="angular">Angular</option>
            </optgroup>
        </PggmSelect>
    </Content>
</DemoSection>

<DemoSection Title="Items API" Code="@_itemsSource" CodeBehind="@_itemsBehind">
    <Content>
        <p>
            Use <code>Items</code> with <code>OptionValue</code>, <code>OptionText</code>, <code>OptionDisabled</code>
            and <code>OptionTitle</code> to render options from a data collection.
            Use <code>@@bind-SelectedOption</code> to get the selected item object back.
        </p>
        <p>Selected: <strong>@(_selectedEmployee?.Name ?? "—")</strong> (id: <strong>@(_selectedEmployee?.Id.ToString() ?? "—")</strong>)</p>
        <PggmSelect TOption="EmployeeOption"
                    Items="@_employees"
                    OptionValue="@(e => e.Id.ToString())"
                    OptionText="@(e => e.Name)"
                    OptionDisabled="@(e => e.Inactive)"
                    OptionTitle='@(e => e.Inactive ? "This employee is inactive" : e.Name)'
                    Placeholder="Select an employee..."
                    @bind-SelectedOption="_selectedEmployee" />
    </Content>
</DemoSection>

<DemoSection Title="OptionSelected — Default Selection" Code="@_optionSelectedSource" CodeBehind="@_optionSelectedBehind">
    <Content>
        <p>
            Use <code>OptionSelected</code> to pre-select an item by predicate without providing an initial
            <code>Value</code> or <code>SelectedOption</code>. The first matching item is seeded as the initial value.
        </p>
        <p>Selected: <strong>@(_selectedRole?.Name ?? "—")</strong></p>
        <PggmSelect TOption="RoleOption"
                    Items="@_roles"
                    OptionValue="@(r => r.Id)"
                    OptionText="@(r => r.Name)"
                    OptionSelected="@(r => r.IsDefault)"
                    @bind-SelectedOption="_selectedRole" />
    </Content>
</DemoSection>

<DemoSection Title="Multiple Selection" Code="@_multipleSource" CodeBehind="@_multipleBehind">
    <Content>
        <p>
            Use <code>Multiple="true"</code> with child content. Hold <kbd>Ctrl</kbd> / <kbd>Cmd</kbd> to select multiple options.
            Read the selected values from <code>ChangeEventArgs.Value</code> as <code>string[]</code> via <code>OnChange</code>.
        </p>
        <p>Selected: <strong>@(string.Join(", ", _selectedSkills))</strong></p>
        <PggmSelect TOption="string" Multiple="true" OnChange="@HandleSkillsChange">
            <option value="cs">C#</option>
            <option value="ts">TypeScript</option>
            <option value="blazor">Blazor</option>
            <option value="sql">SQL</option>
            <option value="azure">Azure</option>
        </PggmSelect>
    </Content>
</DemoSection>

<DemoSection Title="Multiple Selection with Items API" Code="@_multipleItemsSource" CodeBehind="@_multipleItemsBehind">
    <Content>
        <p>
            Use <code>Multiple="true"</code> with <code>Items</code> and <code>@@bind-SelectedOptions</code>
            to get the collection of selected item objects. Combine with <code>OptionSelected</code> to set an initial selection.
        </p>
        <p>Selected: <strong>@(string.Join(", ", _selectedEmployees?.Select(e => e.Name) ?? Enumerable.Empty<string>()))</strong></p>
        <PggmSelect TOption="EmployeeOption"
                    Multiple="true"
                    Items="@_employees"
                    OptionValue="@(e => e.Id.ToString())"
                    OptionText="@(e => e.Name)"
                    OptionDisabled="@(e => e.Inactive)"
                    OptionSelected="@(e => e.Id == 1 || e.Id == 3)"
                    @bind-SelectedOptions="_selectedEmployees" />
    </Content>
</DemoSection>

<DemoSection Title="Width, Height and AriaLabel" Code="@_appearanceSource" CodeBehind="@_appearanceBehind">
    <Content>
        <p>
            <code>Width</code> sets the <code>min-width</code> inline style, <code>Height</code> sets <code>height</code>.
            <code>AriaLabel</code> adds an <code>aria-label</code> attribute for screen readers when no visible label is present.
        </p>
        <PggmSelect TOption="string" Width="300px" AriaLabel="Country selector" Placeholder="Choose a country...">
            <option value="nl">Netherlands</option>
            <option value="de">Germany</option>
            <option value="be">Belgium</option>
        </PggmSelect>
        <br />
        <PggmSelect TOption="string" Width="300px" Height="8rem" Multiple="true" AriaLabel="Multi-country selector">
            <option value="nl">Netherlands</option>
            <option value="de">Germany</option>
            <option value="be">Belgium</option>
            <option value="fr">France</option>
            <option value="uk">United Kingdom</option>
        </PggmSelect>
    </Content>
</DemoSection>

<DemoSection Title="Event Handling" Code="@_eventSource" CodeBehind="@_eventBehind">
    <Content>
        <p>Last Event: <strong>@_lastEvent</strong></p>
        <PggmSelect TOption="string" Value="@_eventTestValue"
                    ValueChanged="@HandleValueChange"
                    OnFocus="@HandleFocus"
                    OnBlur="@HandleBlur">
            <option value="">Select an option...</option>
            <option value="option1">Option 1</option>
            <option value="option2">Option 2</option>
            <option value="option3">Option 3</option>
        </PggmSelect>
    </Content>
</DemoSection>

<DemoSection Title="Event Handling with Items API" Code="@_eventItemsSource" CodeBehind="@_eventItemsBehind">
    <Content>
        <p>
            When <code>Items</code> is set, use <code>SelectedOptionChanged</code> to receive the selected
            <strong>object</strong> directly instead of a raw string value.
            <code>OnChange</code> provides both <code>e.Value</code> (string) and <code>e.Item</code> (object) in one callback.
        </p>
        <p>Last event: <strong>@_itemsLastEvent</strong></p>
        <PggmSelect TOption="EmployeeOption"
                    Items="@_employees"
                    OptionValue="@(e => e.Id.ToString())"
                    OptionText="@(e => e.Name)"
                    OptionDisabled="@(e => e.Inactive)"
                    Placeholder="Select an employee..."
                    SelectedOptionChanged="@HandleEmployeeChanged"
                    OnFocus="@HandleEventItemsFocus"
                    OnBlur="@HandleEventItemsBlur" />
    </Content>
</DemoSection>

<DemoSection Title="EditForm — Value Binding &amp; Validation" Code="@_editFormSource" CodeBehind="@_editFormBehind">
    <Content>
        <p>Demonstrates <code>@@bind-Value</code> inside an <code>EditForm</code>. The <code>ValueExpression</code> is set automatically and activates field-level validation.</p>
        <EditForm Model="_formModel" OnValidSubmit="HandleFormSubmit">
            <DataAnnotationsValidator />
            <PggmValidationSummary>
                <p class="text-danger">Please fix the following errors:</p>
            </PggmValidationSummary>
            <PggmFieldset>
                <PggmLabel slot="label" For="form-country">Land</PggmLabel>
                <PggmValidationMessage slot="error" For="() => _formModel.Country" />
                <PggmSelect TOption="string" @bind-Value="_formModel.Country" Name="form-country" Required="true" Placeholder="Kies een land...">
                    <option value="nl">Nederland</option>
                    <option value="de">Duitsland</option>
                    <option value="be">België</option>
                    <option value="fr">Frankrijk</option>
                    <option value="uk">Verenigd Koninkrijk</option>
                </PggmSelect>
            </PggmFieldset>
            <PggmFieldset>
                <PggmLabel slot="label" For="form-department">Afdeling</PggmLabel>
                <PggmValidationMessage slot="error" For="() => _formModel.Department" />
                <PggmSelect TOption="string" @bind-Value="_formModel.Department" Name="form-department" Required="true" Placeholder="Kies een afdeling...">
                    <option value="hr">Human Resources</option>
                    <option value="it">Informatietechnologie</option>
                    <option value="finance">Financiën</option>
                    <option value="marketing">Marketing</option>
                    <option value="sales">Sales</option>
                </PggmSelect>
            </PggmFieldset>
            <PggmButton Type="@ButtonType.Submit" Appearance="@ButtonAppearance.Primary">Verzenden</PggmButton>
        </EditForm>
        @if (_formSubmitted)
        {
            <div class="alert alert-success mt-2">
                Formulier verzonden! Land: <strong>@_formModel.Country</strong>, Afdeling: <strong>@_formModel.Department</strong>
            </div>
        }
    </Content>
</DemoSection>

<DemoSection Title="EditForm — SelectedOption Validation" Code="@_editFormOptionSource" CodeBehind="@_editFormOptionBehind">
    <Content>
        <p>
            Demonstrates validation on an object-typed selection. <code>@@bind-SelectedOption</code> provides the
            <code>SelectedOptionExpression</code> that drives field-level validation inside an <code>EditForm</code>.
        </p>
        <EditForm Model="_optionFormModel" OnValidSubmit="HandleOptionFormSubmit">
            <DataAnnotationsValidator />
            <PggmFieldset>
                <PggmLabel slot="label" For="form-employee">Medewerker</PggmLabel>
                <PggmValidationMessage slot="error" For="() => _optionFormModel.SelectedEmployee" />
                <PggmSelect TOption="EmployeeOption"
                            Items="@_employees"
                            OptionValue="@(e => e.Id.ToString())"
                            OptionText="@(e => e.Name)"
                            OptionDisabled="@(e => e.Inactive)"
                            Placeholder="Kies een medewerker..."
                            @bind-SelectedOption="_optionFormModel.SelectedEmployee" />
            </PggmFieldset>
            <PggmButton Type="@ButtonType.Submit" Appearance="@ButtonAppearance.Primary">Verzenden</PggmButton>
        </EditForm>
        @if (_optionFormSubmitted)
        {
            <div class="alert alert-success mt-2">
                Medewerker geselecteerd: <strong>@_optionFormModel.SelectedEmployee?.Name</strong>
            </div>
        }
    </Content>
</DemoSection>

<DemoSection Title="EditForm — SelectedOptions Validation" Code="@_editFormOptionsSource" CodeBehind="@_editFormOptionsBehind">
    <Content>
        <p>
            Demonstrates multi-select validation. <code>@@bind-SelectedOptions</code> provides the
            <code>SelectedOptionsExpression</code> that drives field-level validation inside an <code>EditForm</code>.
        </p>
        <EditForm Model="_optionsFormModel" OnValidSubmit="HandleOptionsFormSubmit">
            <DataAnnotationsValidator />
            <PggmFieldset>
                <PggmLabel slot="label" For="form-employees">Medewerkers</PggmLabel>
                <PggmValidationMessage slot="error" For="() => _optionsFormModel.SelectedEmployees" />
                <PggmSelect TOption="EmployeeOption"
                            Multiple="true"
                            Items="@_employees"
                            OptionValue="@(e => e.Id.ToString())"
                            OptionText="@(e => e.Name)"
                            OptionDisabled="@(e => e.Inactive)"
                            @bind-SelectedOptions="_optionsFormModel.SelectedEmployees" />
            </PggmFieldset>
            <PggmButton Type="@ButtonType.Submit" Appearance="@ButtonAppearance.Primary">Verzenden</PggmButton>
        </EditForm>
        @if (_optionsFormSubmitted)
        {
            <div class="alert alert-success mt-2">
                Geselecteerd: <strong>@(string.Join(", ", _optionsFormModel.SelectedEmployees?.Select(e => e.Name) ?? Enumerable.Empty<string>()))</strong>
            </div>
        }
    </Content>
</DemoSection>

<PggmHeading Level="2">API</PggmHeading>
<PggmHeading Level="3">PggmSelect</PggmHeading>
<ApiDocumentation Properties="_properties" />

@code {
    // ── Basic Select ──────────────────────────────────────────────────────────
    private string? _selectedCountry = "nl";

    // ── Placeholder ───────────────────────────────────────────────────────────
    private string? _selectedPlaceholder;

    // ── Required ──────────────────────────────────────────────────────────────
    private string? _selectedDepartment;

    // ── Grouped Options ───────────────────────────────────────────────────────
    private string? _selectedTechnology;

    // ── Items API ─────────────────────────────────────────────────────────────
    public record EmployeeOption(int Id, string Name, bool Inactive = false);

    private EmployeeOption? _selectedEmployee;

    private readonly IEnumerable<EmployeeOption> _employees = new[]
    {
        new EmployeeOption(1, "Alice de Vries"),
        new EmployeeOption(2, "Bob Jansen"),
        new EmployeeOption(3, "Carol Bakker"),
        new EmployeeOption(4, "Dave Smit (inactive)", Inactive: true),
        new EmployeeOption(5, "Eva Visser"),
    };

    // ── OptionSelected ────────────────────────────────────────────────────────
    public record RoleOption(string Id, string Name, bool IsDefault = false);

    private RoleOption? _selectedRole;

    private readonly IEnumerable<RoleOption> _roles = new[]
    {
        new RoleOption("admin", "Administrator"),
        new RoleOption("editor", "Editor", IsDefault: true),
        new RoleOption("viewer", "Viewer"),
        new RoleOption("guest", "Guest"),
    };

    // ── Multiple (ChildContent) ───────────────────────────────────────────────
    private string[] _selectedSkills = Array.Empty<string>();

    private void HandleSkillsChange(PggmSelectChangeEventArgs<string> args)
    {
        _selectedSkills = args.Values;
    }

    // ── Multiple (Items API) ──────────────────────────────────────────────────
    private IEnumerable<EmployeeOption>? _selectedEmployees;

    // ── Event Handling ────────────────────────────────────────────────────────
    private string? _eventTestValue;
    private string _lastEvent = "None";

    // ── Event Handling with Items API ─────────────────────────────────────────
    private string _itemsLastEvent = "None";

    private void HandleEmployeeChanged(EmployeeOption? employee)
    {
        _itemsLastEvent = employee is null
            ? $"Selection cleared at {DateTime.Now:HH:mm:ss}"
            : $"Selected: {employee.Name} (id {employee.Id}) at {DateTime.Now:HH:mm:ss}";
    }

    private void HandleEventItemsFocus(FocusEventArgs args)
    {
        _itemsLastEvent = $"Select focused at {DateTime.Now:HH:mm:ss}";
    }

    private void HandleEventItemsBlur(FocusEventArgs args)
    {
        _itemsLastEvent = $"Select blurred at {DateTime.Now:HH:mm:ss}";
    }

    private void HandleValueChange(string? value)
    {
        _eventTestValue = value;
        _lastEvent = $"Value changed to: {value ?? "null"} at {DateTime.Now:HH:mm:ss}";
    }

    private void HandleFocus(FocusEventArgs args)
    {
        _lastEvent = $"Select focused at {DateTime.Now:HH:mm:ss}";
    }

    private void HandleBlur(FocusEventArgs args)
    {
        _lastEvent = $"Select blurred at {DateTime.Now:HH:mm:ss}";
    }

    // ── EditForm @bind-Value ──────────────────────────────────────────────────
    private SelectFormModel _formModel = new();
    private bool _formSubmitted;

    private void HandleFormSubmit()
    {
        _formSubmitted = true;
    }

    public class SelectFormModel
    {
        [Required(ErrorMessage = "Selecteer een land.")]
        public string? Country { get; set; }

        [Required(ErrorMessage = "Selecteer een afdeling.")]
        public string? Department { get; set; }
    }

    // ── EditForm @bind-SelectedOption ─────────────────────────────────────────
    private OptionFormModel _optionFormModel = new();
    private bool _optionFormSubmitted;

    private void HandleOptionFormSubmit()
    {
        _optionFormSubmitted = true;
    }

    public class OptionFormModel
    {
        [Required(ErrorMessage = "Selecteer een medewerker.")]
        public EmployeeOption? SelectedEmployee { get; set; }
    }

    // ── EditForm @bind-SelectedOptions ────────────────────────────────────────
    private OptionsFormModel _optionsFormModel = new();
    private bool _optionsFormSubmitted;

    private void HandleOptionsFormSubmit()
    {
        _optionsFormSubmitted = true;
    }

    public class OptionsFormModel
    {
        [Required(ErrorMessage = "Selecteer minimaal één medewerker.")]
        public IEnumerable<EmployeeOption>? SelectedEmployees { get; set; }
    }

