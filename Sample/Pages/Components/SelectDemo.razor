@page "/pggm-select"
@using System.ComponentModel.DataAnnotations
@using Pggm.Components.Sample.Components.ApiDocumentation

<PageTitle>PGGM Select</PageTitle>

<PggmHeading Level="1">PGGM Select</PggmHeading>

<p>This page demonstrates the PGGM Select component with various configurations and event handling.</p>

<DemoSection Title="Basic Select" Code="@_basicSource" CodeBehind="@_basicBehind">
    <Content>
        <p>Selected Country: <strong>@selectedCountry</strong></p>
        
        <PggmSelect TOption="string" Value="@selectedCountry" ValueChanged="@(value => selectedCountry = value)">
            <option value="">Choose a country...</option>
            <option value="nl">Netherlands</option>
            <option value="de">Germany</option>
            <option value="be">Belgium</option>
            <option value="fr">France</option>
            <option value="uk">United Kingdom</option>
        </PggmSelect>
    </Content>
</DemoSection>

<DemoSection Title="Required Select with Name" Code="@_requiredSource" CodeBehind="@_requiredBehind">
    <Content>
        <p>Selected Department: <strong>@selectedDepartment</strong></p>
        
        <PggmSelect TOption="string" Name="department" Required="true" Value="@selectedDepartment" ValueChanged="@(value => selectedDepartment = value)">
            <option value="">Select department...</option>
            <option value="hr">Human Resources</option>
            <option value="it">Information Technology</option>
            <option value="finance">Finance</option>
            <option value="marketing">Marketing</option>
            <option value="sales">Sales</option>
        </PggmSelect>
    </Content>
</DemoSection>

<DemoSection Title="Disabled Select" Code="@_disabledSource" CodeBehind="@_disabledBehind">
    <Content>
        <p>This select is disabled and cannot be changed.</p>
        
        <PggmSelect TOption="string" Disabled="true" Value="disabled-option">
            <option value="disabled-option">This option is pre-selected</option>
            <option value="other">Other option (not selectable)</option>
        </PggmSelect>
    </Content>
</DemoSection>

<DemoSection Title="Select with Grouped Options" Code="@_groupedSource" CodeBehind="@_groupedBehind">
    <Content>
        <p>Selected Technology: <strong>@selectedTechnology</strong></p>
        
        <PggmSelect TOption="string" Value="@selectedTechnology" ValueChanged="@(value => selectedTechnology = value)">
            <option value="">Choose a technology...</option>
            <optgroup label="Frontend">
                <option value="html">HTML</option>
                <option value="css">CSS</option>
                <option value="javascript-fe">JavaScript</option>
                <option value="typescript">TypeScript</option>
            </optgroup>
            <optgroup label="Backend">
                <option value="csharp-be">C#</option>
                <option value="nodejs">Node.js</option>
                <option value="python-be">Python</option>
                <option value="java-be">Java</option>
            </optgroup>
            <optgroup label="Frameworks">
                <option value="blazor-fw">Blazor</option>
                <option value="react-fw">React</option>
                <option value="angular-fw">Angular</option>
                <option value="vue-fw">Vue.js</option>
            </optgroup>
        </PggmSelect>
    </Content>
</DemoSection>

<DemoSection Title="Data Binding with Items API" Code="@_itemsSource" CodeBehind="@_itemsBehind">
    <Content>
        <p>Selected: <strong>@(_selectedEmployee?.Name ?? "—")</strong> (id: <strong>@(_selectedEmployee?.Id.ToString() ?? "—")</strong>)</p>

        <PggmSelect TOption="EmployeeOption"
                    Items="@_employees"
                    OptionValue="@(e => e.Id.ToString())"
                    OptionText="@(e => e.Name)"
                    OptionDisabled="@(e => e.Inactive)"
                    Value="@(_selectedEmployee?.Id.ToString())"
                    @bind-SelectedOption="_selectedEmployee" />
    </Content>
</DemoSection>

<DemoSection Title="Event Handling" Code="@_eventSource" CodeBehind="@_eventBehind">
    <Content>
        <p>Last Event: <strong>@lastEvent</strong></p>
        
        <PggmSelect TOption="string" Value="@eventTestValue" 
                    ValueChanged="@HandleValueChange"
                    OnFocus="@HandleFocus"
                    OnBlur="@HandleBlur">
            <option value="">Select an option...</option>
            <option value="option1">Option 1</option>
            <option value="option2">Option 2</option>
            <option value="option3">Option 3</option>
        </PggmSelect>
    </Content>
</DemoSection>

<DemoSection Title="EditForm Two-Way Binding &amp; Validation" Code="@_editFormSource" CodeBehind="@_editFormBehind">
    <Content>
        <p>Demonstrates <code>@@bind-Value</code> inside an <code>EditForm</code> with <code>DataAnnotationsValidator</code> and <code>PggmValidationMessage</code>.</p>

        <EditForm Model="_formModel" OnValidSubmit="HandleFormSubmit">
            <DataAnnotationsValidator />
            <PggmValidationSummary>
                <p class="text-danger">Please fix the following errors:</p>
            </PggmValidationSummary>
            <PggmFieldset>
                <PggmLabel slot="label" For="form-country">Land</PggmLabel>
                <PggmValidationMessage slot="error" For="() => _formModel.Country" />
                <PggmSelect TOption="string" @bind-Value="_formModel.Country" Name="form-country" Required="true">
                    <option value="">Kies een land...</option>
                    <option value="nl">Nederland</option>
                    <option value="de">Duitsland</option>
                    <option value="be">België</option>
                    <option value="fr">Frankrijk</option>
                    <option value="uk">Verenigd Koninkrijk</option>
                </PggmSelect>
            </PggmFieldset>

            <PggmFieldset>
                <PggmLabel slot="label" For="form-department">Afdeling</PggmLabel>
                <PggmValidationMessage slot="error" For="() => _formModel.Department" />
                <PggmSelect TOption="string" @bind-Value="_formModel.Department" Name="form-department" Required="true">
                    <option value="">Kies een afdeling...</option>
                    <option value="hr">Human Resources</option>
                    <option value="it">Informatietechnologie</option>
                    <option value="finance">Financiën</option>
                    <option value="marketing">Marketing</option>
                    <option value="sales">Sales</option>
                </PggmSelect>
            </PggmFieldset>

            <PggmButton Type="@ButtonType.Submit" Appearance="@ButtonAppearance.Primary">Verzenden</PggmButton>
        </EditForm>

        @if (_formSubmitted)
        {
            <div class="alert alert-success mt-2">
                Formulier verzonden! Land: <strong>@_formModel.Country</strong>, Afdeling: <strong>@_formModel.Department</strong>
            </div>
        }
    </Content>
</DemoSection>

<PggmHeading Level="2">API</PggmHeading>
<PggmHeading Level="3">PggmSelect</PggmHeading>
<ApiDocumentation Properties="_properties" />

@code {
