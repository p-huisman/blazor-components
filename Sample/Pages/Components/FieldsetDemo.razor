
@page "/pggm-fieldset"

<PageTitle>PGGM Fieldset</PageTitle>

<PggmHeading Level="1">PGGM Fieldset</PggmHeading>

<p>This page demonstrates the PGGM Fieldset component with various configurations.</p>

<DemoSection Title="Basic Fieldset with Label, Description and Error Messages" Code="@basicFieldsetSource" CodeBehind="@basicFieldsetBehind">
    <PggmFieldset>
        <PggmFieldsetLabel For="TextInput1">Naam</PggmFieldsetLabel>
        <PggmFieldsetDescription>
            <p>Vul uw naam in.</p>
        </PggmFieldsetDescription>
        <PggmFieldsetError>
            <PggmErrorMessage slot="error" For="TextInput1" Validity="valueMissing">
                Naam is een verplicht veld. Vul uw naam in.
            </PggmErrorMessage>
            <PggmErrorMessage slot="error" For="TextInput1" Validity="tooShort">
                De naam is te kort. De naam moet tenminste 2 tekens lang zijn. Vul uw naam in.
            </PggmErrorMessage>
        </PggmFieldsetError>
        <PggmInput Type="text" id="TextInput1" Required="true" MinLength="2" />
    </PggmFieldset>
</DemoSection>

<DemoSection Title="Simple Fieldset with Only Label" Code="@simpleFieldsetSource" CodeBehind="@simpleFieldsetBehind">
    <PggmFieldset>
        <PggmFieldsetLabel For="TextInput2">Email</PggmFieldsetLabel>
        <PggmInput Type="email" id="TextInput2" />
    </PggmFieldset>
</DemoSection>

<DemoSection Title="Fieldset with Description Only" Code="@descriptionFieldsetSource" CodeBehind="@descriptionFieldsetBehind">
    <PggmFieldset>
        <PggmFieldsetDescription>
            <p>Vul een geldig telefoonnummer in (optioneel).</p>
        </PggmFieldsetDescription>
        <PggmInput Type="tel" id="TextInput3" Placeholder="06-12345678" />
    </PggmFieldset>
</DemoSection>

@code {
    // You can add interactive demo logic here if needed
}

@code {
    private string basicFieldsetSource =
        "<PggmFieldset>\n  <PggmFieldsetLabel For='TextInput1'>Naam</PggmFieldsetLabel>\n  <PggmFieldsetDescription>\n    <p>Vul uw naam in.</p>\n  </PggmFieldsetDescription>\n  <PggmFieldsetError>\n    <PggmErrorMessage slot='error' For='TextInput1' Validity='valueMissing'>Naam is een verplicht veld. Vul uw naam in.</PggmErrorMessage>\n    <PggmErrorMessage slot='error' For='TextInput1' Validity='tooShort'>De naam is te kort. De naam moet tenminste 2 tekens lang zijn. Vul uw naam in.</PggmErrorMessage>\n  </PggmFieldsetError>\n  <PggmInput Type='text' id='TextInput1' Required='true' MinLength='2' />\n</PggmFieldset>";

    private string basicFieldsetBehind =
        "// Fieldset wraps label, description, errors and input elements";

    private string simpleFieldsetSource =
        "<PggmFieldset>\n  <PggmFieldsetLabel For='TextInput2'>Email</PggmFieldsetLabel>\n  <PggmInput Type='email' id='TextInput2' />\n</PggmFieldset>";

    private string simpleFieldsetBehind =
        "// Simple fieldset example";

    private string descriptionFieldsetSource =
        "<PggmFieldset>\n  <PggmFieldsetDescription>\n    <p>Vul een geldig telefoonnummer in (optioneel).</p>\n  </PggmFieldsetDescription>\n  <PggmInput Type='tel' id='TextInput3' Placeholder='06-12345678' />\n</PggmFieldset>";

    private string descriptionFieldsetBehind =
