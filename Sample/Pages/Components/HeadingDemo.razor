
@page "/pggm-heading"
@using Pggm.Components.Sample.Components.ApiDocumentation


<PageTitle>PGGM Heading Demo</PageTitle>

<PggmHeading Level="1">PGGM Heading</PggmHeading>

<p>This page demonstrates the PGGM Heading component with various levels and sizes.</p>

<DemoSection Title="Different Heading Levels" Code="@headingLevelsSource" CodeBehind="@headingLevelsBehind">
    <div class="demo-item">
        <PggmHeading Level="3">Level 1 (H1)</PggmHeading>
        <PggmHeading Level="1">This is a Level 1 Heading</PggmHeading>
    </div>
    
    <div class="demo-item">
        <PggmHeading Level="3">Level 2 (H2)</PggmHeading>
        <PggmHeading Level="2">This is a Level 2 Heading</PggmHeading>
    </div>
    
    <div class="demo-item">
        <PggmHeading Level="3">Level 3 (H3)</PggmHeading>
        <PggmHeading Level="3">This is a Level 3 Heading</PggmHeading>
    </div>
    
    <div class="demo-item">
        <PggmHeading Level="3">Level 4 (H4)</PggmHeading>
        <PggmHeading Level="4">This is a Level 4 Heading</PggmHeading>
    </div>
    
    <div class="demo-item">
        <PggmHeading Level="3">Level 5 (H5)</PggmHeading>
        <PggmHeading Level="5">This is a Level 5 Heading</PggmHeading>
    </div>
</DemoSection>

<DemoSection Title="Different Sizes" Code="@differentSizesSource" CodeBehind="@differentSizesBehind">
    <div class="demo-item">
        <PggmHeading Level="3">Size: 2xl</PggmHeading>
        <PggmHeading Level="1" Size="2xl">Extra Large Heading</PggmHeading>
    </div>
    
    <div class="demo-item">
        <PggmHeading Level="3">Size: xl</PggmHeading>
        <PggmHeading Level="2" Size="xl">Large Heading</PggmHeading>
    </div>
    
    <div class="demo-item">
        <PggmHeading Level="3">Size: lg</PggmHeading>
        <PggmHeading Level="3" Size="lg">Medium Large Heading</PggmHeading>
    </div>
    
    <div class="demo-item">
        <PggmHeading Level="3">Size: md</PggmHeading>
        <PggmHeading Level="4" Size="md">Medium Heading</PggmHeading>
    </div>
    
    <div class="demo-item">
        <PggmHeading Level="3">Size: sm</PggmHeading>
        <PggmHeading Level="5" Size="sm">Small Heading</PggmHeading>
    </div>
</DemoSection>

<DemoSection Title="Mixed Combinations" Code="@mixedCombinationsSource" CodeBehind="@mixedCombinationsBehind">
    <div class="demo-item">
        <PggmHeading Level="3">H1 with Small Size</PggmHeading>
        <PggmHeading Level="1" Size="sm">Large Heading Tag with Small Size</PggmHeading>
    </div>
    
    <div class="demo-item">
        <PggmHeading Level="3">H5 with Extra Large Size</PggmHeading>
        <PggmHeading Level="5" Size="2xl">Small Heading Tag with Extra Large Size</PggmHeading>
    </div>
    
    <div class="demo-item">
        <PggmHeading Level="3">Default (No Size Specified)</PggmHeading>
        <PggmHeading Level="2">Heading with Default Styling</PggmHeading>
    </div>
</DemoSection>



<PggmHeading Level="2">API</PggmHeading>
<PggmHeading Level="3">PggmHeading</PggmHeading>
<ApiDocumentation Properties="_properties" />

@code {
    private string headingLevelsSource =
        "<PggmHeading Level='1'>This is a Level 1 Heading</PggmHeading>\n" +
        "<PggmHeading Level='2'>This is a Level 2 Heading</PggmHeading>";

    private string headingLevelsBehind =
        "// Examples of different semantic heading levels";

    private string differentSizesSource =
        "<PggmHeading Level='1' Size='2xl'>Extra Large Heading</PggmHeading>\n" +
        "<PggmHeading Level='2' Size='xl'>Large Heading</PggmHeading>";

    private string differentSizesBehind =
        "// Examples of different visual sizes independent of heading level";

    private string mixedCombinationsSource =
        "<PggmHeading Level='1' Size='sm'>Large Heading Tag with Small Size</PggmHeading>\n" +
        "<PggmHeading Level='5' Size='2xl'>Small Heading Tag with Extra Large Size</PggmHeading>";

    private string mixedCombinationsBehind =
        "// Mixed combinations of semantic level and visual size";
    
    // API table for docs
    private IEnumerable<ApiMember> _properties = new[]
    {
        new ApiMember { Name = "Level", Type = "int", DefaultValue = "1", Description = "Semantic heading level (1-6)." },
        new ApiMember { Name = "Size", Type = "string?", DefaultValue = "null", Description = "Visual size token (e.g., 2xl, xl, lg, md, sm)." },
        new ApiMember { Name = "ChildContent", Type = "RenderFragment?", DefaultValue = "null", Description = "Content of the heading (text or markup)." },
        new ApiMember { Name = "CssClass", Type = "string?", DefaultValue = "null", Description = "Additional CSS classes applied to the heading element." },
        new ApiMember { Name = "AdditionalAttributes", Type = "Dictionary<string, object>?", DefaultValue = "null", Description = "Additional attributes splatted onto the underlying element." }
    };

}

<style>
   
    .demo-item {
        margin-bottom: 1.5rem;
        padding: 1rem;
        background-color: #f9f9f9;
        border-radius: 4px;
    }

    .demo-item:last-child {
        margin-bottom: 0;
    }
    
</style>
