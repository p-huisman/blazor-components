@page "/pggm-button"

@using Microsoft.AspNetCore.Components.Web
@using Pggm.Components.Constants
@using Pggm.Components.Sample.Components.ApiDocumentation

<PageTitle>PGGM Pggm Button</PageTitle>

    

<PggmHeading Level="1">PGGM Button</PggmHeading>

<p>This page demonstrates the PGGM Button component with various configurations and interactions.</p>

<DemoSection Title="Basic PGGM Button Variants" Code="@basicButtonSource" CodeBehind="@basicButtonBehind">
    <Description>
        <p>The PGGM design system includes several button appearances to suit different use cases. Below are examples of the primary, secondary, tertiary, and sign-in button styles.</p>
        <p>Different PGGM Button appearances available in the PGGM design system:</p>
    </Description>
    <Content>
        <PggmStack Orientation="Orientation.Horizontal" HorizontalGap="16" Wrap="true">
            <PggmButton Appearance="@ButtonAppearance.Primary" OnClick="@(() => HandlePggmButtonClick("Primary"))">
                Primary
            </PggmButton>
            <PggmButton Appearance="@ButtonAppearance.Secondary" OnClick="@(() => HandlePggmButtonClick("Secondary"))">
                Secondary
            </PggmButton>
            <PggmButton Appearance="@ButtonAppearance.Tertiary" OnClick="@(() => HandlePggmButtonClick("Tertiary"))">
                Tertiary
            </PggmButton>
            <PggmButton Appearance="@ButtonAppearance.SignIn" OnClick="@(() => HandlePggmButtonClick("Sign In"))">
                <PggmIcon Icon="user" Size="m" />Sign In
            </PggmButton>
        </PggmStack>
    </Content>
</DemoSection>

<DemoSection Title="PggmButton States" Code="@statesSource" CodeBehind="@statesBehind">
    <Description>
        <p>PggmButtons in different states:</p>
    </Description>

    <Content>
    <div class="PggmButton-group">
        <PggmButton Appearance="@ButtonAppearance.Primary" OnClick="@(() => HandlePggmButtonClick("Enabled"))">
            Enabled
        </PggmButton>
        <PggmButton Appearance="@ButtonAppearance.Primary" Disabled="true">
            Disabled
        </PggmButton>
        <PggmButton Appearance="@ButtonAppearance.Secondary" Disabled="true">
            Disabled Secondary
        </PggmButton>
    </div>
    </Content>
</DemoSection>

<DemoSection Title="PggmButton Types" Code="@typesSource" CodeBehind="@typesBehind">
    <Description>
        <p>Different PggmButton types for forms:</p>
    </Description>

    <Content>
    <div class="form-example">
        <div class="PggmButton-group">
            <PggmButton Type="@ButtonType.Button" Appearance="@ButtonAppearance.Primary" OnClick="@(() => HandlePggmButtonClick("Regular"))">
                Regular
            </PggmButton>
            <PggmButton Type="@ButtonType.Submit" Appearance="@ButtonAppearance.Primary" OnClick="@(() => HandlePggmButtonClick("Submit"))">
                Submit
            </PggmButton>
            <PggmButton Type="@ButtonType.Reset" Appearance="@ButtonAppearance.Secondary" OnClick="@(() => HandlePggmButtonClick("Reset"))">
                Reset
            </PggmButton>
        </div>
    </div>
    </Content>
</DemoSection>

<DemoSection Title="Interactive Examples" Code="@interactiveSource" CodeBehind="@interactiveBehind">
    <Description>
        <p>PggmButtons with various interactive behaviors:</p>
    </Description>

    <Content>
    <div class="interactive-section">
        <div class="counter-example">
            <PggmHeading Level="3">Counter Example</PggmHeading>
            <p>Current count: <strong>@counter</strong></p>
            <div class="PggmButton-group">
                <PggmButton Appearance="@ButtonAppearance.Primary" OnClick="IncrementCounter">
                    Increment (+1)
                </PggmButton>
                <PggmButton Appearance="@ButtonAppearance.Secondary" OnClick="DecrementCounter">
                    Decrement (-1)
                </PggmButton>
                <PggmButton Appearance="@ButtonAppearance.Tertiary" OnClick="ResetCounter">
                    Reset
                </PggmButton>
            </div>
        </div>

        <div class="toggle-example">
            <PggmHeading Level="3">Toggle Example</PggmHeading>
            <p>Toggle state: <strong>@(isToggled ? "ON" : "OFF")</strong></p>
            <PggmButton Appearance="@((isToggled ? ButtonAppearance.Primary : ButtonAppearance.Secondary))" OnClick="ToggleState">
                @(isToggled ? "Turn OFF" : "Turn ON")
            </PggmButton>
        </div>

        <div class="async-example">
            <PggmHeading Level="3">Async Operation Example</PggmHeading>
            <p>Simulate async operations with loading states:</p>
            <PggmButton Appearance="@ButtonAppearance.Primary" Disabled="@isLoading" OnClick="SimulateAsyncOperation">
                @(isLoading ? "Loading..." : "Start Async Operation")
            </PggmButton>
            @if (asyncMessage != null)
            {
                <div class="message @(asyncMessage.Contains("completed") ? "success" : "info")">
                    @asyncMessage
                </div>
            }
        </div>
    </div>
    </Content>
</DemoSection>

@if (!string.IsNullOrEmpty(lastClickedPggmButton))
{
    <div class="click-feedback">
        <strong>Last clicked:</strong> @lastClickedPggmButton at @lastClickTime.ToString("HH:mm:ss")
    </div>
}

<PggmHeading Level="2">API</PggmHeading>

<PggmHeading Level="3">PggmButton</PggmHeading>
<ApiDocumentation Properties="buttonProperties" Events="buttonEvents" />


@code {
    private string lastClickedPggmButton = string.Empty;
    private DateTime lastClickTime;
    private int counter = 0;
    private bool isToggled = false;
    private bool isLoading = false;
    private string? asyncMessage = null;

    private void HandlePggmButtonClick(string PggmButtonName)
    {
        lastClickedPggmButton = PggmButtonName;
        lastClickTime = DateTime.Now;
        StateHasChanged();
    }

    private void IncrementCounter()
    {
        counter++;
        HandlePggmButtonClick($"Increment (Counter: {counter})");
    }

    private void DecrementCounter()
    {
        counter--;
        HandlePggmButtonClick($"Decrement (Counter: {counter})");
    }

    private void ResetCounter()
    {
        counter = 0;
        HandlePggmButtonClick("Reset Counter");
    }

    private void ToggleState()
    {
        isToggled = !isToggled;
        HandlePggmButtonClick($"Toggle ({(isToggled ? "ON" : "OFF")})");
    }

    private async Task SimulateAsyncOperation()
    {
        isLoading = true;
        asyncMessage = "Operation started...";
        StateHasChanged();

        // Simulate async work
        await Task.Delay(2000);

        isLoading = false;
        asyncMessage = "Operation completed successfully!";
        HandlePggmButtonClick("Async Operation");
        StateHasChanged();

        // Clear message after 3 seconds
        await Task.Delay(3000);
        asyncMessage = null;
        StateHasChanged();
    }

    private string basicButtonSource =
        "<PggmStack Orientation='Orientation.Horizontal' HorizontalGap='16' Wrap='true'>\n" +
        "    <PggmButton Appearance='@ButtonAppearance.Primary'>Primary</PggmButton>\n" +
        "    <PggmButton Appearance='@ButtonAppearance.Secondary'>Secondary</PggmButton>\n" +
        "    <PggmButton Appearance='@ButtonAppearance.Tertiary'>Tertiary</PggmButton>\n" +
        "    <PggmButton Appearance='@ButtonAppearance.SignIn'><PggmIcon Icon='user' Size='m' />Sign In</PggmButton>\n" +
        "</PggmStack>";

    private string statesSource =
        "<div class='PggmButton-group'>\n" +
        "    <PggmButton Appearance='@ButtonAppearance.Primary'>Enabled</PggmButton>\n" +
        "    <PggmButton Appearance='@ButtonAppearance.Primary' Disabled='true'>Disabled</PggmButton>\n" +
        "    <PggmButton Appearance='@ButtonAppearance.Secondary' Disabled='true'>Disabled Secondary</PggmButton>\n" +
        "</div>";

    private string typesSource =
        "<div class='form-example'>\n" +
        "  <div class='PggmButton-group'>\n" +
        "    <PggmButton Type='@ButtonType.Button' Appearance='@ButtonAppearance.Primary'>Regular</PggmButton>\n" +
        "    <PggmButton Type='@ButtonType.Submit' Appearance='@ButtonAppearance.Primary'>Submit</PggmButton>\n" +
        "    <PggmButton Type='@ButtonType.Reset' Appearance='@ButtonAppearance.Secondary'>Reset</PggmButton>\n" +
        "  </div>\n" +
        "</div>";

    private string interactiveSource =
        "<div class='interactive-section'>\n" +
        "  <div class='counter-example'>\n" +
        "    <PggmHeading Level='3'>Counter Example</PggmHeading>\n" +
        "    <p>Current count: <strong>@counter</strong></p>\n" +
        "    <PggmButton Appearance='@ButtonAppearance.Primary' OnClick='IncrementCounter'>Increment (+1)</PggmButton>\n" +
        "  </div>\n" +
        "  <div class='toggle-example'>\n" +
        "    <PggmHeading Level='3'>Toggle Example</PggmHeading>\n" +
        "    <PggmButton Appearance='@ButtonAppearance.Primary' OnClick='ToggleState'>Toggle</PggmButton>\n" +
        "  </div>\n" +
        "</div>";

    private string basicButtonBehind =
        "@code {\n" +
        "    private string lastClickedPggmButton = string.Empty;\n" +
        "    private DateTime lastClickTime;\n" +
        "\n" +
        "    private void HandlePggmButtonClick(string PggmButtonName)\n" +
        "    {\n" +
        "        lastClickedPggmButton = PggmButtonName;\n" +
        "        lastClickTime = DateTime.Now;\n" +
        "        StateHasChanged();\n" +
        "    }\n" +
        "}";

    private string statesBehind =
        "@code {\n" +
        "    private string lastClickedPggmButton = string.Empty;\n" +
        "    private DateTime lastClickTime;\n" +
        "\n" +
        "    private void HandlePggmButtonClick(string PggmButtonName)\n" +
        "    {\n" +
        "        lastClickedPggmButton = PggmButtonName;\n" +
        "        lastClickTime = DateTime.Now;\n" +
        "        StateHasChanged();\n" +
        "    }\n" +
        "}";

    private string typesBehind =
        "@code {\n" +
        "    private string lastClickedPggmButton = string.Empty;\n" +
        "    private DateTime lastClickTime;\n" +
        "\n" +
        "    private void HandlePggmButtonClick(string PggmButtonName)\n" +
        "    {\n" +
        "        lastClickedPggmButton = PggmButtonName;\n" +
        "        lastClickTime = DateTime.Now;\n" +
        "        StateHasChanged();\n" +
        "    }\n" +
        "}";

    private string interactiveBehind =
        "@code {\n" +
        "    private string lastClickedPggmButton = string.Empty;\n" +
        "    private DateTime lastClickTime;\n" +
        "    private int counter = 0;\n" +
        "    private bool isToggled = false;\n" +
        "    private bool isLoading = false;\n" +
        "    private string? asyncMessage = null;\n" +
        "\n" +
        "    private void HandlePggmButtonClick(string PggmButtonName)\n" +
        "    {\n" +
        "        lastClickedPggmButton = PggmButtonName;\n" +
        "        lastClickTime = DateTime.Now;\n" +
        "        StateHasChanged();\n" +
        "    }\n" +
        "\n" +
        "    private void IncrementCounter()\n" +
        "    {\n" +
        "        counter++;\n" +
        "        HandlePggmButtonClick($\"Increment (Counter: {counter})\");\n" +
        "    }\n" +
        "\n" +
        "    private void DecrementCounter()\n" +
        "    {\n" +
        "        counter--;\n" +
        "        HandlePggmButtonClick($\"Decrement (Counter: {counter})\");\n" +
        "    }\n" +
        "\n" +
        "    private void ResetCounter()\n" +
        "    {\n" +
        "        counter = 0;\n" +
        "        HandlePggmButtonClick(\"Reset Counter\");\n" +
        "    }\n" +
        "\n" +
        "    private void ToggleState()\n" +
        "    {\n" +
        "        isToggled = !isToggled;\n" +
        "        HandlePggmButtonClick($\"Toggle ({(isToggled ? \"ON\" : \"OFF\")})\");\n" +
        "    }\n" +
        "\n" +
        "    private async Task SimulateAsyncOperation()\n" +
        "    {\n" +
        "        isLoading = true;\n" +
        "        asyncMessage = \"Operation started...\";\n" +
        "        StateHasChanged();\n" +
        "\n" +
        "        await Task.Delay(2000);\n" +
        "\n" +
        "        isLoading = false;\n" +
        "        asyncMessage = \"Operation completed successfully!\";\n" +
        "        HandlePggmButtonClick(\"Async Operation\");\n" +
        "        StateHasChanged();\n" +
        "\n" +
        "        await Task.Delay(3000);\n" +
        "        asyncMessage = null;\n" +
        "        StateHasChanged();\n" +
        "    }\n" +
        "}";

        private IEnumerable<ApiMember> buttonProperties = new[]
    {
        new ApiMember { Name = "Appearance", Type = "ButtonAppearance", DefaultValue = "ButtonAppearance.Primary", Description = "Type-safe enum specifying appearance: Primary (default), Secondary, Tertiary, SignIn." },
        new ApiMember { Name = "Disabled", Type = "bool", DefaultValue = "false", Description = "When true, disables interaction and click handling." },
        new ApiMember { Name = "Type", Type = "ButtonType", DefaultValue = "ButtonType.Button", Description = "Type-safe enum for HTML button type: Button (default), Submit, Reset." },
        new ApiMember { Name = "ChildContent", Type = "RenderFragment?", DefaultValue = "null", Description = "Content rendered inside the button (text, icons, etc.)." }
    };

    private IEnumerable<ApiMember> buttonEvents = new[]
    {
        new ApiMember { Name = "OnClick", Type = "EventCallback<MouseEventArgs>", Description = "Invoked when the button is clicked." }
    };
}

<style>
    /* demo-section styles are provided globally in wwwroot/css/custom-formatters.css */

    

    .interactive-section {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 2rem;
    }

    .counter-example,
    .toggle-example,
    .async-example {
        padding: 1.5rem;
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        background-color: #f9f9f9;
    }

    .counter-example h3,
    .toggle-example h3,
    .async-example h3 {
        margin-top: 0;
        color: #333;
    }

    .click-feedback {
        position: fixed;
        bottom: 20px;
        right: 20px;
        background-color: #007bff;
        color: white;
        padding: 0.75rem 1rem;
        border-radius: 4px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        z-index: 1000;
    }

    .message {
        margin-top: 0.5rem;
        padding: 0.5rem;
        border-radius: 4px;
    }

    .message.info {
        background-color: #d1ecf1;
        border: 1px solid #bee5eb;
        color: #0c5460;
    }

    .message.success {
        background-color: #d4edda;
        border: 1px solid #c3e6cb;
        color: #155724;
    }

    
    .form-example {
        background-color: #f8f9fa;
        padding: 1rem;
        border-radius: 4px;
        border: 1px solid #dee2e6;
    }

    @@media (max-width: 768px) {
       
        .interactive-section {
            grid-template-columns: 1fr;
        }

        .click-feedback {
            position: static;
            margin-top: 1rem;
        }
    }
</style>
