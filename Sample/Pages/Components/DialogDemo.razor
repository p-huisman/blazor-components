@page "/pggm-dialog"

@using Microsoft.AspNetCore.Components.Web
@using System.ComponentModel.DataAnnotations
@using Pggm.Components.Sample.Components.ApiDocumentation
@using Pggm.Components.Components.PggmDialog.Services

<PageTitle>PGGM Dialog</PageTitle>

<PggmHeading Level="1">PGGM Dialog</PggmHeading>

<p>This page demonstrates the PGGM Dialog component with various configurations and interactions.</p>

<DemoSection Title="Basic Dialog" Code="@basicDialogSource" CodeBehind="@basicDialogBehind">
    <Description>
        <p>A simple dialog with content:</p>
    </Description>

    <Content>
        <div class="demo-controls">
            <PggmButton Appearance="@ButtonAppearance.Primary" @onclick="OpenBasicDialog">
                Open Basic Dialog
            </PggmButton>
        </div>

        <PggmDialog @bind-Open="isBasicDialogOpen" HeaderContent="Basic Dialog" OnClose="OnBasicDialogClose">
            <p>This is a basic dialog with some simple content.</p>
            <p>You can close it by clicking the X button or pressing the Escape key.</p>
        </PggmDialog>

        <p><strong>Dialog State:</strong> @(isBasicDialogOpen ? "Open" : "Closed")</p>
    </Content>
</DemoSection>

<DemoSection Title="Modal Dialog" Code="@modalDialogSource" CodeBehind="@modalDialogBehind">
    <Description>
        <p>A modal dialog that blocks interaction with the background:</p>
    </Description>

    <Content>
        <div class="demo-controls">
            <PggmButton Appearance="@ButtonAppearance.Primary" @onclick="OpenModalDialog">
                Open Modal Dialog
            </PggmButton>
        </div>

        <PggmDialog @bind-Open="isModalDialogOpen" Modal="true" HeaderContent="Modal Dialog" CloseLabel="Close Modal">
            <div>
                <p><strong>This is a modal dialog.</strong></p>
                <p>It blocks interaction with the background content until closed.</p>
                <p>Try clicking outside the dialog or pressing Escape to close it.</p>
            </div>
        </PggmDialog>

        <p><strong>Modal State:</strong> @(isModalDialogOpen ? "Open" : "Closed")</p>
    </Content>
</DemoSection>

<DemoSection Title="Dialog with Custom Header Template" Code="@templateDialogSource" CodeBehind="@templateDialogBehind">
    <Description>
        <p>Dialog with a custom header using RenderFragment:</p>
    </Description>

    <Content>
        <div class="demo-controls">
            <PggmButton Appearance="@ButtonAppearance.Primary" @onclick="OpenTemplateDialog">
                Open Dialog with Template Header
            </PggmButton>
        </div>

        <PggmDialog @bind-Open="isTemplateDialogOpen" Modal="true">
            <HeaderTemplate>
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="color: #007acc;">ℹ️</span>
                    <strong>Custom Header with Icon</strong>
                </div>
            </HeaderTemplate>

            <ChildContent>
                <p>This dialog uses a custom header template with an icon and styled text.</p>
                <p>The header is defined using the HeaderTemplate parameter.</p>
            </ChildContent>
        </PggmDialog>

        <p><strong>Template Dialog State:</strong> @(isTemplateDialogOpen ? "Open" : "Closed")</p>
    </Content>
</DemoSection>

<DemoSection Title="Dialog with Action Buttons" Code="@actionDialogSource" CodeBehind="@actionDialogBehind">
    <Description>
        <p>Dialog with custom action buttons in the footer:</p>
    </Description>

    <Content>
        <div class="demo-controls">
            <PggmButton Appearance="@ButtonAppearance.Primary" @onclick="OpenActionDialog">
                Open Dialog with Actions
            </PggmButton>
        </div>

        <PggmDialog @bind-Open="isActionDialogOpen" Modal="true" HeaderContent="Confirm Action"
                    OnCancel="OnActionDialogCancel" Actions="@actionDialogActions">
            <ChildContent>
                <p>Are you sure you want to proceed with this action?</p>
                <p>This action cannot be undone.</p>
            </ChildContent>
        </PggmDialog>

        <p><strong>Action Dialog State:</strong> @(isActionDialogOpen ? "Open" : "Closed")</p>
        @if (!string.IsNullOrEmpty(actionResult))
        {
            <p><strong>Last Action:</strong> @actionResult</p>
        }
    </Content>
</DemoSection>

<DemoSection Title="Form Dialog" Code="@formDialogSource" CodeBehind="@formDialogBehind">
    <Description>
        <p>Dialog containing a form for user input:</p>
    </Description>

    <Content>
        <div class="demo-controls">
            <PggmButton Appearance="@ButtonAppearance.Primary" @onclick="OpenFormDialog">
                Open Form Dialog
            </PggmButton>
        </div>

        <PggmDialog @bind-Open="isFormDialogOpen" Modal="true" HeaderContent="User Information"
                    OnClose="OnFormDialogClose" Actions="@formDialogActions">
            <ChildContent>
                <EditForm Model="formModel" OnValidSubmit="SubmitForm">
                    <DataAnnotationsValidator />
                    <ValidationSummary />


                    <PggmFieldset>
                        <PggmFieldsetLabel For="name">Name</PggmFieldsetLabel>
                        <PggmFieldsetError>
                            <PggmErrorMessage slot="error" For="name"
                                              Validity="@PggmErrorMessage.ValidityStates.ValueMissing">
                                Name is required
                            </PggmErrorMessage>
                        </PggmFieldsetError>
                        <PggmInput Id="name" Name="name" Required="true" @bind-value="@formModel.Name" />
                    </PggmFieldset>

                    <PggmFieldset>
                        <PggmFieldsetLabel For="email">Email</PggmFieldsetLabel>
                        <PggmFieldsetError>
                            <PggmErrorMessage slot="error" For="email"
                                              Validity="@PggmErrorMessage.ValidityStates.ValueMissing">
                                Email is required
                            </PggmErrorMessage>
                            <PggmErrorMessage slot="error" For="email"
                                              Validity="@PggmErrorMessage.ValidityStates.TypeMismatch">
                                Please enter a valid email address
                            </PggmErrorMessage>
                        </PggmFieldsetError>
                        <PggmInput Id="email" Name="email" Type="@PggmInput.InputTypes.Email" Required="true"
                                   @bind-Value="@formModel.Email" />
                    </PggmFieldset>

                    <PggmFieldset>
                        <ChildContent>
                            <PggmCheckbox @bind-Value="formModel.Subscribe">
                                Subscribe to newsletter
                            </PggmCheckbox>
                        </ChildContent>
                    </PggmFieldset>
                </EditForm>
            </ChildContent>
        </PggmDialog>

        <p><strong>Form Dialog State:</strong> @(isFormDialogOpen ? "Open" : "Closed")</p>
        @if (!string.IsNullOrEmpty(formResult))
        {
            <p><strong>Form Result:</strong> @formResult</p>
        }
    </Content>
</DemoSection>

<DemoSection Title="Programmatic Control" Code="@programmaticSource" CodeBehind="@programmaticBehind">
    <Description>
        <p>Control dialogs programmatically using component methods:</p>
    </Description>

    <Content>
        <div class="demo-controls">
            <PggmButton Appearance="@ButtonAppearance.Primary" @onclick="OpenProgrammatically">
                Open Programmatically
            </PggmButton>
            <PggmButton Appearance="@ButtonAppearance.Secondary" @onclick="CloseProgrammatically">
                Close Programmatically
            </PggmButton>
        </div>

        <PggmDialog @ref="programmaticDialog" Modal="true" HeaderContent="Programmatic Control"
                    OnOpen="OnProgrammaticOpen"        OnClose="OnProgrammaticClose" Actions="@programmaticDialogActions">
            <ChildContent>
                <p>This dialog is controlled programmatically using the component's methods.</p>
                <p>Check the console or the status below to see when events are triggered.</p>
            </ChildContent>
        </PggmDialog>

        @if (programmaticEvents.Any())
        {
            <div class="event-log">
                <PggmHeading Level="4">Event Log:</PggmHeading>
                <ul>
                    @foreach (var evt in programmaticEvents.TakeLast(5))
                    {
                        <li>@evt</li>
                    }
                </ul>
            </div>
        }
    </Content>
</DemoSection>

<DemoSection Title="Service-based Dialog" Code="@serviceDialogSource" CodeBehind="@serviceDialogCodeBehind">
    <Description>
        <p>Open a dialog via the injected `IDialogService` — dialog is rendered by the global `DialogProvider`.</p>
        <p>Do not forget to add the global DialogProvider to your layout </p>
    </Description>
    <Content>
        <div class="demo-controls">
            <PggmButton Appearance="@ButtonAppearance.Primary" @onclick="OpenServiceDialog">Open Service Dialog</PggmButton>
        </div>

        @if (!string.IsNullOrEmpty(serviceResult))
        {
            <p><strong>Service Result:</strong> @serviceResult</p>
        }
    </Content>
</DemoSection>

<DemoSection Title="Modal Service Dialog" Code="@modalDialogServiceSource" CodeBehind="@modalDialogServiceCodeBehind">
    <Description>
        <p>Open a <em>modal</em> dialog via the `IDialogService`. The dialog provider will render a modal dialog when `DialogParameters` includes `Modal = true`.</p>
    </Description>
    <Content>
        <div class="demo-controls">
            <PggmButton Appearance="@ButtonAppearance.Primary" @onclick="OpenModalServiceDialog">Open Modal Service Dialog</PggmButton>
        </div>

        @if (!string.IsNullOrEmpty(modalDialogServiceResult))
        {
            <p><strong>Modal Service Result:</strong> @modalDialogServiceResult</p>
        }
    </Content>
</DemoSection>

<PggmHeading Level="2">API</PggmHeading>

<PggmHeading Level="3">PggmDialog</PggmHeading>
<ApiDocumentation Properties="dialogProperties" Events="dialogEvents" />

<PggmHeading Level="3">Dialog Service</PggmHeading>
<ApiDocumentation Properties="dialogService" />

@code {
    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;
    [Inject] private Pggm.Components.Components.PggmDialog.Services.IDialogService DialogService { get; set; } = default!;
    // Dialog states
    private bool isBasicDialogOpen = false;
    private bool isModalDialogOpen = false;
    private bool isTemplateDialogOpen = false;
    private bool isActionDialogOpen = false;
    private bool isFormDialogOpen = false;

    // Action results
    private string actionResult = "";
    private string formResult = "";

    // Programmatic control
    private PggmDialog? programmaticDialog;
    private List<string> programmaticEvents = new();

    // Form model
    private FormModel formModel = new();

    // Action dialog actions
    private List<DialogAction> actionDialogActions = new();
    private List<DialogAction> formDialogActions = new();
    private List<DialogAction> programmaticDialogActions = new();

    public class FormModel
    {
        [Required(ErrorMessage = "Name is required")]
        public string Name { get; set; } = "";

        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Please enter a valid email address")]
        public string Email { get; set; } = "";

        public bool Subscribe { get; set; } = false;
    }

    protected override void OnInitialized()
    {
        // Initialize action dialog actions
        actionDialogActions = new List<DialogAction>
        {
            new DialogAction
            {
                Text = "Cancel",
                Appearance = "secondary",
                OnClick = EventCallback.Factory.Create(this, CancelAction)
            },
            new DialogAction
            {
                Text = "Confirm",
                Appearance = "primary",
                OnClick = EventCallback.Factory.Create(this, ConfirmAction)
            }
        };

        // Initialize form dialog actions
        formDialogActions = new List<DialogAction>
        {
            new DialogAction
            {
                Text = "Cancel",
                Appearance = "secondary",
                OnClick = EventCallback.Factory.Create(this, CloseFormDialog)
            },
            new DialogAction
            {
                Text = "Save",
                Appearance = "primary",
                OnClick = EventCallback.Factory.Create(this, SubmitForm)
            }
        };

        // Initialize programmatic dialog actions
        programmaticDialogActions = new List<DialogAction>
        {
            new DialogAction
            {
                Text = "Close",
                Appearance = "primary",
                OnClick = EventCallback.Factory.Create(this, CloseProgrammatically)
            }
        };
    }

    // Basic dialog methods
    private void OpenBasicDialog()
    {
        isBasicDialogOpen = true;
    }

    private void OnBasicDialogClose()
    {
        Console.WriteLine("Basic dialog closed");
    }

    // Modal dialog methods
    private void OpenModalDialog()
    {
        isModalDialogOpen = true;
    }

    // Template dialog methods
    private void OpenTemplateDialog()
    {
        isTemplateDialogOpen = true;
    }

    // Action dialog methods
    private void OpenActionDialog()
    {
        isActionDialogOpen = true;
        actionResult = "";
    }

    private void OnActionDialogCancel()
    {
        actionResult = "Action was cancelled";
    }

    private void CancelAction()
    {
        actionResult = "User clicked Cancel";
        isActionDialogOpen = false;
    }

    private void ConfirmAction()
    {
        actionResult = "User clicked Confirm";
        isActionDialogOpen = false;
    }

    // Form dialog methods
    private void OpenFormDialog()
    {
        isFormDialogOpen = true;
        formResult = "";
        formModel = new FormModel(); // Reset form
    }

    private void OnFormDialogClose()
    {
        Console.WriteLine("Form dialog closed");
    }

    private void CloseFormDialog()
    {
        isFormDialogOpen = false;
    }

    private async Task SubmitForm()
    {
        // Validate the form element inside the dialog using JS interop
        var isValid = true;
        if (programmaticDialog != null)
        {
            // Use injected JSRuntime for JS interop
            isValid = await JSRuntime.InvokeAsync<bool>("eval", "document.querySelector('pggm-dialog form')?.checkValidity() ?? true");
        }
        if (!isValid)
        {
            formResult = "Form is invalid. Please correct the errors and try again.";
            return;
        }
        if (!string.IsNullOrEmpty(formModel.Name) && !string.IsNullOrEmpty(formModel.Email))
        {
            formResult = $"Saved: {formModel.Name} ({formModel.Email}) - Newsletter: {(formModel.Subscribe ? "Yes" : "No")}";
            isFormDialogOpen = false;
        }
    }

    // Programmatic control methods
    private async Task OpenProgrammatically()
    {
        if (programmaticDialog != null)
        {
            await programmaticDialog.OpenDialog();
        }
    }

    private async Task CloseProgrammatically()
    {
        if (programmaticDialog != null)
        {
            await programmaticDialog.CloseDialog();
        }
    }

    private void OnProgrammaticOpen()
    {
        programmaticEvents.Add($"{DateTime.Now:HH:mm:ss} - Dialog opened programmatically");
        StateHasChanged();
    }

    private void OnProgrammaticClose()
    {
        programmaticEvents.Add($"{DateTime.Now:HH:mm:ss} - Dialog closed programmatically");
        StateHasChanged();
    }

    // Service-based dialog demos
    private string serviceResult = "";
    private string modalDialogServiceResult = "";

    private async Task OpenServiceDialog()
    {
        RenderFragment content = builder =>
        {
            builder.AddContent(0, "Hello from service-based dialog. Click Confirm to close with data.");
        };

        // Define actions for the dialog, or use the actionLabels parameter for simple cases
        var actions = new List<DialogAction>
        {
            new DialogAction { Text = "Cancel", Appearance = "secondary", OnClick = EventCallback.Factory.Create(this, () => { }) },
            new DialogAction { Text = "Confirm", Appearance = "primary", OnClick = EventCallback.Factory.Create(this, () => { }) }
        };

        var parameters = new DialogParameters {
            ["Actions"] = actions
        };

        var result = await DialogService.ShowAsync("Service Dialog", content, false, null, parameters);
        serviceResult = result.Cancelled ? "Cancelled" : $"OK: {result.Data ?? "(no data)"}";
    }

    private async Task OpenModalServiceDialog()
    {
      
        RenderFragment content = builder =>
        {
            builder.AddContent(0, "This message came from OpenModalServiceDialog");
        };

        var result = await DialogService.ShowAsync("Modal Dialog", content, true, actionLabels: new[] { "Close" } );
        modalDialogServiceResult = result.Cancelled ? "Cancelled" : $"OK: {result.Data ?? "(no data)"}";
    }

    // Code snippet sources for demo sections
    private string basicDialogSource =
        "<PggmButton Appearance='@ButtonAppearance.Primary' @onclick='OpenBasicDialog'>Open Basic Dialog</PggmButton>\n" +
        "<PggmDialog @bind-Open='isBasicDialogOpen' HeaderContent='Basic Dialog'>\n" +
        "  <p>This is a basic dialog with some simple content.</p>\n" +
        "  <p>You can close it by clicking the X button or pressing Escape.</p>\n" +
        "</PggmDialog>";

    private string modalDialogSource =
        "<PggmButton Appearance='@ButtonAppearance.Primary' @onclick='OpenModalDialog'>Open Modal Dialog</PggmButton>\n" +
        "<PggmDialog @bind-Open='isModalDialogOpen' Modal='true' HeaderContent='Modal Dialog' CloseLabel='Close Modal'>\n" +
        "  <div>\n" +
        "    <p><strong>This is a modal dialog.</strong></p>\n" +
        "    <p>It blocks interaction with background until closed.</p>\n" +
        "  </div>\n" +
        "</PggmDialog>";

    private string templateDialogSource =
        "<PggmButton Appearance='@ButtonAppearance.Primary' @onclick='OpenTemplateDialog'>Open Dialog with Template Header</PggmButton>\n" +
        "<PggmDialog @bind-Open='isTemplateDialogOpen' Modal='true'>\n" +
        "  <HeaderTemplate>\n" +
        "    <div style='display:flex;align-items:center;gap:8px;'>\n" +
        "      <span style='color:#007acc;'>ℹ️</span>\n" +
        "      <strong>Custom Header with Icon</strong>\n" +
        "    </div>\n" +
        "  </HeaderTemplate>\n" +
        "  <ChildContent>\n" +
        "    <p>This dialog uses a custom header template with an icon.</p>\n" +
        "  </ChildContent>\n" +
        "</PggmDialog>";

    private string actionDialogSource =
        "<PggmButton Appearance='@ButtonAppearance.Primary' @onclick='OpenActionDialog'>Open Dialog with Actions</PggmButton>\n" +
        "<PggmDialog @bind-Open='isActionDialogOpen' Modal='true' HeaderContent='Confirm Action' Actions='@actionDialogActions' OnCancel='OnActionDialogCancel'>\n" +
        "  <p>Are you sure you want to proceed with this action?</p>\n" +
        "</PggmDialog>";

    private string formDialogSource =
        "<PggmButton Appearance='@ButtonAppearance.Primary' @onclick='OpenFormDialog'>Open Form Dialog</PggmButton>\n" +
        "<PggmDialog @bind-Open='isFormDialogOpen' Modal='true' HeaderContent='User Information' Actions='@formDialogActions' OnClose='OnFormDialogClose'>\n" +
        "  <EditForm Model='formModel' OnValidSubmit='SubmitForm'>\n" +
        "    <DataAnnotationsValidator />\n" +
        "    <ValidationSummary />\n" +
        "    <PggmFieldset>\n" +
        "      <PggmFieldsetLabel For='name'>Name</PggmFieldsetLabel>\n" +
        "      <PggmInput Id='name' Name='name' Required='true' @bind-Value='formModel.Name' />\n" +
        "    </PggmFieldset>\n" +
        "  </EditForm>\n" +
        "</PggmDialog>";

    private string programmaticSource =
        "<PggmButton Appearance='@ButtonAppearance.Primary' @onclick='OpenProgrammatically'>Open Programmatically</PggmButton>\n" +
        "<PggmButton Appearance='@ButtonAppearance.Secondary' @onclick='CloseProgrammatically'>Close Programmatically</PggmButton>\n" +
        "<PggmDialog @ref='programmaticDialog' Modal='true' HeaderContent='Programmatic Control' Actions='@programmaticDialogActions' OnOpen='OnProgrammaticOpen' OnClose='OnProgrammaticClose'>\n" +
        "  <p>This dialog is controlled programmatically using the component's methods.</p>\n" +
        "</PggmDialog>";

    private string serviceDialogSource =
        "<PggmButton Appearance='@ButtonAppearance.Primary' @onclick='OpenServiceDialog'>Open Service Dialog</PggmButton>\n" +
        "<p>Uses `IDialogService.ShowAsync` to open a dialog via the global `DialogProvider`.</p>\n\n";
        
    private string serviceDialogCodeBehind = 
    "private async Task OpenServiceDialog()\n" +
        "{\n" +
        "    RenderFragment content = builder =>\n" +
        "    {\n" +
        "        builder.AddContent(0, \"Hello from service-based dialog. Click Confirm to close with data.\");\n" +
        "    };\n\n" +
        "    var actions = new List<DialogAction>\n" +
        "    {\n" +
        "        new DialogAction { Text = \"Cancel\", Appearance = \"secondary\", OnClick = EventCallback.Factory.Create(this, () => { }) },\n" +
        "        new DialogAction { Text = \"Confirm\", Appearance = \"primary\", OnClick = EventCallback.Factory.Create(this, () => { }) }\n" +
        "    };\n\n" +
        "    var parameters = new DialogParameters { [\"Actions\"] = actions };\n\n" +
        "    var result = await DialogService.ShowAsync(\"Service Dialog\", content, false, null, parameters);\n" +
        "    serviceResult = result.Cancelled ? \"Cancelled\" : $\"OK: {result.Data ?? \\\"(no data)\\\"}\";\n" +

        "}\n" +
        ""; // No additional code-behind needed for this demo

    private string modalDialogServiceSource =
        "<PggmButton Appearance='@ButtonAppearance.Primary' @onclick='OpenModalServiceDialog'>Open Modal Service Dialog</PggmButton>\n" +
        "<p>Passes `DialogParameters` (including `Modal=true`) so the provider renders a modal dialog.</p>\n\n";
        

    private string modalDialogServiceCodeBehind = 
    "private async Task OpenModalServiceDialog()\n" +
        "{\n" +
        "    RenderFragment content = builder =>\n" +
        "    {\n" +
        "        builder.AddContent(0, \"This message came from OpenModalServiceDialog\");\n" +
        "    };\n\n" +
        "    var result = await DialogService.ShowAsync(\"Modal Dialog\", content, true, actionLabels: new[] { \"Close\" } );\n" +
        "    modalDialogServiceResult = result.Cancelled ? \"Cancelled\" : $\"OK: {result.Data ?? \\\"(no data)\\\"}\";\n" +
        "} \n" +
        "";

    // API documentation for PggmDialog
    private IEnumerable<ApiMember> dialogProperties = new[]
    {
        new ApiMember { Name = "Open", Type = "bool", DefaultValue = "false", Description = "Bind to control dialog open state." },
        new ApiMember { Name = "Modal", Type = "bool", DefaultValue = "false", Description = "When true, dialog prevents background interaction." },
        new ApiMember { Name = "HeaderContent", Type = "RenderFragment?", DefaultValue = "null", Description = "Header content (string or RenderFragment)." },
        new ApiMember { Name = "Actions", Type = "IEnumerable<DialogAction>", DefaultValue = "null", Description = "Action buttons shown in the dialog footer." }
    };

    private IEnumerable<ApiMember> dialogEvents = new[]
    {
        new ApiMember { Name = "OnOpen", Type = "EventCallback", Description = "Invoked when dialog opens." },
        new ApiMember { Name = "OnClose", Type = "EventCallback", Description = "Invoked when dialog closes." },
        new ApiMember { Name = "OnCancel", Type = "EventCallback", Description = "Invoked when cancel action is triggered." }
    };

    private IEnumerable<ApiMember> dialogService = new[]
    {
        new ApiMember { Name = "Show(title, RenderFragment)", Type = "DialogReference", Description = "Show a dialog with RenderFragment content." },
        new ApiMember { Name = "Show(title, string)", Type = "DialogReference", Description = "Show a dialog with plain string content (convenience overload)." },
        new ApiMember { Name = "ShowAsync(title, RenderFragment)", Type = "Task<DialogResult>", Description = "Asynchronously show a dialog and await the result." },
        new ApiMember { Name = "ShowAsync(title, string)", Type = "Task<DialogResult>", Description = "Asynchronously show a dialog with string content (convenience overload)." },
        new ApiMember { Name = "CloseAsync(reference, result)", Type = "Task", Description = "Close the specified dialog reference with an optional result payload." }
    };

    // CodeBehind snippets (C#) to show the @code part for each demo
    private string basicDialogBehind =
        "private bool isBasicDialogOpen = false;\n" +
        "private void OpenBasicDialog() { isBasicDialogOpen = true; }\n" +
        "private void OnBasicDialogClose() { Console.WriteLine(\"Basic dialog closed\"); }";

    private string modalDialogBehind =
        "private bool isModalDialogOpen = false;\n" +
        "private void OpenModalDialog() { isModalDialogOpen = true; }";

    private string templateDialogBehind =
        "private bool isTemplateDialogOpen = false;\n" +
        "private void OpenTemplateDialog() { isTemplateDialogOpen = true; }";

    private string actionDialogBehind =
        "private bool isActionDialogOpen = false;\n" +
        "private string actionResult = \"\";\n" +
        "private void OpenActionDialog() { isActionDialogOpen = true; actionResult = \"\"; }\n" +
        "private void OnActionDialogCancel() { actionResult = \"Action was cancelled\"; }\n" +
        "private void CancelAction() { actionResult = \"User clicked Cancel\"; isActionDialogOpen = false; }\n" +
        "private void ConfirmAction() { actionResult = \"User clicked Confirm\"; isActionDialogOpen = false; }";

    private string formDialogBehind =
        "private bool isFormDialogOpen = false;\n" +
        "private string formResult = \"\";\n" +
        "private FormModel formModel = new FormModel();\n" +
        "private void OpenFormDialog() { isFormDialogOpen = true; formResult = \"\"; formModel = new FormModel(); }\n" +
        "private void CloseFormDialog() { isFormDialogOpen = false; }\n" +
        "private async Task SubmitForm() { /* form submission logic */ await Task.CompletedTask; }";

    private string programmaticBehind =
        "private PggmDialog? programmaticDialog;\n" +
        "private List<string> programmaticEvents = new();\n" +
        "private async Task OpenProgrammatically() { if (programmaticDialog != null) await programmaticDialog.OpenDialog(); }\n" +
        "private async Task CloseProgrammatically() { if (programmaticDialog != null) await programmaticDialog.CloseDialog(); }\n" +
        "private void OnProgrammaticOpen() { programmaticEvents.Add($\"{DateTime.Now:HH:mm:ss} - Dialog opened programmatically\"); }\n" +
        "private void OnProgrammaticClose() { programmaticEvents.Add($\"{DateTime.Now:HH:mm:ss} - Dialog closed programmatically\"); }";

    // Labels are rendered via <PggmFieldsetLabel> element in markup
}


<style>
    .demo-section {
        margin-bottom: 2rem;
        padding: 1rem;
        border: 1px solid #e0e0e0;
        border-radius: 4px;
    }

    .demo-controls {
        margin: 1rem 0;
    }

    .demo-controls>* {
        margin-right: 0.5rem;
    }

    .event-log {
        margin-top: 1rem;
        padding: 1rem;
        background-color: #f8f9fa;
        border-radius: 4px;
    }

    .event-log ul {
        margin: 0;
        padding-left: 1.5rem;
