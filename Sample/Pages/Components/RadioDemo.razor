@page "/pggm-radio"

<PageTitle>PGGM Radio</PageTitle>

@using System.ComponentModel.DataAnnotations
@using Pggm.Components.Sample.Components.ApiDocumentation

<PggmHeading Level="1">PGGM Radio</PggmHeading>

<p>This page demonstrates the PGGM Radio component with various configurations and usage examples.</p>

<DemoSection Title="Bindable Radio with PggmRadio" Code="@bindExampleSource" CodeBehind="@bindExampleBehind">
    <Content>
    <p>Selected Bound: <strong>@selectedBound</strong></p>
    
    <PggmStack Orientation="Pggm.Components.Orientation.Horizontal" HorizontalGap="16">
        <PggmRadio RadioValue="apple" @bind-Value="selectedBound">Apple</PggmRadio>
        <PggmRadio RadioValue="banana" @bind-Value="selectedBound">Banana</PggmRadio>
        <PggmRadio RadioValue="cherry" @bind-Value="selectedBound">Cherry</PggmRadio>
    </PggmStack>
    </Content>
</DemoSection>

<DemoSection Title="EditForm Example" Code="@editFormSource" CodeBehind="@editFormBehind">
    <Content>
 
    <EditForm Model="formModel" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <PggmValidationSummary>
            Het formulier bevat fouten, controleer en corrigeer deze
        </PggmValidationSummary>
        <PggmFieldset>
            <PggmFieldsetLabel For="fruit">Kies je favoriete fruit:</PggmFieldsetLabel>
            <PggmValidationMessage  For="() => formModel.Fruit">
                <p>Kies een item</p>
            </PggmValidationMessage>
            <PggmStack VerticalGap="8">
                <PggmRadio Description="If your want to be like steve jobs" RadioValue="apple" @bind-Value="formModel.Fruit" Name="fruit">Apple</PggmRadio>
                <PggmRadio Description="If you want to be like bill gates" RadioValue="banana" @bind-Value="formModel.Fruit" Name="fruit">Banana</PggmRadio>
                <PggmRadio Description="If you want to be like elon musk" RadioValue="cherry" @bind-Value="formModel.Fruit" Name="fruit">Cherry</PggmRadio>
            </PggmStack>
        </PggmFieldset>
        <PggmButton Appearance="@ButtonAppearance.Primary" Type="@ButtonType.Submit">Submit</PggmButton>
            
        
    </EditForm>

    <p>Form model fruit: <strong>@formModel.Fruit</strong></p>
    </Content>
</DemoSection>


<DemoSection Title="Basic Radio Button Group" Code="@basicRadioSource" CodeBehind="@basicRadioBehind">
    <Content>
    <p>Selected Option: <strong>@selectedOption1</strong></p>
    
    <PggmStack VerticalGap="8">
        <PggmRadio Name="option1" RadioValue="option-a" @bind-Value="selectedOption1">
            Option A
        </PggmRadio>
        
        <PggmRadio Name="option1" RadioValue="option-b" @bind-Value="selectedOption1">
            Option B
        </PggmRadio>
        
        <PggmRadio Name="option1" RadioValue="option-c" @bind-Value="selectedOption1">
            Option C
        </PggmRadio>
    </PggmStack>
    </Content>
</DemoSection>

<DemoSection Title="Radio Buttons with Descriptions" Code="@planRadioSource" CodeBehind="@planRadioBehind">
    <Content>
    <p>Selected Plan: <strong>@selectedPlan</strong></p>
    
    <PggmStack VerticalGap="8">
        <PggmRadio Name="plan" RadioValue="basic" @bind-Value="selectedPlan" Description="Perfect for small projects">Basic Plan</PggmRadio>
        <PggmRadio Name="plan" RadioValue="professional" @bind-Value="selectedPlan" Description="Best for growing businesses">Professional Plan</PggmRadio>
        <PggmRadio Name="plan" RadioValue="enterprise" @bind-Value="selectedPlan" Description="Advanced features for large organizations">Enterprise Plan</PggmRadio>
    </PggmStack>
    </Content>
</DemoSection>

<DemoSection Title="Disabled Radio Buttons" Code="@disabledRadioSource" CodeBehind="@disabledRadioBehind">
    <Content>
    <p>Selected Theme: <strong>@selectedTheme</strong></p>
    
    <PggmStack VerticalGap="8">
        <PggmRadio Name="theme" RadioValue="light" @bind-Value="selectedTheme">Light Theme</PggmRadio>
        <PggmRadio Name="theme" RadioValue="dark" @bind-Value="selectedTheme">Dark Theme</PggmRadio>
        <PggmRadio Name="theme" RadioValue="auto" @bind-Value="selectedTheme" Disabled="true">Auto Theme (Coming Soon)</PggmRadio>
    </PggmStack>
    </Content>
</DemoSection>

<DemoSection Title="Required Radio Button Group" Code="@requiredRadioSource" CodeBehind="@requiredRadioBehind">
    <Content>
    <p>Selected Priority: <strong>@selectedPriority</strong></p>
    
    <PggmStack VerticalGap="8">
        <PggmRadio Name="priority" RadioValue="low" Required="true" @bind-Value="selectedPriority">Low Priority</PggmRadio>
        <PggmRadio Name="priority" RadioValue="medium" Required="true" @bind-Value="selectedPriority">Medium Priority</PggmRadio>
        <PggmRadio Name="priority" RadioValue="high" Required="true" @bind-Value="selectedPriority">High Priority</PggmRadio>
    </PggmStack>
    </Content>
</DemoSection>

