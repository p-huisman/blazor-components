@page "/pggm-label"

@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components
@using Pggm.Components.Sample.Components.ApiDocumentation

<PageTitle>PGGM Label</PageTitle>

<PggmHeading Level="1">PGGM Label</PggmHeading>

<p>This page demonstrates the PGGM Label component with various configurations and use cases.</p>

<DemoSection Title="Basic PggmLabel Usage" Code="@basicLabelSource">
    <Description>
        <p>Basic labels associated with form controls using the <code>For</code> attribute:</p>
    </Description>

    <Content>
        <PggmFieldset>
            <PggmLabel slot="label" For="basic-text-input">Basic text</PggmLabel>
            <PggmErrorMessage slot="error" For="basic-text-input" Validity="@PggmErrorMessage.ValidityStates.ValueMissing">
                This field is required.
            </PggmErrorMessage>
            <PggmInput id="basic-text-input" Type="text" Required="true" Placeholder="Enter some text..." />
        </PggmFieldset>

        <PggmFieldset>
            <PggmLabel slot="label" For="basic-email-input">Email address <span class="pggm-label__optional">Optioneel</span></PggmLabel>
            <PggmInput id="basic-email-input" Type="email" Placeholder="user@example.com" />
        </PggmFieldset>

    </Content>
</DemoSection>



<PggmHeading Level="2">API</PggmHeading>

<PggmHeading Level="3">PggmLabel</PggmHeading>

<p>The <code>PggmLabel</code> is a wrapper around a standard HTML <code>&lt;label&gt;</code> 
<code><a target="_blank" href="https://developer.mozilla.org/en-US/docs/Web/API/HTMLLabelElement">HTMLLabelElement</a></code>, 
providing additional styling for form labels.</p>

<ApiDocumentation Properties="labelProperties" Events="labelEvents" />


@code {
   
    private string basicLabelSource = """
<PggmFieldset>
    <PggmLabel slot="label" For="basic-text-input">Basic text</PggmLabel>
    <PggmErrorMessage slot="error" For="basic-text-input" Validity="@PggmErrorMessage.ValidityStates.ValueMissing">
        This field is required.
    </PggmErrorMessage>
    <PggmInput id="basic-text-input" Type="text" Required="true" Placeholder="Enter some text..." />
</PggmFieldset>

<PggmFieldset>
    <PggmLabel slot="label" For="basic-email-input">Email address <span class="pggm-label__optional">Optioneel</span></PggmLabel>
    <PggmInput id="basic-email-input" Type="email" Placeholder="user@example.com" />
</PggmFieldset>
""";


    private IEnumerable<ApiMember> labelProperties = new[]
    {
        new ApiMember { Name = "For", Type = "string?", DefaultValue = "null", Description = "Associates the label with a form control id (the input's id)." },
        new ApiMember { Name = "ChildContent", Type = "RenderFragment?", DefaultValue = "null", Description = "Content rendered inside the label (text, HTML, or fragments)." },
        new ApiMember { Name = "AdditionalAttributes", Type = "Dictionary<string, object>?", DefaultValue = "null", Description = "Additional attributes applied to the label element (e.g. slot=\"label\")." }
    };

    private IEnumerable<ApiMember> labelEvents = new ApiMember[] { };

}


