@page "/pggm-error-message"
@using Pggm.Components.Sample.Components.ApiDocumentation

<PageTitle>PGGM Error Message</PageTitle>

<PggmHeading Level="1">PGGM Error Message</PggmHeading>

<p>
  The <code>PggmErrorMessage</code> component is used to display validation error messages associated 
  with form controls. It can be configured to show messages for specific validity states, such as when a 
  required field is left empty or when a pattern does not match. 
  This component enhances user experience by providing clear feedback on form validation issues, 
  helping users understand what needs to be corrected.
</p>

<DemoSection Title="Error Message Associated with Input Field" Code="@basicErrorSource">
  <PggmLabel For="sample-input">Sample Input:</PggmLabel>
  <PggmErrorMessage For="sample-input" Validity="@PggmErrorMessage.ValidityStates.ValueMissing">
    This field is required.
  </PggmErrorMessage>
  <PggmInput Required="true" Id="sample-input" @bind-Value="sampleInputValue" />
</DemoSection>

<DemoSection Title="Multiple Validity States" Code="@multipleValiditySource">
  <PggmLabel For="multi-input">Multi-validation Input:</PggmLabel>
  <PggmErrorMessage For="multi-input"
                    Validity="@($"{PggmErrorMessage.ValidityStates.ValueMissing} {PggmErrorMessage.ValidityStates.PatternMismatch}")">
    This field is required and must match the specified pattern. (Starts with 'P')
  </PggmErrorMessage>
  <PggmInput Required="true" Pattern="^P.*" Id="multi-input" @bind-Value="multiInputValue" />
</DemoSection>

<PggmHeading Level="2">API</PggmHeading>

<PggmHeading Level="3">PggmErrorMessage</PggmHeading>
<ApiDocumentation Properties="_properties" />

@code {

  // Backing fields for demo inputs that are displayed without a model bind.
  private string sampleInputValue = "";
  private string multiInputValue = "";

  // CodeSnippet sources (use SnippetBuilder for consistent formatting)
  private string basicErrorSource = """
<PggmLabel For="sample-input">Sample Input:</PggmLabel>
<PggmErrorMessage For="sample-input" Validity="@($"{PggmErrorMessage.ValidityStates.ValueMissing}")">This field is required.</PggmErrorMessage>
<PggmInput Required="true" Id="sample-input" @bind-Value="sampleInputValue" />
@code {
  private string sampleInputValue = "";
}
""";

  private string multipleValiditySource = """
<PggmLabel For="multi-input">Multi-validation Input:</PggmLabel>
<PggmErrorMessage For="multi-input" Validity="@($"{PggmErrorMessage.ValidityStates.ValueMissing} {PggmErrorMessage.ValidityStates.PatternMismatch}")">This field is required and must match the specified pattern. (Starts with 'P')</PggmErrorMessage>
<PggmInput Required="true" Pattern="^P.*" Id="multi-input" @bind-Value="multiInputValue" />
@code {
  private string multiInputValue = "";
}
""";

  // API table for docs
  private IEnumerable<ApiMember> _properties = new[]
  {
    new ApiMember { Name = "For", Type = "string?", DefaultValue = "null", Description = "Target input id or name associated with this error message." },
    new ApiMember { Name = "Validity", Type = "string?", DefaultValue = "null", Description = "One or more validity states (space-separated) that this message represents, e.g. ValueMissing PatternMismatch." },
    new ApiMember { Name = "ChildContent", Type = "RenderFragment?", DefaultValue = "null", Description = "Optional custom markup for the message content." },
    new ApiMember { Name = "CssClass", Type = "string?", DefaultValue = "null", Description = "Additional CSS classes applied to the root element." },
    new ApiMember { Name = "AdditionalAttributes", Type = "Dictionary<string, object>?", DefaultValue = "null", Description = "Additional attributes splatted onto the underlying pggm-error-message element." },
  };
}

