@page "/pggm-input-date"

@using Pggm.Components.Enums
@using Pggm.Components.Sample.Components.ApiDocumentation

<PageTitle>PGGM Input Date</PageTitle>

<PggmHeading Level="1">PGGM Input Date</PggmHeading>

<p>This page demonstrates the PGGM Input Date component with various configurations and features.</p>

<p><strong>Note:</strong> The component's bound `Value` is a `DateTime` (or `DateTime[]` when `Period="true"`). It is no longer a string.</p>

<DemoSection Title="Basic Date Input" Code="@basicDateSource" CodeBehind="@basicDateBehind">
    <Description>
        <p>Basic date input with dd-mm-yyyy format</p>
    </Description>
    <Content>
        <PggmInputDate @bind-Value="basicDate" 
                       Format="@(PggmInputDate<DateTime?>.DateFormats.DayMonthYear)"
                       Name="basic-date"
                       Required="true" />
        <p><strong>Current Value:</strong> @basicDate</p>
    </Content>
</DemoSection>

<DemoSection Title="EditForm Example" Code="@editFormSource" CodeBehind="@editFormBehind">
    <Description>
        <p>Example showing <code>EditForm</code> integration with <code>PggmInputDate</code> and data-annotation validation.</p>
    </Description>
    <Content>
        <EditForm Model="@dateFormModel" OnSubmit="HandleDateFormSubmit">
            <DataAnnotationsValidator />
            <PggmValidationSummary>
                Het formulier bevat fouten, controleer en corrigeer deze
            </PggmValidationSummary>
            <PggmFieldset>
                <PggmLabel slot="label" For="dateForm">Select Date:</PggmLabel>
                <PggmValidationMessage slot="error"  For="() => dateFormModel.Date">
                    <p>Vul een geldige datum, de datum moet tussen 01-01-2024 en 31-12-2024 liggen.</p>
                </PggmValidationMessage>
                <PggmInputDate @bind-Value="@dateFormModel.Date"
                               Format="@(PggmInputDate<DateTime?>.DateFormats.DayMonthYear)"
                               Name="dateForm"
                               Id="dateForm"
                               Min="2024-01-01"
                               Max="2024-12-31"
                               Required />
                </PggmFieldset>

            <PggmButton Appearance="@ButtonAppearance.Primary" Type="@ButtonType.Submit">Submit</PggmButton>
            
        </EditForm>

        @if (submittedDate != null)
        {
            <p><strong>Submitted date:</strong> @submittedDate</p>
        }
    </Content>
</DemoSection>

<DemoSection Title="Date Range (Period) Input" Code="@periodDateSource" CodeBehind="@periodDateBehind">
    <Description>
        <p>Date input with period enabled for date ranges</p>
    </Description>
    <Content>
        <PggmInputDate @bind-Value="periodDate" 
                       Format="@(PggmInputDate<DateTime?[]>.DateFormats.DayMonthYear)"
                       Name="period-date"
                       Period="true"
                       Required="true" />
        <p><strong>Current Value:</strong> @(periodDate != null ? string.Join(", ", periodDate.Select(d => d?.ToString("yyyy-MM-dd") ?? "null")) : "null")</p>
    </Content>
</DemoSection>

<DemoSection Title="Date Input with Min/Max" Code="@minMaxSource" CodeBehind="@minMaxBehind">
    <Description>
        <p>Date input with minimum and maximum date restrictions</p>
    </Description>
    <Content>
        <PggmInputDate @bind-Value="restrictedDate" 
                       Format="@(PggmInputDate<DateTime?>.DateFormats.DayMonthYear)"
                       Name="restricted-date"
                       Min="2024-01-01"
                       Max="2024-12-31"
                       Required="true" />
        <p><strong>Current Value:</strong> @restrictedDate</p>
        <p><em>Only dates between 01-01-2024 and 31-12-2024 are allowed</em></p>
    </Content>
</DemoSection>

<DemoSection Title="Different Date Formats" Code="@formatsSource" CodeBehind="@formatsBehind">
    <Content>
        <PggmHeading Level="3">US Format (mm-dd-yyyy)</PggmHeading>
        <PggmInputDate @bind-Value="usDate" 
                       Format="@(PggmInputDate<DateTime?>.DateFormats.MonthDayYear)"
                       Name="us-date" />
        <p><strong>Current Value:</strong> @usDate</p>
        
        <PggmHeading Level="3">ISO Format (yyyy-mm-dd)</PggmHeading>
        <PggmInputDate @bind-Value="isoDate" 
                       Format="@(PggmInputDate<DateTime?>.DateFormats.YearMonthDay)"
                       Name="iso-date" />
        <p><strong>Current Value:</strong> @isoDate</p>
    </Content>
</DemoSection>

<DemoSection Title="Disabled and ReadOnly States" Code="@disabledSource" CodeBehind="@disabledBehind">
    <Content>
        <PggmHeading Level="3">Disabled</PggmHeading>
        <PggmInputDate Value="@disabledDateValue" 
                       Format="@(PggmInputDate<DateTime?>.DateFormats.DayMonthYear)"
                       Name="disabled-date"
                       Disabled="true" />
        
        <PggmHeading Level="3">ReadOnly</PggmHeading>
        <PggmInputDate Value="@readonlyDateValue" 
                       Format="@(PggmInputDate<DateTime?>.DateFormats.DayMonthYear)"
                       Name="readonly-date"
                       ReadOnly="true" />
    </Content>
</DemoSection>

<DemoSection Title="Event Handling" Code="@eventSource" CodeBehind="@eventBehind">
    <Description>
        <p>Date input with event handlers</p>
    </Description>
    <Content>
        <PggmInputDate @bind-Value="eventDate" 
                       Format="@(PggmInputDate<DateTime?>.DateFormats.DayMonthYear)"
                       Name="event-date"
                       OnChange="OnDateChange"
                       OnFocus="OnDateFocus"
                       OnBlur="OnDateBlur" />

        <p><strong>Current Value:</strong> @eventDate</p>

        <PggmHeading Level="3">Event Log:</PggmHeading>
        <div class="event-log">
            @foreach (var logEntry in eventLog)
            {
                <div>@logEntry</div>
            }
        </div>
    </Content>
</DemoSection>

<PggmHeading Level="2">API</PggmHeading>

<PggmHeading Level="3">PggmInputDate</PggmHeading>
