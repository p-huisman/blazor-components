</PggmAccordionItem>";

    private string interactiveItemBehind = @"@code {
    private bool isOpen = false;
    private bool isDisabled = false;
}";


    // API metadata for documentation component
    private IEnumerable<ApiMember> accordionProperties = new[]
    {
        new ApiMember { Name = "AllowMultiple", Type = "bool", DefaultValue = "false", Description = "When true, multiple items may be expanded at once." }
    };

    private IEnumerable<ApiMember> accordionEvents = new[]
    {
        new ApiMember { Name = "OnAccordionToggle", Type = "EventCallback<EventArgs>", Description = "Invoked when an accordion item is toggled." }
    };

    private IEnumerable<ApiMember> accordionItemProperties = new[]
    {
        new ApiMember { Name = "Open", Type = "bool", DefaultValue = "false", Description = "Whether the item is open." },
