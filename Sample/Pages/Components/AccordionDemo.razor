        <p>Allow Multiple is currently: @allowMultiple</p>
    </PggmAccordionItem>
</PggmAccordion>";

    private string interactiveAccordionBehind = @"@code {
    private bool allowMultiple = false;
}";

    private string defaultItemSource = @"<PggmAccordionItem>
    <PggmAccordionItemTitle>Accordion Item 1</PggmAccordionItemTitle>
    <p>This is the content of the first accordion item.</p>
</PggmAccordionItem>";

    private string openItemSource = @"<PggmAccordionItem Open=""true"">
