<DemoSection Title="Outlined Icons" Code="@outlinedIconsSource">
    <p>Icons can be displayed in an outlined style by setting the <code>Outline</code> parameter to <code>true</code>.</p>
    
    <div class="icon-comparison">
        <div class="icon-comparison-section">
            <h4>Regular Icons</h4>
            <div class="icon-demo-row">
                <PggmIcon Icon="@ComponentValues.IconName.Alert" Size="@ComponentValues.IconSize.Large" />
                <PggmIcon Icon="@ComponentValues.IconName.Calendar" Size="@ComponentValues.IconSize.Large" />
                <PggmIcon Icon="@ComponentValues.IconName.Heart" Size="@ComponentValues.IconSize.Large" />
                <PggmIcon Icon="@ComponentValues.IconName.Info" Size="@ComponentValues.IconSize.Large" />
                <PggmIcon Icon="@ComponentValues.IconName.User" Size="@ComponentValues.IconSize.Large" />
            </div>
        </div>
        <div class="icon-comparison-section">
            <h4>Outlined Icons</h4>
            <div class="icon-demo-row">
                <PggmIcon Icon="@ComponentValues.IconName.Alert" Size="@ComponentValues.IconSize.Large" Outline="true" />
                <PggmIcon Icon="@ComponentValues.IconName.Calendar" Size="@ComponentValues.IconSize.Large" Outline="true" />
                <PggmIcon Icon="@ComponentValues.IconName.Heart" Size="@ComponentValues.IconSize.Large" Outline="true" />
                <PggmIcon Icon="@ComponentValues.IconName.Info" Size="@ComponentValues.IconSize.Large" Outline="true" />
                <PggmIcon Icon="@ComponentValues.IconName.User" Size="@ComponentValues.IconSize.Large" Outline="true" />
            </div>
        </div>
    </div>
</DemoSection>

<DemoSection Title="Interactive Example" Code="@interactiveSource" CodeBehind="@interactiveBehind">
    <p>Try different combinations of icons, sizes, and styles:</p>
    
    <div class="interactive-demo">
        <div class="controls">
            <div class="control-group">
                <PggmLabel For="icon-select">Select Icon:</PggmLabel>
                <PggmSelect TOption="string" @bind-Value="selectedIcon" Id="icon-select" Placeholder="Choose an icon..." AriaLabel="Icon select">
                    <option value="@ComponentValues.IconName.Alert">Alert</option>
                    <option value="@ComponentValues.IconName.AlertFilled">Alert Filled</option>
                    <option value="@ComponentValues.IconName.Apple">Apple</option>
                    <option value="@ComponentValues.IconName.Calendar">Calendar</option>
                    <option value="@ComponentValues.IconName.ChartBars">Chart Bars</option>
                    <option value="@ComponentValues.IconName.ChevronDown">Chevron Down</option>
                    <option value="@ComponentValues.IconName.ChevronLeft">Chevron Left</option>
                    <option value="@ComponentValues.IconName.ChevronRight">Chevron Right</option>
                    <option value="@ComponentValues.IconName.ChevronUp">Chevron Up</option>
                    <option value="@ComponentValues.IconName.Copy">Copy</option>
                    <option value="@ComponentValues.IconName.Heart">Heart</option>
                    <option value="@ComponentValues.IconName.Info">Info</option>
                    <option value="@ComponentValues.IconName.MoodSmile">Mood Smile</option>
                    <option value="@ComponentValues.IconName.Pencil">Pencil</option>
                    <option value="@ComponentValues.IconName.User">User</option>
                    <option value="@ComponentValues.IconName.Users">Users</option>
                </PggmSelect>
            </div>
            
            <div class="control-group">
                <PggmLabel For="size-select">Select Size:</PggmLabel>
                <PggmSelect TOption="string" @bind-Value="selectedSize" Id="size-select" Placeholder="Choose a size..." AriaLabel="Size select">
                    <option value="@ComponentValues.IconSize.Small">Small (small)</option>
                    <option value="@ComponentValues.IconSize.Medium">Medium (medium)</option>
                    <option value="@ComponentValues.IconSize.Large">Large (large)</option>
                </PggmSelect>
            </div>
            
            <div class="control-group">
                <PggmCheckbox @bind-Value="isOutlined" Id="outline-checkbox" />
                <PggmLabel For="outline-checkbox">Outlined</PggmLabel>
            </div>
        </div>
        
        <div class="preview">
            <PggmHeading Level="4">Preview:</PggmHeading>
            <div class="icon-preview">
                <PggmIcon Icon="@selectedIcon" Size="@selectedSize" Outline="@isOutlined" />
            </div>
            <div class="code-preview">
                <strong>Code:</strong>
                <code>&lt;PggmIcon Icon="@selectedIcon" Size="@selectedSize"@(isOutlined ? " Outline=\"true\"" : "") /&gt;</code>
            </div>
        </div>
    </div>
</DemoSection>

