@page "/pggm-icon"
@using Pggm.Components.Sample.Components.ApiDocumentation

<PageTitle>PGGM Icon</PageTitle>

<PggmHeading Level="1">PGGM Icon</PggmHeading>


<p>
    The <code>PggmIcon</code> component is a Blazor wrapper for the PGGM design system's icon web component.
    It provides access to a comprehensive set of icons in various sizes and styles.
</p>

<DemoSection Title="Icon Sizes" Code="@iconSizesSource">
    <p>Icons are available in three different sizes: Small, Medium, and Large.</p>
    
    <div class="icon-demo-grid">
        <div class="icon-demo-item">
            <PggmIcon Icon="@ComponentValues.IconName.User" Size="@ComponentValues.IconSize.Small" />
            <span>Small (s)</span>
        </div>
        <div class="icon-demo-item">
            <PggmIcon Icon="@ComponentValues.IconName.User" Size="@ComponentValues.IconSize.Medium" />
            <span>Medium (m) - Default</span>
        </div>
        <div class="icon-demo-item">
            <PggmIcon Icon="@ComponentValues.IconName.User" Size="@ComponentValues.IconSize.Large" />
            <span>Large (l)</span>
        </div>
        
    </div>
</DemoSection>

<DemoSection Title="Custom SVG (slot)" Code="@customSvgSource">
    <p>Icons can be provided as custom SVGs by placing an <code>&lt;svg slot="svg"&gt;</code> inside the component.</p>
    <div class="icon-demo-grid">
        <div class="icon-demo-item">
            <PggmIcon Icon="custom-svg" Size="@ComponentValues.IconSize.Large">
                <svg slot="svg" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                    <path d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0" />
                </svg>
            </PggmIcon>
            <span>Custom SVG (slot)</span>
        </div>
    </div>
</DemoSection>

<DemoSection Title="Dimensions" Code="@dimensionsSource">
    <p>You can control rendered size by providing <code>width</code> and <code>height</code>.
       A plain number is treated as pixels; include a unit for CSS units (e.g. <code>.8em</code>).</p>
    <div class="icon-demo-grid">
        <div class="icon-demo-item">
            <PggmIcon Icon="@ComponentValues.IconName.AlertFilled" Width="64" Height="64" />
            <span>64 x 64 (pixels)</span>
        </div>
        <div class="icon-demo-item">
            <PggmIcon Icon="@ComponentValues.IconName.Alert" Width=".8em" Height=".8em" />
            <span>.8em x .8em</span>
        </div>
    </div>
</DemoSection>

<DemoSection Title="SVG Source (src)" Code="@customSrcSource">
    <p>You can also provide an external SVG via the <code>src</code> attribute.</p>
    <div class="icon-demo-grid">
        <div class="icon-demo-item">
            <PggmIcon Icon="src" Size="@ComponentValues.IconSize.Medium" Src="data:image/svg+xml;utf8,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2024%2024'%20fill='none'%20stroke='currentColor'%20stroke-width='2'%3E%3Cpath%20d='M9%2012a3%203%200%201%200%206%200a3%203%200%200%200-6%200'/%3E%3C/svg%3E" />
            <span>External SVG via src</span>
        </div>
    </div>
</DemoSection>

