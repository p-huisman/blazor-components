@page "/pggm-table"
@using Pggm.Components
@using Pggm.Components.Sample.Components.DemoSection
@using Pggm.Components.Sample.Components.ApiDocumentation
@using System.Linq

<PageTitle>Advanced Table Example</PageTitle>

<PggmHeading Level="1">PGGM Table - Advanced Examples</PggmHeading>

<PggmHeading Level="2">Local Data</PggmHeading>

<DemoSection Title="Single-Select Table" Code="@_singleSelectCode" CodeBehind="@_singleSelectBehind">
    <Description>
        <p>Local data with sorting, filtering, and single row selection. The selected employee ID is shown below the table.</p>
    </Description>
    <Content>
        <PggmTable
            FilterLabel="Filter instellen"
            ClearLabel="Filter wissen"
            Lang="nl"
            IdField="id"
            Selectable="true"
            SelectType="single"
            OnSelectionChanged="ids => { _selectedEmployeeId = ids.FirstOrDefault(); }"
            Data="@employeeData">

            <PggmTh Sortable="true" Filterable="true" Field="firstName" Width="150" Type="string" Format="string">First Name</PggmTh>
            <PggmTh Sortable="true" Filterable="true" Field="lastName"  Width="150" Type="string" Format="string">Last Name</PggmTh>
            <PggmTh Filterable="true"                 Field="department" Width="200" Type="string" Format="string">Department</PggmTh>
            <PggmTh Sortable="true" Format="date"     Field="hireDate"  Width="auto" Type="date"   TextAlign="center">Hire Date</PggmTh>
            <PggmTh Sortable="true" Format="currency" Field="salary"    Width="auto" Type="number" TextAlign="right">Annual Salary</PggmTh>
            <PggmTh Sortable="true" Format="boolean"  Field="isActive"  Width="100"  Type="boolean" TextAlign="center">Active</PggmTh>
        </PggmTable>

        @if (!string.IsNullOrEmpty(_selectedEmployeeId))
        {
            <p style="margin-top:.5rem;">Selected employee ID: <strong>@_selectedEmployeeId</strong></p>
        }
    </Content>
</DemoSection>

<DemoSection Title="Multi-Select Table" Code="@_multiSelectCode" CodeBehind="@_multiSelectBehind">
    <Description>
        <p>Local data with multiple row selection using checkboxes. Selected project IDs are shown below.</p>
    </Description>
    <Content>
        <PggmTable
            FilterLabel="Filter projects"
            ClearLabel="Clear filters"
            Lang="nl"
            IdField="projectId"
            Selectable="true"
            SelectType="multiple"
            Data="@projectData"
            OnSelectionChanged="ids => { _selectedProjectIds = ids; }">

            <PggmTh Sortable="true" Filterable="true" Field="projectName" Width="200" Type="string"  Format="string">Project Name</PggmTh>
            <PggmTh Filterable="true"                 Field="client"      Width="150" Type="string"  Format="string">Client</PggmTh>
            <PggmTh Sortable="true" Format="date"     Field="startDate"   Width="120" Type="date"    TextAlign="center">Start Date</PggmTh>
            <PggmTh Sortable="true" Format="date"     Field="endDate"     Width="120" Type="date"    TextAlign="center">End Date</PggmTh>
            <PggmTh Sortable="true" Format="currency" Field="budget"      Width="auto" Type="number" TextAlign="right">Budget</PggmTh>
            <PggmTh Filterable="true"                 Field="status"      Width="100" Type="string"  Format="string">Status</PggmTh>
        </PggmTable>

        @if (_selectedProjectIds.Length > 0)
        {
            <p style="margin-top:.5rem;">Selected project IDs: <strong>@string.Join(", ", _selectedProjectIds)</strong></p>
        }
    </Content>
</DemoSection>

<DemoSection Title="Two-Way Selection Binding" Code="@_twoWayCode" CodeBehind="@_twoWayBehind">
    <Description>
        <p>Demonstrating two-way binding with the <code>Selected</code> parameter. Click the buttons to programmatically update the selection from the parent.</p>
    </Description>
    <Content>
        <div style="display:flex; gap:0.5rem; margin-bottom:1rem;">
            <button @onclick="() => _twoWaySelected = Enumerable.Range(1, 6).Select(i => i.ToString()).ToArray()">Select All Employees</button>
            <button @onclick="() => _twoWaySelected = []">Clear Selection</button>
        </div>

        <PggmTable
            FilterLabel="Filter employees"
            ClearLabel="Clear filters"
            Lang="nl"
            IdField="id"
            Selectable="true"
            SelectType="multiple"
            Data="@employeeData"
            @bind-Selected="_twoWaySelected">

            <PggmTh Sortable="true" Filterable="true" Field="firstName" Width="150" Type="string" Format="string">First Name</PggmTh>
            <PggmTh Sortable="true" Filterable="true" Field="lastName"  Width="150" Type="string" Format="string">Last Name</PggmTh>
            <PggmTh Filterable="true"                 Field="department" Width="200" Type="string" Format="string">Department</PggmTh>
            <PggmTh Sortable="true" Format="currency" Field="salary"    Width="auto" Type="number" TextAlign="right">Annual Salary</PggmTh>
        </PggmTable>

        @if (_twoWaySelected.Length > 0)
        {
            <p style="margin-top:.5rem;">Selected employee IDs: <strong>@string.Join(", ", _twoWaySelected)</strong></p>
            <p style="font-size:0.9rem; color:#666;">Selection can be updated by clicking checkboxes in the table or using the buttons above.</p>
        }
    </Content>
</DemoSection>

<DemoSection Title="Two-Way Selection Binding (Single Select)" Code="@_twoWaySingleCode" CodeBehind="@_twoWaySingleBehind">
    <Description>
        <p>Single-select two-way binding with the <code>Selected</code> parameter. Only one row can be selected at a time. Use the buttons to programmatically change the selection.</p>
    </Description>
    <Content>
        <div style="display:flex; gap:0.5rem; margin-bottom:1rem;">
            <button @onclick="() => _twoWaySingleSelected = SelectEmployee(1)">Select John Doe</button>
            <button @onclick="() => _twoWaySingleSelected = SelectEmployee(4)">Select Alice Brown</button>
            <button @onclick="() => _twoWaySingleSelected = new string[] { }">Clear Selection</button>
        </div>

        <PggmTable
            FilterLabel="Filter employees"
            ClearLabel="Clear filters"
            Lang="nl"
            IdField="id"
            Selectable="true"
            SelectType="single"
            Data="@employeeData"
            @bind-Selected="_twoWaySingleSelected">

            <PggmTh Sortable="true" Filterable="true" Field="firstName" Width="150" Type="string" Format="string">First Name</PggmTh>
            <PggmTh Sortable="true" Filterable="true" Field="lastName"  Width="150" Type="string" Format="string">Last Name</PggmTh>
            <PggmTh Filterable="true"                 Field="department" Width="200" Type="string" Format="string">Department</PggmTh>
            <PggmTh Sortable="true" Format="currency" Field="salary"    Width="auto" Type="number" TextAlign="right">Annual Salary</PggmTh>
        </PggmTable>

        @if (_twoWaySingleSelected.Length > 0)
        {
            <p style="margin-top:.5rem;">Selected employee ID: <strong>@_twoWaySingleSelected[0]</strong></p>
            <p style="font-size:0.9rem; color:#666;">Selection can be updated by clicking a row in the table or using the buttons above.</p>
        }
    </Content>
</DemoSection>

<PggmHeading Level="2">Remote Data</PggmHeading>

<DemoSection Title="Simple Remote Mode" Code="@_remoteSimpleCode">
    <Description>
        <p>Data fetched automatically from a remote endpoint using <code>Remote="simple"</code>. The response must be a plain JSON array.</p>
    </Description>
    <Content>
        <PggmTable
            RemoteUrl="https://jsonplaceholder.typicode.com/users"
            Remote="simple"
            FilterLabel="Filter users"
            ClearLabel="Clear filters"
            Lang="en"
            IdField="id"
            Selectable="true"
            SelectType="multiple">

            <PggmTh Field="name"         Type="string" Sortable="true"  Filterable="true" Width="200">Name</PggmTh>
            <PggmTh Field="email"        Type="string"                  Filterable="true" Width="250">Email</PggmTh>
            <PggmTh Field="address.city" Type="string"                  Filterable="true" Width="150">City</PggmTh>
            <PggmTh Field="company.name" Type="string"                  Filterable="true" Width="200">Company</PggmTh>
        </PggmTable>
    </Content>
</DemoSection>

<DemoSection Title="Cursor Remote Mode">
    <Description>
        <p>Cursor-based pagination — not yet wired to a live endpoint. Uncomment the table markup to use it.</p>
    </Description>
    <Content>
        <p><em>Currently commented out — replace the URL with a real cursor-based API.</em></p>
        @*
        <PggmTable
            RemoteUrl="https://api.example.com/employees"
            Remote="cursor"
            FilterLabel="Filter employees"
            ClearLabel="Clear filters"
            Lang="nl"
            IdField="employeeId"
            Selectable="true"
            SelectType="single">
            <PggmTh Field="firstName"  Type="string" Sortable="true" Filterable="true">First Name</PggmTh>
            <PggmTh Field="lastName"   Type="string" Sortable="true" Filterable="true">Last Name</PggmTh>
            <PggmTh Field="department" Type="string"                 Filterable="true">Department</PggmTh>
        </PggmTable>
        *@
    </Content>
</DemoSection>

<DemoSection Title="Offset Remote Mode">
    <Description>
        <p>Offset-based pagination — not yet wired to a live endpoint. Uncomment the table markup to use it.</p>
    </Description>
    <Content>
        <p><em>Currently commented out — replace the URL with a real offset-based API.</em></p>
        @*
        <PggmTable
            RemoteUrl="https://api.example.com/products"
            Remote="offset"
            FilterLabel="Filter products"
            ClearLabel="Clear filters"
            Lang="en"
            IdField="productId"
            Selectable="true"
            SelectType="multiple">
            <PggmTh Field="name"     Type="string" Sortable="true" Filterable="true">Product Name</PggmTh>
            <PggmTh Field="price"    Type="number" Format="currency" Sortable="true" TextAlign="right">Price</PggmTh>
            <PggmTh Field="category" Type="string"                  Filterable="true">Category</PggmTh>
        </PggmTable>
        *@
    </Content>
</DemoSection>

