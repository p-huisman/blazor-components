@page "/pggm-datagrid-resizable-columns"
@using Pggm.Components.Components.PggmDataGrid

<PageTitle>PGGM DataGrid — Resizable Columns</PageTitle>

<PggmHeading Level="1">PGGM DataGrid - Resizable Columns</PggmHeading>

<p>
    Setting <code>ResizableColumns="true"</code> on <code>PggmDataGrid</code> adds a drag handle
    to every column header. Columns can also be made resizable individually by setting
    <code>Resizable="true"</code> on a specific column while leaving the grid-level flag off.
    The <code>MinWidth</code> parameter (default <code>50px</code>) prevents a column from being
    dragged narrower than the specified value.
</p>

<DemoSection Title="All columns resizable" Code="@_allSource">
    <PggmDataGrid TGridItem="Employee" Items="@_employees.AsQueryable()" ResizableColumns="true">
        <PropertyColumn Title="Name" Property="@(x => x.Name)"
                        MinWidth="180px" />
        <PropertyColumn Title="Department" Property="@(x => x.Department)"
                        MinWidth="80px" />
        <PropertyColumn Title="Location" Property="@(x => x.Location)"
                        MinWidth="120px" />
        <PropertyColumn Title="Role" Property="@(x => x.Role)"
                        MinWidth="120px" />
        <PropertyColumn Title="Salary" Property="@(x => x.Salary)"
                        Width="120px" MinWidth="80px" Alignment="Pggm.Components.Components.PggmDataGrid.ColumnAlignment.Right" />
    </PggmDataGrid>
</DemoSection>

<DemoSection Title="Per-column resize" Code="@_perColumnSource">
    <p>Only the <strong>Name</strong> and <strong>Department</strong> columns are resizable here.</p>
    <PggmDataGrid TGridItem="Employee" Items="@_employees.AsQueryable()">
        <PropertyColumn Title="Name" Property="@(x => x.Name)"
                        Resizable="true" MinWidth="180px" />
        <PropertyColumn Title="Department" Property="@(x => x.Department)"
                        Resizable="true" MinWidth="80px" />
        <PropertyColumn Title="Location" Property="@(x => x.Location)"
                        Width="140px" />
        <PropertyColumn Title="Role" Property="@(x => x.Role)"
                        Width="140px" />
        <PropertyColumn Title="Salary" Property="@(x => x.Salary)"
                        Width="120px" Alignment="Pggm.Components.Components.PggmDataGrid.ColumnAlignment.Right" />
    </PggmDataGrid>
</DemoSection>

<DemoSection Title="Resizable + sortable" Code="@_sortSource">
    <PggmDataGrid TGridItem="Employee" Items="@_employees.AsQueryable()" ResizableColumns="true">
        <PropertyColumn Title="Name" Property="@(x => x.Name)"
                        Sortable="true" IsDefaultSortColumn="true" />
        <PropertyColumn Title="Department" Property="@(x => x.Department)"
                        Sortable="true" />
        <PropertyColumn Title="Location" Property="@(x => x.Location)"
                        Sortable="true" />
        <PropertyColumn Title="Role" Property="@(x => x.Role)"
                        Sortable="true" />
        <PropertyColumn Title="Salary" Property="@(x => x.Salary)"
                        Sortable="true" Width="120px"
                        Alignment="Pggm.Components.Components.PggmDataGrid.ColumnAlignment.Right" />
    </PggmDataGrid>
</DemoSection>

@code {
    private sealed record Employee(string Name, string Department, string Location, string Role, decimal Salary);

    private static readonly List<Employee> _employees =
    [
        new("Alice Jansen", "Engineering", "Amsterdam", "Senior Engineer", 95_000m),
        new("Bob de Vries", "Engineering", "Rotterdam", "Engineer", 75_000m),
        new("Carla Smit", "Product", "Amsterdam", "Product Manager", 90_000m),
        new("David Bakker", "Design", "Utrecht", "UX Designer", 72_000m),
        new("Eva Mulder", "Engineering", "Den Haag", "Tech Lead", 110_000m),
        new("Frank Visser", "HR", "Amsterdam", "HR Business Partner",68_000m),
        new("Greta Linden", "Finance", "Rotterdam", "Financial Analyst", 80_000m),
        new("Hans Peters", "Engineering", "Eindhoven", "Junior Engineer", 58_000m),
        new("Iris Groot", "Product", "Amsterdam", "Product Owner", 88_000m),
        new("Jan Willems", "Design", "Utrecht", "Visual Designer", 65_000m),
        new("Karen van Dam", "Engineering", "Amsterdam", "Staff Engineer", 120_000m),
        new("Lars Hoekstra", "Marketing", "Rotterdam", "Marketing Manager", 82_000m),
    ];

    private readonly string _allSource = Pggm.Components.Sample.Utilities.SnippetBuilder.Build(
        "<PggmDataGrid Items=\"@_employees.AsQueryable()\" ResizableColumns=\"true\">",
        "    <PropertyColumn Title=\"Name\"       Property=\"@(x => x.Name)\"       MinWidth=\"80px\" />",
        "    <PropertyColumn Title=\"Department\" Property=\"@(x => x.Department)\"  MinWidth=\"80px\" />",
        "    <PropertyColumn Title=\"Location\"   Property=\"@(x => x.Location)\"    MinWidth=\"60px\" />",
        "    <PropertyColumn Title=\"Role\"       Property=\"@(x => x.Role)\"        MinWidth=\"60px\" />",
        "    <PropertyColumn Title=\"Salary\"     Property=\"@(x => x.Salary)\"      Width=\"120px\" MinWidth=\"80px\" />",
        "</PggmDataGrid>");

    private readonly string _perColumnSource = Pggm.Components.Sample.Utilities.SnippetBuilder.Build(
        "<!-- Resizable=\"true\" on individual columns; grid-level flag stays false -->",
        "<PggmDataGrid Items=\"@_employees.AsQueryable()\">",
        "    <PropertyColumn Title=\"Name\"       Property=\"@(x => x.Name)\"       Resizable=\"true\" MinWidth=\"80px\" />",
        "    <PropertyColumn Title=\"Department\" Property=\"@(x => x.Department)\"  Resizable=\"true\" MinWidth=\"80px\" />",
        "    <PropertyColumn Title=\"Location\"   Property=\"@(x => x.Location)\"    Width=\"140px\" />",
        "    <PropertyColumn Title=\"Role\"       Property=\"@(x => x.Role)\"        Width=\"140px\" />",
        "    <PropertyColumn Title=\"Salary\"     Property=\"@(x => x.Salary)\"      Width=\"120px\" />",
        "</PggmDataGrid>");

    private readonly string _sortSource = Pggm.Components.Sample.Utilities.SnippetBuilder.Build(
        "<!-- ResizableColumns and sortable columns can be combined freely -->",
        "<PggmDataGrid Items=\"@_employees.AsQueryable()\" ResizableColumns=\"true\">",
        "    <PropertyColumn Title=\"Name\"       Property=\"@(x => x.Name)\"",
        "                    Sortable=\"true\"       IsDefaultSortColumn=\"true\" />",
"    <PropertyColumn Title=\"Department\" Property=\"@(x => x.Department)\"",
"                    Sortable=\"true\"  />",
        "    <!-- ... remaining columns ... -->",
        "</PggmDataGrid>");
}
