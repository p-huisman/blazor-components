@page "/pggm-datagrid-filtering"
@using System.Linq
@using Pggm.Components.Components.PggmDataGrid
@inject IJSRuntime JS

<PageTitle>PGGM DataGrid — Filtering</PageTitle>

<PggmHeading Level="1">PGGM DataGrid — Column Filtering</PggmHeading>

<DemoSection Title="Column Filtering" Code="@_source">
    <p>Enable <code>EnableColumnFiltering</code> and mark columns as <code>Filterable</code>. Set <code>FilterType</code> to <code>FilterType.Number</code> or <code>FilterType.Date</code> for numeric and date columns.</p>

    <PggmDataGrid TGridItem="Person" Items="@People.AsQueryable()" EnableColumnFiltering="true">
        <PropertyColumn TGridItem="Person" TProp="string" Title="Name" Value="@(p => p.Name)" SortByExpression="@(p => p.Name)" FilterByExpression="@(p => p.Name)" Filterable="true" FilterType="FilterType.String" Field="Name" Index="1" />
        <PropertyColumn TGridItem="Person" TProp="int" Title="Age" Value="@(p => p.Age)" SortByExpression="@(p => p.Age)" FilterByExpression="@(p => p.Age)" Filterable="true" FilterType="FilterType.Number" Field="Age" Index="2" />
        <PropertyColumn TGridItem="Person" TProp="DateOnly" Title="Date of Birth" Value="@(p => p.DateOfBirth)" SortByExpression="@(p => p.DateOfBirth)" FilterByExpression="@(p => p.DateOfBirth)" Filterable="true" FilterType="FilterType.Date" Field="DateOfBirth" Index="3" />
    </PggmDataGrid>
</DemoSection>

@code {
    private List<Person> People = new()
    {
        new Person { Name = "Alice",  Age = 30, DateOfBirth = new DateOnly(1995, 3, 14) },
        new Person { Name = "Bob",    Age = 42, DateOfBirth = new DateOnly(1983, 7, 22) },
        new Person { Name = "Carol",  Age = 27, DateOfBirth = new DateOnly(1998, 11, 5) },
        new Person { Name = "David",  Age = 35, DateOfBirth = new DateOnly(1990, 1, 30) },
        new Person { Name = "Eve",    Age = 29, DateOfBirth = new DateOnly(1996, 6, 18) },
        new Person { Name = "Frank",  Age = 48, DateOfBirth = new DateOnly(1977, 9, 3)  },
        new Person { Name = "Grace",  Age = 33, DateOfBirth = new DateOnly(1992, 4, 25) },
        new Person { Name = "Heidi",  Age = 25, DateOfBirth = new DateOnly(2000, 12, 8) },
        new Person { Name = "Ivan",   Age = 52, DateOfBirth = new DateOnly(1973, 2, 17) },
        new Person { Name = "Judy",   Age = 38, DateOfBirth = new DateOnly(1987, 8, 11) }
    };

    private string _source = Pggm.Components.Sample.Utilities.SnippetBuilder.Build(
        "<PggmDataGrid TGridItem=\"Person\" Items=\"@People.AsQueryable()\" EnableColumnFiltering=\"true\">",
        "    <PropertyColumn TGridItem=\"Person\" TProp=\"string\" Title=\"Name\" Value=\"@(p => p.Name)\" FilterByExpression=\"@(p => p.Name)\" Filterable=\"true\" FilterType=\"FilterType.String\" Field=\"Name\" Index=\"1\" />",
        "    <PropertyColumn TGridItem=\"Person\" TProp=\"int\" Title=\"Age\" Value=\"@(p => p.Age)\" FilterByExpression=\"@(p => p.Age)\" Filterable=\"true\" FilterType=\"FilterType.Number\" Field=\"Age\" Index=\"2\" />",
        "    <PropertyColumn TGridItem=\"Person\" TProp=\"DateOnly\" Title=\"Date of Birth\" Value=\"@(p => p.DateOfBirth)\" FilterByExpression=\"@(p => p.DateOfBirth)\" Filterable=\"true\" FilterType=\"FilterType.Date\" Field=\"DateOfBirth\" Index=\"3\" />",
        "</PggmDataGrid>");

    private class Person
    {
        public string? Name { get; set; }
        public int Age { get; set; }
        public DateOnly DateOfBirth { get; set; }
    }
}
