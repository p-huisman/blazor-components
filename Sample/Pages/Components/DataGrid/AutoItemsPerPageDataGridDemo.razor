@page "/pggm-datagrid-auto-items-per-page"
@using Pggm.Components.Components.PggmDataGrid
@using Pggm.Components.Enums

<PageTitle>DataGrid Auto Items Per Page Demo</PageTitle>

<PggmHeading Level="1">PGGM DataGrid - Auto Items Per Page</PggmHeading>

<p>
    Setting <code>AutoItemsPerPage="true"</code> on <code>PggmDataGrid</code> automatically adjusts
    the number of rows displayed per page to fill the available vertical space. Resize the browser
    window vertically to see the page size adapt in real time.
</p>
<p>
    This requires a <code>Pagination</code> state and a container with a CSS-constrained height
    (e.g. the page's <code>main</code> scroll area). Use <code>AutoItemsPerPageRowHeight</code>
    (default <code>40</code>) to match your actual row height in pixels.
</p>

<DemoSection Title="Auto Items Per Page" Code="@_source">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
        <span>
            Showing page <strong>@(_pagination.PageIndex + 1)</strong> &nbsp;·&nbsp;
            <strong>@_pagination.PageSize</strong> rows per page
            (auto-calculated from available height)
        </span>
        <div style="display: flex; gap: 8px;">
            <button class="pggm-btn" @onclick="PrevPage" disabled="@(_pagination.PageIndex == 0)">← Prev</button>
            <button class="pggm-btn" @onclick="NextPage" disabled="@(!HasNextPage)">Next →</button>
        </div>
    </div>

    <PggmDataGrid @ref="_grid"
                  TGridItem="Employee"
                  Items="@_employees.AsQueryable()"
                  Pagination="_pagination"
                  AutoItemsPerPage="true"
                  AutoItemsPerPageRowHeight="41"
                  OnAutoItemsPerPageChanged="@(_ => StateHasChanged())">
        <PropertyColumn TGridItem="Employee" TProp="string"  Title="Name"       Property="@(x => x.Name)"       Index="0" Sortable="true" IsDefaultSortColumn="true" />
        <PropertyColumn TGridItem="Employee" TProp="string"  Title="Department" Property="@(x => x.Department)"  Index="1" Sortable="true" />
        <PropertyColumn TGridItem="Employee" TProp="string"  Title="Location"   Property="@(x => x.Location)"    Index="2" Sortable="true" />
        <PropertyColumn TGridItem="Employee" TProp="string"  Title="Role"       Property="@(x => x.Role)"        Index="3" />
        <PropertyColumn TGridItem="Employee" TProp="decimal" Title="Salary"     Property="@(x => x.Salary)"
                        Index="4" Width="120px"
                        Alignment="Pggm.Components.Components.PggmDataGrid.ColumnAlignment.Right" />
    </PggmDataGrid>
</DemoSection>

<DemoSection Title="Auto Items Per Page inside a Vertical Splitter" Code="@_splitterSource">
    <p>
        The grid sits inside the <strong>bottom panel</strong> of a vertical splitter. Because the
        panel is wrapped in a <code>div</code> with <code>overflow-y: auto; height: 100%</code>, the
        JS observer tracks <em>that panel's height</em> instead of the full page scroll area. Drag
        the splitter divider up or down — the page size adapts automatically.
    </p>
    <div style="height: 500px; border: 1px solid var(--color-border, #ccc); border-radius: 4px; overflow: hidden;">
        <PggmSplitter Orientation="SplitterOrientation.Vertical" @bind-Position="_splitterPos" style="height: 100%;">
            <StartContent>
                @* Flex column so the grid fills the remaining height after the toolbar.
                   min-height:0 prevents the flex child from overflowing its panel. *@
                <div style="display: flex; flex-direction: column; height: 100%;">
                    
                    @* overflow-y:auto + flex:1 + min-height:0 gives this div a finite height
                       that the ResizeObserver can track as the splitter is dragged. *@
                    <div style="flex: 1; min-height: 0; overflow-y: auto;">
                        <PggmDataGrid @ref="_splitterGrid"
                                      TGridItem="Employee"
                                      Items="@_employees.AsQueryable()"
                                      SingleSelect="true"
                                      Pagination="@_splitterPagination"
                                      AutoItemsPerPage="true"
                                      AutoItemsPerPageRowHeight="41"
                                      OnAutoItemsPerPageChanged="@(_ => StateHasChanged())"
                                      SelectedItemsChangedCallback="@EventCallback.Factory.Create(this, StateHasChanged)">
                            <SelectColumn TGridItem="Employee" Index="0" />
                            <PropertyColumn TGridItem="Employee" TProp="string"  Title="Name"       Property="@(x => x.Name)"       Index="1" Sortable="true" IsDefaultSortColumn="true" />
                            <PropertyColumn TGridItem="Employee" TProp="string"  Title="Department" Property="@(x => x.Department)"  Index="2" />
                            <PropertyColumn TGridItem="Employee" TProp="string"  Title="Location"   Property="@(x => x.Location)"    Index="3" />
                            <PropertyColumn TGridItem="Employee" TProp="string"  Title="Role"       Property="@(x => x.Role)"        Index="4" />
                            <PropertyColumn TGridItem="Employee" TProp="decimal" Title="Salary"     Property="@(x => x.Salary)"
                                            Index="5" Width="120px"
                                            Alignment="Pggm.Components.Components.PggmDataGrid.ColumnAlignment.Right" />
                        </PggmDataGrid>
                    </div>
                    <PggmPaginator State="@_splitterPagination" NumericNavigation="true" />
                </div>
            </StartContent>
            <EndContent>
                <div style="padding: 1rem; overflow-y: auto; height: 100%; box-sizing: border-box;">
                    <PggmHeading Level="3">Top panel</PggmHeading>

                    @if (_splitterGrid?.SelectedItems?.Any() == true)
                    {
                        <span>@_splitterGrid.SelectedItems.First().Name</span>
                    }
                    else
                    {
                        <span>None</span>
                    }
                    
                    <p>This panel can hold any content — a form, a detail view, etc.</p>
                    <p>Drag the horizontal divider to shrink or grow the bottom panel and watch the row count change.</p>
                </div>
                
            </EndContent>
        </PggmSplitter>
    </div>
</DemoSection>

@code {
