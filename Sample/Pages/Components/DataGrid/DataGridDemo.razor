			"    <select @onchange=\"OnPageSizeChanged\" value=\"@_pagerState.PageSize\">",
			"        <option value=\"2\">2</option> <option value=\"5\">5</option>",
			"        <option value=\"10\">10</option> <option value=\"20\">20</option>",
			"    </select>",
			"</div>",
			"",
			"<PggmDataGrid @ref=\"_pagerGrid\" TGridItem=\"Person\" ItemsProvider=\"@LoadPeopleAsync\" Pagination=\"_pagerState\">",
			"    <SelectColumn TGridItem=\"Person\" Index=\"0\" />",
			"    <PropertyColumn TGridItem=\"Person\" TProp=\"string\" Title=\"Name\" Value=\"@(p => p.Name)\" SortByExpression=\"@(p => p.Name)\" Index=\"1\" />",
			"    <PropertyColumn TGridItem=\"Person\" TProp=\"int\" Title=\"Age\" Value=\"@(p => p.Age)\" SortByExpression=\"@(p => p.Age)\" Index=\"2\" />",
			"</PggmDataGrid>");

		private string paginationBehind = Pggm.Components.Sample.Utilities.SnippetBuilder.Build(
			"private PaginationState _pagerState = new() { PageIndex = 0, PageSize = 2 };",
			"private PggmDataGrid<Person>? _pagerGrid;",
			"",
			"private int _pagerTotalPagesComputed =>",
			"    Math.Max(1, (int)Math.Ceiling((double)(_pagerGrid?.TotalItemCount ?? People.Count) / _pagerState.PageSize));",
			"",
			"private async Task _pagerNext() { _pagerState.PageIndex++; await _pagerGrid?.SetPageAsync(_pagerState.PageIndex); }",
			"private async Task _pagerPrev() { _pagerState.PageIndex--; await _pagerGrid?.SetPageAsync(_pagerState.PageIndex); }",
			"private async Task _pagerFirst() { _pagerState.PageIndex = 0; await _pagerGrid?.SetPageAsync(0); }",
			"private async Task _pagerLast() { _pagerState.PageIndex = _pagerTotalPagesComputed - 1; await _pagerGrid?.SetPageAsync(_pagerState.PageIndex); }",
			"",
			"private async Task OnPageNumberChanged(ChangeEventArgs e) { /* parse e.Value, clamp, SetPageAsync */ }",
			"private async Task OnPageSizeChanged(ChangeEventArgs e)  { /* parse e.Value, SetPageSizeAsync */ }");

	private PggmDataGrid<Person>? _multiGrid;
	private PggmDataGrid<Person>? _singleGrid;
	private PggmDataGrid<Person>? _progGrid;
	private PggmDataGrid<Person>? _codeSelectGrid;
	private PggmDataGrid<Person>? _initialSelectGrid;

	private IEnumerable<Person> _initialSelection => People.Where(p => p.Name == "Alice" || p.Name == "Carol");

	private string initialSelectionSource = Pggm.Components.Sample.Utilities.SnippetBuilder.Build(
		"<PggmDataGrid TGridItem=\"Person\" Items=\"@People.AsQueryable()\" @ref=\"_initialSelectGrid\"",
		"              SelectedItemsChangedCallback=\"@(()=>StateHasChanged())\">",
		"    <SelectColumn TGridItem=\"Person\" Index=\"0\" SelectedItems=\"@_initialSelection\" />",
		"    <PropertyColumn TGridItem=\"Person\" TProp=\"string\" Title=\"Name\" Value=\"@(p => p.Name)\" Index=\"1\" />",
		"    <PropertyColumn TGridItem=\"Person\" TProp=\"int\" Title=\"Age\" Value=\"@(p => p.Age)\" Index=\"2\" />",
		"</PggmDataGrid>");

	private string initialSelectionBehind = Pggm.Components.Sample.Utilities.SnippetBuilder.Build(
		"private PggmDataGrid<Person>? _initialSelectGrid;",
		"",
		"private IEnumerable<Person> _initialSelection =>",
		"    People.Where(p => p.Name == \"Alice\" || p.Name == \"Carol\");");

	private async Task SelectAliceAsync()
	{
		var item = People.FirstOrDefault(p => p.Name == "Alice");
		if (item is not null && _codeSelectGrid is not null)
			await _codeSelectGrid.SetSelectedItemsAsync(new[] { item });
	}

	private async Task SelectAliceAndBobAsync()
	{
		var items = People.Where(p => p.Name == "Alice" || p.Name == "Bob").ToArray();
		if (_codeSelectGrid is not null)
			await _codeSelectGrid.SetSelectedItemsAsync(items);
	}

	private async Task SelectByNameAsync(string name)
	{
		var item = People.FirstOrDefault(p => p.Name == name);
		if (item is not null && _codeSelectGrid is not null)
			await _codeSelectGrid.SetSelectedItemsAsync(new[] { item });
	}

	private async Task ClearCodeSelectionAsync()
	{
		if (_codeSelectGrid is not null)
			await _codeSelectGrid.SetSelectedItemsAsync(null);
	}

	private string programmaticSelectionSource = Pggm.Components.Sample.Utilities.SnippetBuilder.Build(
		"<div class=\"demo-toolbar\" style=\"display:flex; gap:8px;\">",
		"    <button class=\"pggm-btn\" @onclick=\"SelectAliceAsync\">Select Alice</button>",
		"    <button class=\"pggm-btn\" @onclick=\"SelectAliceAndBobAsync\">Select Alice &amp; Bob</button>",
		"    <button class=\"pggm-btn\" @onclick='() => SelectByNameAsync(\"Frank\")'>Select Frank</button>",
		"    <button class=\"pggm-btn\" @onclick=\"ClearCodeSelectionAsync\">Clear</button>",
		"</div>",
		"",
		"<PggmDataGrid TGridItem=\"Person\" Items=\"@People.AsQueryable()\" @ref=\"_codeSelectGrid\"",
		"              SelectedItemsChangedCallback=\"@(()=>StateHasChanged())\">",
		"    <SelectColumn TGridItem=\"Person\" Index=\"0\" />",
		"    <PropertyColumn TGridItem=\"Person\" TProp=\"string\" Title=\"Name\" Value=\"@(p => p.Name)\" Index=\"1\" />",
		"    <PropertyColumn TGridItem=\"Person\" TProp=\"int\" Title=\"Age\" Value=\"@(p => p.Age)\" Index=\"2\" />",
		"</PggmDataGrid>");

	private string programmaticSelectionBehind = Pggm.Components.Sample.Utilities.SnippetBuilder.Build(
		"private PggmDataGrid<Person>? _codeSelectGrid;",
		"",
		"private async Task SelectAliceAsync()",
		"{",
		"    var item = People.FirstOrDefault(p => p.Name == \"Alice\");",
		"    if (item is not null && _codeSelectGrid is not null)",
		"        await _codeSelectGrid.SetSelectedItemsAsync(new[] { item });",
		"}",
		"",
		"private async Task SelectAliceAndBobAsync()",
		"{",
		"    var items = People.Where(p => p.Name == \"Alice\" || p.Name == \"Bob\").ToArray();",
		"    if (_codeSelectGrid is not null)",
		"        await _codeSelectGrid.SetSelectedItemsAsync(items);",
		"}",
		"",
		"private async Task SelectByNameAsync(string name)",
		"{",
		"    var item = People.FirstOrDefault(p => p.Name == name);",
		"    if (item is not null && _codeSelectGrid is not null)",
		"        await _codeSelectGrid.SetSelectedItemsAsync(new[] { item });",
		"}",
		"",
		"private async Task ClearCodeSelectionAsync()",
		"{",
		"    if (_codeSelectGrid is not null)",
		"        await _codeSelectGrid.SetSelectedItemsAsync(null);",
		"}");

    private Task SortByAgeDesc() => _progGrid?.SetSortAsync(2, false) ?? Task.CompletedTask;
    private Task SortByNameAsc() => _progGrid?.SetSortAsync("Name", true) ?? Task.CompletedTask;
    private Task ClearSort() => _progGrid?.ClearSortAsync() ?? Task.CompletedTask;

	// Pagination demo state
	private PaginationState _pagerState = new PaginationState { PageIndex = 0, PageSize = 2 };
	private int _pagerIndex => _pagerState.PageIndex;
	private int _pagerTotalPages => (int)Math.Ceiling((double)People.Count / _pagerState.PageSize);

	private async Task _pagerNext()
	{
		if (_pagerState.PageIndex + 1 < _pagerTotalPages)
		{
			_pagerState.PageIndex++;
			if (_pagerGrid is not null)
			{
				await _pagerGrid.SetPageAsync(_pagerState.PageIndex);
			}
		}
	}

	private async Task _pagerPrev()
	{
		if (_pagerState.PageIndex > 0)
		{
			_pagerState.PageIndex--;
			if (_pagerGrid is not null)
			{
				await _pagerGrid.SetPageAsync(_pagerState.PageIndex);
			}
		}
	}

	private async Task _pagerFirst()
	{
		if (_pagerState.PageIndex > 0)
		{
			_pagerState.PageIndex = 0;
			if (_pagerGrid is not null)
			{
				await _pagerGrid.SetPageAsync(0);
			}
		}
	}

	private async Task _pagerLast()
	{
		var last = Math.Max(0, _pagerTotalPagesComputed - 1);
		if (_pagerState.PageIndex < last)
		{
			_pagerState.PageIndex = last;
			if (_pagerGrid is not null)
			{
				await _pagerGrid.SetPageAsync(last);
			}
		}
	}

	private PggmDataGrid<Person>? _pagerGrid;

	private int _pagerTotalPagesComputed =>
		Math.Max(1, (int)Math.Ceiling((double)(_pagerGrid?.TotalItemCount ?? People.Count) / _pagerState.PageSize));

	protected override async Task OnInitializedAsync()
	{
		// restore saved page size from localStorage if present
		try
		{
			var saved = await JS.InvokeAsync<string>("localStorage.getItem", "pggm-demo-page-size");
			if (!string.IsNullOrWhiteSpace(saved) && int.TryParse(saved, out var s))
			{
				_pagerState.PageSize = Math.Max(1, s);
			}
		}
		catch
		{
			// ignore JS errors in sample
		}
	}

	private async Task OnPageNumberChanged(ChangeEventArgs e)
	{
		if (e?.Value is null) return;
		if (!int.TryParse(e.Value.ToString(), out var val)) return;
		var page = Math.Clamp(val - 1, 0, _pagerTotalPagesComputed - 1);
		_pagerState.PageIndex = page;
		if (_pagerGrid is not null)
		{
			await _pagerGrid.SetPageAsync(page);
		}
	}

	private async Task OnPageSizeChanged(ChangeEventArgs e)
	{
		if (e?.Value is null) return;
		if (!int.TryParse(e.Value.ToString(), out var size)) return;
		size = Math.Max(1, size);
		_pagerState.PageSize = size;
		_pagerState.PageIndex = 0;
		try
		{
			await JS.InvokeVoidAsync("localStorage.setItem", "pggm-demo-page-size", size.ToString());
		}
		catch
		{
			// ignore
		}
		if (_pagerGrid is not null)
		{
			await _pagerGrid.SetPageSizeAsync(size);
		}
	}
}

