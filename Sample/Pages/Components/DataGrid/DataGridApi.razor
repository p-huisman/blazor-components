@page "/pggm-data-grid-api"

@using Pggm.Components.Sample.Components.ApiDocumentation

<PageTitle>PGGM DataGrid API</PageTitle>

<PggmHeading Level="1">PGGM DataGrid - API Reference</PggmHeading>

<p>Complete API reference for the <code>PggmDataGrid&lt;TGridItem&gt;</code> component and its supporting types.</p>

<hr />

<PggmHeading Level="2">PggmDataGrid&lt;TGridItem&gt;</PggmHeading>
<p>
    Generic Blazor data grid component. Tag: <code>pggm-data-grid</code>.<br />
    Inherits from <code>PggmComponentBase</code>. Implements <code>IAsyncDisposable</code>.
</p>

<ApiDocumentation
    Properties="_gridParameters"
    PublicProperties="_gridPublicProperties"
    Events="_gridEvents"
    Methods="_gridMethods" />

<hr />

<PggmHeading Level="2">Column Types</PggmHeading>

<PggmHeading Level="3">ColumnBase&lt;TGridItem&gt;</PggmHeading>
<p>Abstract base class for all column types. All concrete column types inherit these parameters.</p>
<ApiDocumentation Properties="_columnBaseParameters" />

<PggmHeading Level="3">TemplateColumn&lt;TGridItem&gt;</PggmHeading>
<p>Concrete column with a free-form cell content template. Inherits all <code>ColumnBase</code> parameters.</p>
<ApiDocumentation Properties="_templateColumnParameters" />

<PggmHeading Level="3">SelectColumn&lt;TGridItem&gt;</PggmHeading>
<p>
    Renders a checkbox (multi-select) or radio button (<code>SingleSelect</code>) per row.
    Inherits all <code>ColumnBase</code> parameters.
</p>
<ApiDocumentation Properties="_selectColumnParameters" />

<hr />

<PggmHeading Level="2">Supporting Types</PggmHeading>

<PggmHeading Level="3">PaginationState</PggmHeading>
<p>
    Shared state object that connects a <code>PggmDataGrid</code> to a <code>PggmPaginator</code>.
    Create one instance per grid/paginator pair and pass it to both components via <code>Pagination</code>.
</p>
<ApiDocumentation
    PublicProperties="_paginationStateProperties"
    Methods="_paginationStateMethods"
    Events="_paginationStateEvents" />

<PggmHeading Level="3">GridItemsProviderRequest&lt;TGridItem&gt;</PggmHeading>
<p>
    Passed as the argument to an <code>ItemsProvider</code> delegate. Contains the current page window,
    sort state, and a cancellation token.
</p>
<ApiDocumentation
    PublicProperties="_providerRequestProperties"
    Methods="_providerRequestMethods" />

<PggmHeading Level="3">GridItemsProviderResult&lt;TGridItem&gt;</PggmHeading>
<p>Return value from an <code>ItemsProvider</code> delegate. Use the static <code>From</code> factory method to create an instance.</p>
<ApiDocumentation PublicProperties="_providerResultProperties" Methods="_providerResultMethods" />

<PggmHeading Level="3">GridSort&lt;TGridItem&gt;</PggmHeading>
<p>
    Builds a composable, expression-based sort descriptor. Assign an instance to
    <code>ColumnBase.SortBy</code> to enable sorting for that column.
</p>
<ApiDocumentation Methods="_gridSortMethods" />

<PggmHeading Level="3">IHierarchicalGridItem</PggmHeading>
<p>
    Interface that grid items must implement (or inherit via <code>HierarchicalGridItem&lt;TItem,TGridItem&gt;</code>)
    to enable tree-style row expansion.
</p>
<ApiDocumentation PublicProperties="_hierarchicalItemProperties" />

<PggmHeading Level="3">HierarchicalGridItem&lt;TItem, TGridItem&gt;</PggmHeading>
<p>
    Ready-made base class that implements <code>IHierarchicalGridItem</code>. Wrap your business data type
    in a class that derives from this to enable hierarchical rows.
</p>
<ApiDocumentation PublicProperties="_hierarchicalGridItemProperties" />

