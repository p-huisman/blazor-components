@page "/pggm-link"
@using Pggm.Components.Sample.Components.ApiDocumentation

<PageTitle>PGGM Link</PageTitle>

<PggmHeading Level="1">PGGM Link</PggmHeading>

<p>This page demonstrates the PGGM Link component with various configurations and use cases.</p>

<DemoSection Title="Basic Link (Inline)" Code="@basicLinkSource">
    <p>
        This is a paragraph with an 
        <PggmLink Href="https://www.pggm.nl" Target="_blank">inline link</PggmLink>
        that doesn't use the standalone attribute.
    </p>
</DemoSection>

<DemoSection Title="Standalone Link (With Chevron Icon)" Code="@standaloneLinkSource">
    <PggmLink Href="https://www.pggm.nl" Target="_blank" Standalone="true">
        Visit PGGM Website
    </PggmLink>
</DemoSection>

<DemoSection Title="Links with Different Targets" Code="@differentTargetsSource">    
    <PggmStack>
        <PggmLink Href="https://www.pggm.nl" Target="_blank" Standalone="true">
            External Link (New Tab)
        </PggmLink>
        
        <PggmLink Href="/components" Standalone="true">
            Internal Link (Same Tab)
        </PggmLink>
        
        <PggmLink Href="mailto:contact@pggm.nl" Standalone="true">
            Email Link
        </PggmLink>
        
        <PggmLink Href="tel:+31123456789" Standalone="true">
            Phone Link
        </PggmLink>
    </PggmStack>
</DemoSection>

<DemoSection Title="Additional Link Attributes" Code="@additionalAttributesSource">
    
    <PggmStack>
        <PggmLink Href="https://www.pggm.nl" 
                  Target="_blank" 
                  Rel="noopener noreferrer"
                  Standalone="true">
            Secure External Link
        </PggmLink>
        
        <PggmLink Href="/downloads/document.pdf" 
                  Type="application/pdf"
                  Standalone="true">
            PDF Download
        </PggmLink>
    </PggmStack>
</DemoSection>
    
<DemoSection Title="Mixed Content Example" Code="@mixedContentSource">
    <p>
        You can use both inline links like <PggmLink Href="/components">this one</PggmLink> 
        and standalone links in the same content area:
    </p>
    
    <PggmLink Href="https://docs.microsoft.com/en-us/aspnet/core/blazor/" 
              Target="_blank" 
              Rel="noopener noreferrer"
              Standalone="true">
        Learn More About Blazor
    </PggmLink>
</DemoSection>

