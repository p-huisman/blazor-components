@page "/pggm-toolbar"
@namespace Pggm.Components.Sample.Pages.Components
@using Pggm.Components.Components.PggmToolbar
@using Pggm.Components.Sample.Components.ApiDocumentation

<PageTitle>PggmToolbar Demo</PageTitle>

<PggmHeading Level="1">PggmToolbar</PggmHeading>

<p>
    The <code>PggmToolbar</code> component provides a flexible, state-driven toolbar for Blazor applications.
    It supports buttons, dropdowns, checkboxes, toggle button groups, and separators — all configured
    through a single <code>PggmToolbarState</code> object. Each item type exposes event callbacks so you
    can wire up handlers without writing any Razor markup beyond the top-level <code>&lt;PggmToolbar&gt;</code> tag.
</p>

@if (!string.IsNullOrEmpty(lastEventMessage))
{
    <div class="event-feedback">
        <strong>Last event:</strong> @lastEventMessage at @lastEventTime.ToString("HH:mm:ss")
    </div>
}

<DemoSection Title="Basic Toolbar" Code="@basicSource" CodeBehind="@basicBehind">
    <Description>
        <p>A minimal toolbar with four buttons. The <strong>Delete</strong> button is disabled, and every other button logs its click to the event banner above.</p>
    </Description>
    <Content>
        <PggmToolbar State="toolbarState" />
    </Content>
</DemoSection>

<DemoSection Title="Toolbar with Separator, Dropdown, Checkbox and Toggle Group" Code="@advancedSource" CodeBehind="@advancedBehind">
    <Description>
        <p>
            A richer toolbar demonstrating all supported item types:
            <strong>buttons</strong>, <strong>separators</strong>, a <strong>dropdown</strong> menu,
            a <strong>checkbox</strong>, and two <strong>toggle-button groups</strong>
            (single-select <em>View mode</em> and multi-select <em>Filters</em>).
        </p>
    </Description>
    <Content>
        <PggmToolbar State="advancedToolbarState" />
    </Content>
</DemoSection>

<DemoSection Title="Dynamic Visibility" Code="@visibilitySource" CodeBehind="@visibilityBehind">
    <Description>
        <p>
            Every toolbar item has a <code>Visible</code> property (default <code>true</code>) that controls whether it is rendered.
            You can toggle visibility at runtime via <code>SetButtonVisible</code>, <code>RemoveButton</code>, or by mutating the state directly and calling <code>Notify()</code>.
            Individual dropdown items also support <code>Visible</code>.
        </p>
    </Description>
    <Content>
        <PggmToolbar State="visibilityToolbarState" />
        <div class="visibility-controls">
            <PggmButton Appearance="@ButtonAppearance.Secondary" OnClick="ToggleAddVisibility">
                @(addButtonVisible ? "Hide Add" : "Show Add")
            </PggmButton>
            <PggmButton Appearance="@ButtonAppearance.Secondary" OnClick="ToggleEditVisibility">
                @(editButtonVisible ? "Hide Edit" : "Show Edit")
            </PggmButton>
            <PggmButton Appearance="@ButtonAppearance.Secondary" OnClick="ToggleDropdownVisibility">
                @(dropdownVisible ? "Hide Export" : "Show Export")
            </PggmButton>
            <PggmButton Appearance="@ButtonAppearance.Secondary" OnClick="TogglePdfItemVisibility">
                @(pdfItemVisible ? "Hide PDF item" : "Show PDF item")
            </PggmButton>
        </div>
    </Content>
</DemoSection>

<PggmHeading Level="2">API</PggmHeading>

<PggmHeading Level="3">PggmToolbar</PggmHeading>
<ApiDocumentation Properties="toolbarProperties" />

<PggmHeading Level="3">PggmToolbarState</PggmHeading>
<ApiDocumentation Properties="toolbarStateProperties" Methods="toolbarStateMethods" />

<PggmHeading Level="3">PggmToolbarButtonState</PggmHeading>
<ApiDocumentation Properties="buttonStateProperties" />

<PggmHeading Level="3">PggmToolbarDropdownState</PggmHeading>
<ApiDocumentation Properties="dropdownStateProperties" />

<PggmHeading Level="3">PggmToolbarCheckboxState</PggmHeading>
<ApiDocumentation Properties="checkboxStateProperties" />

<PggmHeading Level="3">PggmToolbarToggleButtonGroupState</PggmHeading>
<ApiDocumentation Properties="toggleGroupStateProperties" />

@code {
    private PggmToolbarState toolbarState = new();
    private PggmToolbarState advancedToolbarState = new();
    private PggmToolbarState visibilityToolbarState = new();

    private bool addButtonVisible = true;
    private bool editButtonVisible = true;
    private bool dropdownVisible = true;
    private bool pdfItemVisible = true;

    protected override void OnInitialized()
    {
        toolbarState.AddButton(new PggmToolbarButtonState
        {
            Label = "Add",
            Icon = "circle-plus",
            OnClick = async () => await HandleAdd()
        });

        toolbarState.AddButton(new PggmToolbarButtonState
        {
            Label = "Edit",
            Icon = "edit",
            OnClick = async () => await HandleEdit()
        });

        toolbarState.AddButton(new PggmToolbarButtonState
        {
            Label = "Delete",
            Icon = "trash",
            Disabled = true
        });

        toolbarState.AddButton(new PggmToolbarButtonState
        {
            Label = "Filter",
            Icon = "filter",
            OnClick = async () => await HandleFilter()
        });

        // Advanced toolbar setup
        advancedToolbarState.AddButton(new PggmToolbarButtonState
        {
            Label = "New",
            Icon = "plus",
            OnClick = async () => await HandleNew()
        });

        advancedToolbarState.AddButton(new PggmToolbarButtonState
        {
            Label = "Save",
            Icon = "flopy",
            OnClick = async () => await HandleSave()
        });

        advancedToolbarState.AddSeparator(new PggmToolbarSeparatorState());

        var exportDropdown = new PggmToolbarDropdownState
        {
            Label = "Export",
            Icon = "export"
        };
        exportDropdown.Items.Add(new PggmToolbarDropdownItemState { Label = "PDF", Value = "pdf" });
        exportDropdown.Items.Add(new PggmToolbarDropdownItemState { Label = "Excel", Value = "excel" });
        exportDropdown.Items.Add(new PggmToolbarDropdownItemState { Label = "CSV", Value = "csv" });
        exportDropdown.OnItemSelected = async (value) => await HandleExport(value);
        advancedToolbarState.AddDropdown(exportDropdown);

        advancedToolbarState.AddSeparator(new PggmToolbarSeparatorState());

        advancedToolbarState.AddCheckbox(new PggmToolbarCheckboxState
        {
            Label = "Show deleted",
            OnCheckedChanged = async (isChecked) => await HandleShowDeleted(isChecked)
        });

        advancedToolbarState.AddSeparator(new PggmToolbarSeparatorState());

        var viewToggle = new PggmToolbarToggleButtonGroupState
        {
            Label = "View mode",
            AllowMultiple = false
        };
        viewToggle.Buttons.Add(new PggmToolbarToggleButtonState { Label = "List", Selected = true });
        viewToggle.Buttons.Add(new PggmToolbarToggleButtonState { Label = "Grid" });
        viewToggle.Buttons.Add(new PggmToolbarToggleButtonState { Label = "Chart" });
        viewToggle.OnToggle = async (id, selected) => await HandleViewToggle(id, selected);
        advancedToolbarState.AddToggleGroup(viewToggle);

        var filterToggle = new PggmToolbarToggleButtonGroupState
        {
            Label = "Filters",
            AllowMultiple = true
        };
        filterToggle.Buttons.Add(new PggmToolbarToggleButtonState { Label = "Active" });
        filterToggle.Buttons.Add(new PggmToolbarToggleButtonState { Label = "Pending" });
        filterToggle.Buttons.Add(new PggmToolbarToggleButtonState { Label = "Archived" });
        filterToggle.OnToggle = async (id, selected) => await HandleFilterToggle(id, selected);
        advancedToolbarState.AddToggleGroup(filterToggle);

        // Visibility toolbar setup
        visibilityToolbarState.AddButton(new PggmToolbarButtonState
        {
            Label = "Add",
            Icon = "circle-plus",
            Visible = true,
            OnClick = async () => await HandleAdd()
        });

        visibilityToolbarState.AddButton(new PggmToolbarButtonState
        {
            Label = "Edit",
            Icon = "edit",
            Visible = true,
            OnClick = async () => await HandleEdit()
        });

        visibilityToolbarState.AddSeparator(new PggmToolbarSeparatorState());

        var visibilityDropdown = new PggmToolbarDropdownState
        {
            Label = "Export",
            Icon = "export",
            Visible = true
        };
        visibilityDropdown.Items.Add(new PggmToolbarDropdownItemState { Label = "PDF", Value = "pdf", Visible = true });
        visibilityDropdown.Items.Add(new PggmToolbarDropdownItemState { Label = "Excel", Value = "excel", Visible = true });
        visibilityDropdown.OnItemSelected = async (value) => await HandleExport(value);
        visibilityToolbarState.AddDropdown(visibilityDropdown);
    }

    private string lastEventMessage = string.Empty;
    private DateTime lastEventTime;

    private void LogEvent(string message)
    {
        lastEventMessage = message;
        lastEventTime = DateTime.Now;
        StateHasChanged();
    }

    private void ToggleAddVisibility()
    {
        addButtonVisible = !addButtonVisible;
        visibilityToolbarState.SetButtonVisible(visibilityToolbarState.Buttons[0].Id, addButtonVisible);
        LogEvent($"Add button visible: {addButtonVisible}");
    }

    private void ToggleEditVisibility()
    {
        editButtonVisible = !editButtonVisible;
        visibilityToolbarState.SetButtonVisible(visibilityToolbarState.Buttons[1].Id, editButtonVisible);
        LogEvent($"Edit button visible: {editButtonVisible}");
    }

    private void ToggleDropdownVisibility()
    {
        dropdownVisible = !dropdownVisible;
        var dropdown = visibilityToolbarState.Dropdowns.FirstOrDefault();
        if (dropdown != null)
        {
            dropdown.Visible = dropdownVisible;
            visibilityToolbarState.Notify();
        }
        LogEvent($"Export dropdown visible: {dropdownVisible}");
    }

    private void TogglePdfItemVisibility()
    {
        pdfItemVisible = !pdfItemVisible;
        var dropdown = visibilityToolbarState.Dropdowns.FirstOrDefault();
        if (dropdown != null)
        {
            var pdfItem = dropdown.Items.FirstOrDefault(i => i.Value == "pdf");
            if (pdfItem != null)
            {
                pdfItem.Visible = pdfItemVisible;
                visibilityToolbarState.Notify();
            }
        }
        LogEvent($"PDF dropdown item visible: {pdfItemVisible}");
    }

    private async Task HandleAdd()
    {
        LogEvent("Add button clicked");
        await Task.CompletedTask;
    }

    private async Task HandleEdit()
    {
        LogEvent("Edit button clicked");
        await Task.CompletedTask;
    }

    private async Task HandleFilter()
    {
        LogEvent("Filter button clicked");
        await Task.CompletedTask;
    }

    private async Task HandleNew()
    {
        LogEvent("New button clicked");
        await Task.CompletedTask;
    }

    private async Task HandleSave()
    {
        LogEvent("Save button clicked");
        await Task.CompletedTask;
    }

    private async Task HandleExport(string format)
    {
        LogEvent($"Export '{format}' selected");
        await Task.CompletedTask;
    }

    private async Task HandleShowDeleted(bool show)
    {
        LogEvent($"Show deleted checkbox: {show}");
        await Task.CompletedTask;
    }

    private async Task HandleViewToggle(string id, bool selected)
    {
        LogEvent($"View mode toggle '{id}': {selected}");
        await Task.CompletedTask;
    }

    private async Task HandleFilterToggle(string id, bool selected)
    {
        LogEvent($"Filter toggle '{id}': {selected}");
        await Task.CompletedTask;
    }

    private string visibilitySource = """
