            exportDropdown.Items.Add(new PggmToolbarDropdownItemState { Label = "Excel", Value = "excel" });
            exportDropdown.Items.Add(new PggmToolbarDropdownItemState { Label = "CSV", Value = "csv" });
            exportDropdown.OnItemSelected = async (value) => await HandleExport(value);
            advancedToolbarState.AddDropdown(exportDropdown);

            advancedToolbarState.AddSeparator(new PggmToolbarSeparatorState());

            advancedToolbarState.AddCheckbox(new PggmToolbarCheckboxState
            {
