            };
            viewToggle.Buttons.Add(new PggmToolbarToggleButtonState { Label = "List", Selected = true });
            viewToggle.Buttons.Add(new PggmToolbarToggleButtonState { Label = "Grid" });
            viewToggle.Buttons.Add(new PggmToolbarToggleButtonState { Label = "Chart" });
            viewToggle.OnToggle = async (id, selected) => await HandleViewToggle(id, selected);
            advancedToolbarState.AddToggleGroup(viewToggle);

