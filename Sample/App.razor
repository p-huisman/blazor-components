@inject IPggmAsideMenuService AsideMenuService

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="typeof(PggmAppLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <LayoutView Layout="typeof(PggmAppLayout)">
            <p role="alert">Sorry, there's nothing at this address.</p>
        </LayoutView>
    </NotFound>
</Router>

@code {
    protected override void OnInitialized()
    {
        SetupMenu();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        SetupMenu();
        await Task.CompletedTask;
    }

    private void SetupMenu()
    {
        AsideMenuService.SetSections(new NavSectionModel[]
        {
            new NavSectionModel
            {
                Title = "Blazor Components",
                Categories = new NavCategoryModel[]
                {
                    new NavCategoryModel
                    {
                        Label = "Forms",
                        Icon = GetIcon("Forms"),
                        Items = new NavItemModel[]
                        {
                            new NavItemModel{ Href = "/pggm-button", Label = "Button" },
                            new NavItemModel{ Href = "/pggm-checkbox", Label = "Checkbox" },
                            new NavItemModel{ Href = "/pggm-combobox", Label = "Combobox" },
                            new NavItemModel{ Href = "/pggm-file-upload", Label = "File Upload" },
                            new NavItemModel{ Href = "/pggm-input", Label = "Input" },
                            new NavItemModel{ Href = "/pggm-input-bsn", Label = "Input BSN" },
                            new NavItemModel{ Href = "/pggm-input-date", Label = "Input Date" },
