@page "/counter"
@rendermode InteractiveServer


<PageTitle>Counter</PageTitle>

<PggmHeading Level="1">Counter</PggmHeading>

<p role="status">Current count: @currentCount</p>
<PggmButton Appearance="@ButtonAppearance.Primary" OnClick="IncrementCount">
    <PggmIcon Icon="@ComponentValues.IconName.ChartBars"></PggmIcon> Click me</PggmButton>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }
}
