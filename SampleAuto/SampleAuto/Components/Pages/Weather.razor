@page "/weather"
@attribute [StreamRendering]
@using Pggm.Components.Components.PggmDataGrid

<PageTitle>Weather</PageTitle>

<PggmHeading Level="1">Weather</PggmHeading>

<p>This component demonstrates showing data.</p>

@if (forecasts == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <PggmDataGrid TGridItem="WeatherForecast" Items="@forecasts.AsQueryable()" EnableColumnFiltering="true"
                  AutoItemsPerPage="false">
        <PropertyColumn TGridItem="WeatherForecast" TProp="DateOnly" Title="Date" Property="f => f.Date" DisplayFormat="d"
                        Sortable="true" Filterable="true" SortByExpression="f => f.Date" FilterByExpression="f => f.Date" FilterType="FilterType.Date" />
        <PropertyColumn TGridItem="WeatherForecast" TProp="int" Title="Temp. (C)" Property="f => f.TemperatureC"
                        Sortable="true" Filterable="true" SortByExpression="f => f.TemperatureC"
                        FilterByExpression="f => f.TemperatureC" FilterType="FilterType.Number" />
        <PropertyColumn TGridItem="WeatherForecast" TProp="int" Title="Temp. (F)" Property="f => f.TemperatureF"
                        Sortable="true" Filterable="true" SortByExpression="f => f.TemperatureF"
                        FilterByExpression="f => f.TemperatureF" FilterType="FilterType.Number" />
        <PropertyColumn TGridItem="WeatherForecast" TProp="string" Title="Summary"  Sortable="true" SortByExpression="f => f.Summary" Property="f => f.Summary" />
    </PggmDataGrid>
}

@code {
    private WeatherForecast[]? forecasts;

    protected override async Task OnInitializedAsync()
    {
        // Simulate asynchronous loading to demonstrate streaming rendering
        await Task.Delay(500);

        var startDate = DateOnly.FromDateTime(DateTime.Now);
        var summaries = new[] { "Freezing", "Bracing", "Chilly", "Cool", "Mild", "Warm", "Balmy", "Hot", "Sweltering",
"Scorching" };
        forecasts = Enumerable.Range(1, 5).Select(index => new WeatherForecast
        {
            Date = startDate.AddDays(index),
            TemperatureC = Random.Shared.Next(-20, 55),
            Summary = summaries[Random.Shared.Next(summaries.Length)]
        }).ToArray();
    }

    private class WeatherForecast
    {
        public DateOnly Date { get; set; }
        public int TemperatureC { get; set; }
        public string? Summary { get; set; }
        public int TemperatureF => 32 + (int)(TemperatureC / 0.5556);
    }
}
