@namespace Pggm.Components
@inherits PggmEventComponentInputBase<string>

<pggm-input-date @ref="ElementRef"
    name="@Name"
    format="@Format"
    min="@Min"
    max="@Max"
    lang="@Lang"
    disabled="@Disabled"
    readonly="@ReadOnly"
    period="@Period"
    required="@(EditContext == null && Required)"
    @attributes="GetAttributes()">
    @ChildContent
</pggm-input-date>
