@namespace Pggm.Components
@inherits PggmComponentBase

<pggm-fieldset @ref="ElementRef" @attributes="GetAttributes()">
    @* Provide a cascading token so child `PggmFieldsetLabel` components can validate they are
       used inside a `PggmFieldset`. Child labels render as direct `<label slot="label">` elements. *@
    <CascadingValue Value="_fieldsetCascadingToken" IsFixed="true">
        @ChildContent
    </CascadingValue>
</pggm-fieldset>
