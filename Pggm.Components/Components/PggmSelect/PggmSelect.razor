@namespace Pggm.Components
@typeparam TOption
@inherits PggmEventComponentBase

<select is="pggm-select" @ref="ElementRef" value="@Value" @onchange="HandleValueChanged" @attributes="GetAttributes()">
  @if (!string.IsNullOrEmpty(Placeholder))
  {
    <option value="" disabled selected="@string.IsNullOrEmpty(Value)">@Placeholder</option>
  }
  @ChildContent
  @if (Items is not null)
  {
    @foreach (TOption item in Items)
    {
      @if (OptionTemplate is not null)
      {
        @OptionTemplate(item)
      }
      else
      {
        var val = OptionValue?.Invoke(item) ?? OptionText.Invoke(item) ?? item?.ToString();
        var text = OptionText.Invoke(item) ?? val;
        var disabled = OptionDisabled?.Invoke(item) == true;
        var title = OptionTitle?.Invoke(item);
        var selected = IsOptionSelected(item);
        <option value="@val" disabled="@disabled" selected="@selected" title="@title">@text</option>
      }
    }
  }
</select>
