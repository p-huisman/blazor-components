@namespace Pggm.Components
@using Pggm.Components.Components.PggmToolbar

<div class="pggm-toolbar">
    @if (State?.Buttons?.Count > 0)
    {
        foreach (var btn in State.Buttons)
        {
            if (btn.Visible)
            {
                <PggmToolbarButton Button="btn" />
            }
        }
    }

    @if (State?.Groups?.Count > 0)
    {
        foreach (var grp in State.Groups)
        {
            if (grp.Visible)
            {
                <PggmToolbarButtonGroup Group="grp" />
            }
        }
    }

    @if (State?.Separators?.Count > 0)
    {
        foreach (var sep in State.Separators)
        {
            if (sep.Visible)
            {
                <PggmToolbarSeparator State="sep" />
            }
        }
    }

    @if (State?.Dropdowns?.Count > 0)
    {
        foreach (var dropdown in State.Dropdowns)
        {
            if (dropdown.Visible)
            {
                <PggmToolbarDropdown Dropdown="dropdown" />
            }
        }
    }

    @if (State?.Checkboxes?.Count > 0)
    {
        foreach (var checkbox in State.Checkboxes)
        {
            if (checkbox.Visible)
            {
                <PggmToolbarCheckbox State="checkbox" />
            }
        }
    }

    @if (State?.ToggleGroups?.Count > 0)
    {
        foreach (var toggleGroup in State.ToggleGroups)
        {
            if (toggleGroup.Visible)
            {
                <PggmToolbarToggleButtonGroup Group="toggleGroup" />
            }
        }
    }
</div>
