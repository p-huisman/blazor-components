@namespace Pggm.Components
@inherits Pggm.Components.Base.PggmEventComponentInputBase<string>

<pggm-radio @ref="ElementRef"
  Name="@Name"
  value="@RadioValue"
  checked="@IsChecked"
  disabled="@Disabled"
  required="@Required"
  @attributes="AdditionalAttributes">
  @ChildContent
  @if (!string.IsNullOrEmpty(Description))
  {
    <span slot="description">@Description</span>
  }
</pggm-radio>
