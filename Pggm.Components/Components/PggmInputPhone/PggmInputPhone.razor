@namespace Pggm.Components
@inherits PggmEventComponentInputBase<string>

<pggm-input-phone @ref="ElementRef"
    value="@CurrentValue"
    name="@Name"
    phone-number-type="@PhoneNumberType"
    top-countries="@TopCountries"
    country-label="@CountryLabel"
    initial-country="@InitialCountry"
    id="@(Id ?? DataId)"
    data-id="@DataId"
    disabled="@Disabled"
    readonly="@ReadOnly"
    required="@(EditContext == null && Required)"
    @attributes="GetAttributes()" />
