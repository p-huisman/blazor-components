@inherits LayoutComponentBase

@using Pggm.Components.Components.PggmApp.PggmAppSidebar
@using Pggm.Components.Components.PggmApp.PggmAppHeader
@using Pggm.Components.Components.PggmApp.PggmAsideMenu

<div class="app-layout @( _isSidebarOpen ? "sidebar-open" : "")">
    <PggmAppHeader OnToggleSidebar="ToggleSidebar" />
    
    <main class="main">
        <article class="main-content">
            @Body
        </article>
    </main>

    <PggmAppSidebar Open="_isSidebarOpen" OnClose="CloseSidebar" />
    
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
