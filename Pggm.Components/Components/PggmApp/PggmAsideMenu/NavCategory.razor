@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager NavigationManager
@inject Pggm.Components.Components.PggmApp.PggmAsideMenu.Services.IPggmAsideMenuService AsideMenuService
@implements IDisposable

<CascadingValue Value="this" IsFixed="false">
    <div class="nav-category @(_isExpanded ? "nav-category--expanded" : "")">
        <button class="nav-category-header" @onclick="Toggle" aria-expanded="@_isExpanded.ToString().ToLower()">
            <span class="nav-category-icon" aria-hidden="true">
                @Icon
            </span>
            <span class="nav-category-label">@Label</span>
            <span class="nav-chevron" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
            </span>
        </button>
        <div class="nav-category-content">
            @ChildContent
        </div>
    </div>
</CascadingValue>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public RenderFragment? Icon { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public IEnumerable<string>? ItemHrefs { get; set; }

    private bool _isExpanded;
    private readonly HashSet<string> _childHrefs = new(StringComparer.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        // Pre-populate hrefs from the model so HasActiveChild() works before children register
        if (ItemHrefs != null)
        {
            foreach (var href in ItemHrefs)
                if (!string.IsNullOrEmpty(href) && href != "#")
                    _childHrefs.Add(href);
        }

        _isExpanded = AsideMenuService.IsCategoryExpanded(Label) || HasActiveChild();
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // Fallback for when ItemHrefs was not provided
        if (firstRender && !_isExpanded && HasActiveChild())
        {
            SetExpanded(true);
            StateHasChanged();
        }
    }

    internal void RegisterHref(string href)
    {
        if (!string.IsNullOrEmpty(href) && href != "#")
            _childHrefs.Add(href);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (HasActiveChild())
            SetExpanded(true);
        InvokeAsync(StateHasChanged);
    }

    private bool HasActiveChild() => _childHrefs.Any(IsHrefActive);

    private bool IsHrefActive(string href)
    {
        var currentUri = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var hashIdx = currentUri.IndexOf('#');
        if (hashIdx >= 0)
            currentUri = currentUri.Substring(0, hashIdx);

        var h = href.TrimStart('/');
        return string.Equals(currentUri, h, StringComparison.OrdinalIgnoreCase)
            || currentUri.StartsWith(h + "/", StringComparison.OrdinalIgnoreCase);
    }

    private void Toggle() => SetExpanded(!_isExpanded);

    private void SetExpanded(bool value)
    {
        _isExpanded = value;
        AsideMenuService.SetCategoryExpanded(Label, value);
    }

    public void Dispose() => NavigationManager.LocationChanged -= OnLocationChanged;
}
