@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager NavigationManager
@using Pggm.Components.Components.PggmApp.PggmAsideMenu

@if (IsTextOnly)
{
    <span class="nav-item nav-item--l3 nav-item-text-only">
        <span class="nav-item__label">@Label</span>
    </span>
}
else
{
    <a href="@Href" class="@LinkClass">
        <span class="nav-item__label">@Label</span>
    </a>
}

@code {
    [Parameter, EditorRequired] public string Href { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public NavLinkMatch Match { get; set; } = NavLinkMatch.All;
    [CascadingParameter] private NavCategory? ParentCategory { get; set; }

    protected override void OnParametersSet()
    {
        ParentCategory?.RegisterHref(Href);
    }

    private bool IsTextOnly => string.IsNullOrEmpty(Href) || Href == "#";

    private bool IsActive
    {
        get
        {
            var currentUri = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
            var hashIdx = currentUri.IndexOf('#');
            if (hashIdx >= 0)
                currentUri = currentUri.Substring(0, hashIdx);
            var href = Href.TrimStart('/');
            return Match == NavLinkMatch.All
                ? string.Equals(currentUri, href, StringComparison.OrdinalIgnoreCase)
                : currentUri.StartsWith(href, StringComparison.OrdinalIgnoreCase);
        }
    }

    private string LinkClass => IsActive
        ? "nav-item nav-item--l3 active"
        : "nav-item nav-item--l3";
}
