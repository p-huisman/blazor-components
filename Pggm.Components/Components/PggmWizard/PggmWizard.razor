@namespace Pggm.Components
@inherits PggmEventComponentBase

<pggm-wizard @ref="ElementRef" @attributes="GetAttributes()">
  @ChildContent
  @if (FinishContent != null)
  {
    <div slot="finish">
      @FinishContent
    </div>
  }
  @if (ErrorContent != null)
  {
    <div slot="error">
      @ErrorContent
    </div>
  }
</pggm-wizard>
